  361                     ;----------------------------------
  362                     ;    
  363  00:A2FF            se_set_stream_volume:
  364                             
  365  00:A2FF  8C 01 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  366                         
  367  00:A302  BD 41 03      lda stream_ve, x            ;which volume envelope?
  368  00:A305  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  369  00:A306  A8            tay
  370  00:A307  B9 44 A7      lda volume_envelopes, y     ;get the low byte of the address from the pointer table
  371  00:A30A  8D D2 00      sta sound_ptr               ;put it into our pointer variable
  372  00:A30D  B9 45 A7      lda volume_envelopes+1, y   ;get the high byte of the address
  373  00:A310  8D D3 00      sta sound_ptr+1
  374                         
  375  00:A313            .read_ve:
  376  00:A313  BC 49 03      ldy stream_ve_index, x      ;our current position within the volume envelope.
  377  00:A316  B1 D2         lda [sound_ptr], y          ;grab the value.
  378  00:A318  C9 FF         cmp #$FF
  379  00:A31A  D0 06         bne .set_vol                ;if not FF, set the volume
  380  00:A31C  DE 49 03      dec stream_ve_index, x      ;else if FF, go back one and read again
  381  00:A31F  4C 13 A3      jmp .read_ve                ;  FF essentially tells us to repeat the last
  382                                                     ;  volume value for the remainder of the note
  383  00:A322            .set_vol:
  384  00:A322  8D 02 03      sta sound_temp2             ;save our new volume value (about to destroy A)
  385                         
  386  00:A325  E0 02         cpx #TRIANGLE               
  387  00:A327  D0 09         bne .squares                ;if not triangle channel, go ahead
  388  00:A329  AD 02 03      lda sound_temp2
  389  00:A32C  D0 04         bne .squares                ;else if volume not zero, go ahead (treat same as squares)
  390  00:A32E  A9 80         lda #$80
  391  00:A330  30 08         bmi .store_vol              ;else silence the channel with #$80
  392  00:A332            .squares:
  393  00:A332  BD 51 03      lda stream_vol_duty, x      ;get current vol/duty settings
  394  00:A335  29 F0         and #$F0                    ;zero out the old volume
  395  00:A337  0D 02 03      ora sound_temp2             ;OR our new volume in.
  396                     
  397  00:A33A            .store_vol:
  398  00:A33A  AC 01 03      ldy sound_temp1             ;get our index into soft_apu_ports
  399  00:A33D  99 05 03      sta soft_apu_ports, y       ;store the volume in our temp port
  400  00:A340  FE 49 03      inc stream_ve_index, x      ;set our volume envelop index to the next position
  401                     
  402  00:A343            .rest_check:
  403                         ;check the rest flag. if set, overwrite volume with silence value 
  404  00:A343  BD 21 03      lda stream_status, x
  405  00:A346  29 02         and #%00000010
  406  00:A348  F0 10         beq .done                   ;if clear, no rest, so quit
  407  00:A34A  BD 29 03      lda stream_channel, x
  408  00:A34D  C9 02         cmp #TRIANGLE               ;if triangle, silence with #$80
  409  00:A34F  F0 04         beq .tri                    ;else, silence with #$30
  410  00:A351  A9 30         lda #$30        
  411  00:A353  D0 02         bne .store                  ;this always branches.  bne is cheaper than a jmp
  412  00:A355            .tri:
  413  00:A355  A9 80         lda #$80
  414  00:A357            .store:    
  415  00:A357  99 05 03      sta soft_apu_ports, y
  416  00:A35A            .done:
  417  00:A35A  60            rts   
  418                             
  419                     ;---------------------------------------
  420                     ;
  421  00:A35B            se_set_stream_arpeggio:
  422                         
  423  00:A35B  BD 21 03          lda stream_status, x
  424  00:A35E  29 02         and #%00000010
  425  00:A360  F0 01             beq .continue
  426  00:A362  60                rts
  427                             
  428  00:A363            .continue:
  429  00:A363  8C 01 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  430                         
  431  00:A366  BD BF 03      lda stream_arp, x            ;which volume envelope?
  432  00:A369  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  433  00:A36A  A8            tay
  434  00:A36B  B9 EF A8      lda arpeggios, y     ;get the low byte of the address from the pointer table
  435  00:A36E  8D D2 00      sta sound_ptr               ;put it into our pointer variable
  436  00:A371  B9 F0 A8      lda arpeggios+1, y   ;get the high byte of the address
  437  00:A374  8D D3 00      sta sound_ptr+1
  438                         
  439  00:A377            .read_arp:
  440  00:A377  BC C7 03      ldy stream_arp_index, x      ;our current position within the volume envelope.
  441  00:A37A  B1 D2         lda [sound_ptr], y          ;grab the value.
  442  00:A37C  C9 FF         cmp #$FF
  443  00:A37E  D0 08         bne .set_arp                ;if not FF, set the volume
  444  00:A380  A9 00             LDA #$00
  445  00:A382  9D C7 03      STA stream_arp_index, x      ;else if FF, go back one and read again
  446  00:A385  4C 77 A3      jmp .read_arp                ;  FF essentially tells us to repeat the last
  447                                                     ;  volume value for the remainder of the note
  448  00:A388            .set_arp:
  449  00:A388  8D 02 03      STA sound_temp2             ;save our new volume value (about to destroy A)
  450  00:A38B  BD 59 03          LDA stream_note_idx, x          ;note indexes are premultiplied, un mult for an easier add
  451  00:A38E  4A                LSR A                           
  452  00:A38F  18                CLC
  453  00:A390  6D 02 03          ADC sound_temp2
  454  00:A393  8D 02 03          STA sound_temp2
  455                             
  456                             
  457  00:A396  AC 01 03          LDY sound_temp1
  458  00:A399  8E 01 03          STX sound_temp1
  459  00:A39C  0A                ASL A
  460  00:A39D  AA                TAX 
  461                     
  462  00:A39E  BD 6A A6          LDA note_table, x
  463  00:A3A1  99 07 03          STA soft_apu_ports+2, y
  464  00:A3A4  BD 6B A6          LDA note_table+1, x
  465  00:A3A7  99 08 03          STA soft_apu_ports+3, y
  466                             
  467  00:A3AA  AE 01 03          LDX sound_temp1
  468                             
  469  00:A3AD  FE C7 03      inc stream_arp_index, x      ;set our volume envelop index to the next position
  470                             
  471  00:A3B0  98                TYA
  472  00:A3B1  8D 01 03          STA sound_temp1
  473                     
  474  00:A3B4  60            rts 
  475                     ;--------------------------------------
  476                     ;
  477  00:A3B5            se_set_stream_pitch:
  478  00:A3B5  8C 01 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  479                         
  480  00:A3B8  BD 9F 03      lda stream_pe, x            ;which volume envelope?
  481  00:A3BB  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  482  00:A3BC  A8            tay
  483  00:A3BD  B9 AB A8      lda pitch_envelopes, y     ;get the low byte of the address from the pointer table
  484  00:A3C0  8D D2 00      sta sound_ptr               ;put it into our pointer variable
  485  00:A3C3  B9 AC A8      lda pitch_envelopes+1, y   ;get the high byte of the address
  486  00:A3C6  8D D3 00      sta sound_ptr+1
  487                             
  488  00:A3C9  BD B7 03          LDA stream_pe_delay, x
  489                             ;if not 0, decrement
  490  00:A3CC  29 7F             AND #$7F                        ;check if, without minus flag, the delay is 0
  491  00:A3CE  F0 04             BEQ .read_pe
  492  00:A3D0  DE B7 03          DEC stream_pe_delay, x
  493  00:A3D3  60                RTS
  494                         
  495  00:A3D4            .read_pe:
  496  00:A3D4  BC A7 03      ldy stream_pe_index, x      ;our current position within the volume envelope.
  497  00:A3D7  B1 D2         lda [sound_ptr], y          ;grab the value.
  498  00:A3D9  C9 80         cmp #pe_loopLast
  499  00:A3DB  D0 06             BNE .notLoopLast
  500  00:A3DD  DE A7 03          dec stream_pe_index, x      ;else if loop last, go back one and read again
  501  00:A3E0  4C D4 A3          jmp .read_pe 
  502                     
  503  00:A3E3            .notLoopLast:
  504  00:A3E3  C9 81             cmp #pe_loopAll
  505  00:A3E5  D0 08             BNE .notLoopAll
  506  00:A3E7  A9 00             LDA #$00
  507  00:A3E9  9D A7 03          STA stream_pe_index, x
  508  00:A3EC  4C D4 A3          jmp .read_pe
  509                             
  510  00:A3EF            .notLoopAll:
  511  00:A3EF  C9 82             cmp #pe_loopPart
  512  00:A3F1  D0 0D             BNE .notLoopPart
  513  00:A3F3  C8                iny
  514  00:A3F4  BD A7 03          lda stream_pe_index, x
  515  00:A3F7  38                SEC
  516  00:A3F8  F1 D2             SBC [sound_ptr], y
  517  00:A3FA  9D A7 03          STA stream_pe_index, x
  518  00:A3FD  4C D4 A3          jmp .read_pe
  519                     
  520  00:A400            .notLoopPart:
  521  00:A400  C9 83             cmp #pe_delay
  522  00:A402  D0 1C             BNE .notLoopDelay
  523  00:A404  BD B7 03          LDA stream_pe_delay, x
  524  00:A407  30 0E             BMI .delayUsed  ;negative, delay was already used this time
  525  00:A409  C8                iny
  526  00:A40A  B1 D2             lda [sound_ptr], y
  527  00:A40C  09 80             ORA #$80
  528  00:A40E  9D B7 03          STA stream_pe_delay, x
  529  00:A411  FE A7 03          inc stream_pe_index, x
  530  00:A414  4C 5D A4          jmp .finish_pitchShift
  531  00:A417            .delayUsed:
  532  00:A417  FE A7 03          inc stream_pe_index, x
  533  00:A41A  FE A7 03          inc stream_pe_index, x
  534  00:A41D  4C D4 A3          jmp .read_pe
  535                             
  536  00:A420            .notLoopDelay:
  537  00:A420            .set_pitch:
  538                     
  539  00:A420  9D AF 03      sta stream_pe_offset, x      ;get current vol/duty settings
  540  00:A423  8D 02 03          STA sound_temp2
  541  00:A426  AC 01 03          LDY sound_temp1
  542  00:A429  AD 02 03          LDA sound_temp2
  543  00:A42C  10 1D             BPL .add_pitch
  544                             
  545  00:A42E            .sub_pitch:
  546                             
  547  00:A42E  49 FF             EOR #$FF        ;flip bits
  548  00:A430  18                CLC
  549  00:A431  69 01             ADC #$01        ;add one - two's compliment
  550  00:A433  8D 02 03          STA sound_temp2
  551                             
  552  00:A436  B9 07 03          LDA soft_apu_ports+2, y       
  553  00:A439  38                SEC
  554  00:A43A  ED 02 03          SBC sound_temp2
  555  00:A43D  99 07 03          STA soft_apu_ports+2, y
  556  00:A440  B9 08 03          LDA soft_apu_ports+3, y
  557  00:A443  E9 00             SBC #$00
  558  00:A445  99 08 03          STA soft_apu_ports+3, y
  559                             
  560  00:A448  4C 5D A4          JMP .finish_pitchShift
  561                     
  562  00:A44B            .add_pitch:
  563                     
  564  00:A44B  B9 07 03      LDA soft_apu_ports+2, y       
  565  00:A44E  18                CLC
  566  00:A44F  6D 02 03          ADC sound_temp2
  567  00:A452  99 07 03          STA soft_apu_ports+2, y
  568  00:A455  B9 08 03          LDA soft_apu_ports+3, y
  569  00:A458  69 00             ADC #$00
  570  00:A45A  99 08 03          STA soft_apu_ports+3, y
  571                             
  572  00:A45D            .finish_pitchShift:
  573  00:A45D  FE A7 03      inc stream_pe_index, x      ;set our volume envelop index to the next position
  574                     
  575  00:A460            .rest_check:
  576                         ;check the rest flag. if set, overwrite volume with silence value 
  577  00:A460  BD 21 03      lda stream_status, x
  578  00:A463  29 02         and #%00000010
  579  00:A465  F0 05         beq .done                   ;if clear, no rest, so quit
  580                        
  581  00:A467  A9 00         LDA #$00
  582  00:A469  9D AF 03          STA stream_pe_offset, x
  583  00:A46C            .done:
  584  00:A46C  60            rts    
  585                     
  586                     ;--------------------------
  587                     ; se_set_apu copies the temporary RAM ports to the APU ports
  588  00:A46D            se_set_apu:
  589  00:A46D            .square1:
  590  00:A46D  AD 05 03      lda soft_apu_ports+0
  591  00:A470  8D 00 40      sta $4000
  592  00:A473  AD 06 03      lda soft_apu_ports+1
  593  00:A476  8D 01 40      sta $4001
  594  00:A479  AD 07 03      lda soft_apu_ports+2
  595  00:A47C  8D 02 40      sta $4002
  596  00:A47F  AD 08 03      lda soft_apu_ports+3
  597  00:A482  CD 03 03      cmp sound_sq1_old       ;compare to last write
  598  00:A485  F0 06         beq .square2            ;don't write this frame if they were equal
  599  00:A487  8D 03 40      sta $4003
  600  00:A48A  8D 03 03      sta sound_sq1_old       ;save the value we just wrote to $4003
  601  00:A48D            .square2:
  602  00:A48D  AD 09 03      lda soft_apu_ports+4
  603  00:A490  8D 04 40      sta $4004
  604  00:A493  AD 0A 03      lda soft_apu_ports+5
  605  00:A496  8D 05 40      sta $4005
  606  00:A499  AD 0B 03      lda soft_apu_ports+6
  607  00:A49C  8D 06 40      sta $4006
  608  00:A49F  AD 0C 03      lda soft_apu_ports+7
  609  00:A4A2  CD 04 03      cmp sound_sq2_old
  610  00:A4A5  F0 06         beq .triangle
  611  00:A4A7  8D 07 40      sta $4007
  612  00:A4AA  8D 04 03      sta sound_sq2_old       ;save the value we just wrote to $4007
  613  00:A4AD            .triangle:
  614  00:A4AD  AD 0D 03      lda soft_apu_ports+8
  615  00:A4B0  8D 08 40      sta $4008
  616  00:A4B3  AD 0F 03      lda soft_apu_ports+10   ;there is no $4009, so we skip it
  617  00:A4B6  8D 0A 40      sta $400A
  618  00:A4B9  AD 10 03      lda soft_apu_ports+11
  619  00:A4BC  8D 0B 40      sta $400B
  620  00:A4BF            .noise:
  621  00:A4BF  AD 11 03      lda soft_apu_ports+12
  622  00:A4C2  8D 0C 40      sta $400C
  623  00:A4C5  AD 13 03      lda soft_apu_ports+14   ;there is no $400D, so we skip it
  624  00:A4C8  8D 0E 40      sta $400E
  625  00:A4CB  AD 14 03      lda soft_apu_ports+15
  626  00:A4CE  8D 0F 40      sta $400F
  627  00:A4D1  60            rts
