  232  00:A252            se_do_noise:
  233                     
  234  00:A252  AD 15 40          lda $4015
  235  00:A255  29 10             AND #$10                                ;get the current DMC bytes remaining
  236  00:A257  09 07             ORA #$07                                ;add in the lower three bits
  237  00:A259  2D 00 03          AND sound_enable_flags  ;and with the current sound flags, minus noise
  238  00:A25C  8D 00 03          sta sound_enable_flags  ;disable noise
  239  00:A25F  8D 15 40          sta $4015
  240                     
  241  00:A262  AD 03 03      lda sound_temp2
  242  00:A265  29 20             AND #%00100000
  243  00:A267  D0 20             bne .leave
  244                             
  245  00:A269  AD 03 03          lda sound_temp2
  246  00:A26C  29 10         and #%00010000
  247  00:A26E  F0 08         beq .mode0
  248  00:A270  AD 03 03      lda sound_temp2
  249  00:A273  09 80         ora #%10000000      ;set bit 7 to set mode1
  250  00:A275  8D 03 03      sta sound_temp2
  251  00:A278            .mode0:
  252  00:A278  AD 03 03      lda sound_temp2
  253  00:A27B  9D 62 03      sta stream_note_LO, x
  254                     
  255  00:A27E  AD 00 03          lda sound_enable_flags
  256  00:A281  09 08             ORA #%00001000
  257  00:A283  8D 00 03          STA sound_enable_flags
  258  00:A286  8D 15 40          sta $4015
  259  00:A289            .leave:
  260  00:A289  60            rts
