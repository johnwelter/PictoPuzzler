  301                     ;--------------------------------------------------
  302                     ; se_check_rest will read a byte from the data stream and
  303                     ;       determine if it is a rest or not.  It will set or clear the current
  304                     ;       stream's rest flag accordingly.
  305                     ;       input:
  306                     ;           X: stream number
  307                     ;           Y: data stream index
  308  00:A2CC            se_check_rest:
  309  00:A2CC  B1 D2         lda [sound_ptr], y  ;read the note byte again
  310  00:A2CE  C9 5E         cmp #rest
  311  00:A2D0  D0 07         bne .not_rest
  312  00:A2D2  BD 22 03      lda stream_status, x
  313  00:A2D5  09 02         ora #%00000010  ;set the rest bit in the status byte
  314  00:A2D7  D0 05         bne .store  ;this will always branch.  bne is cheaper than a jmp.
  315  00:A2D9            .not_rest:
  316  00:A2D9  BD 22 03      lda stream_status, x
  317  00:A2DC  29 FD         and #%11111101  ;clear the rest bit in the status byte
  318  00:A2DE            .store:
  319  00:A2DE  9D 22 03      sta stream_status, x
  320  00:A2E1  60            rts
  321                         
  322                     ;-----------------------------------------
  323                     ; se_opcode_launcher will read an address from the opcode jump table and indirect jump there.
  324                     ;    input: A: opcode byte
  325                     ;               Y: data stream position
  326                     ;               X: stream number
  327  00:A2E2            se_opcode_launcher:
  328  00:A2E2  8C 02 03      sty sound_temp1         ;save y register, because we are about to destroy it
  329  00:A2E5  38            sec
  330  00:A2E6  E9 A0         sbc #$A0                ;turn our opcode byte into a table index by subtracting $A0
  331  00:A2E8  0A            asl a                   ;multiply by 2 because we index into a table of addresses (words)
  332  00:A2E9  A8            tay
  333  00:A2EA  B9 DA A5      lda sound_opcodes, y    ;get low byte of subroutine address
  334  00:A2ED  8D D4 00      sta sound_ptr2
  335  00:A2F0  B9 DB A5      lda sound_opcodes+1, y  ;get high byte
  336  00:A2F3  8D D5 00      sta sound_ptr2+1
  337  00:A2F6  AC 02 03      ldy sound_temp1         ;restore our y register
  338  00:A2F9  C8            iny                     ;set to next position in data stream (assume an argument)
  339  00:A2FA  6C D4 00      jmp [sound_ptr2]           ;indirect jump to our opcode subroutine    
  340                         
