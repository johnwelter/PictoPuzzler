  382                     ;----------------------------------
  383                     ;    
  384  00:A32B            se_set_stream_volume:
  385                             
  386  00:A32B  8C 02 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  387                         
  388  00:A32E  BD 42 03      lda stream_ve, x            ;which volume envelope?
  389  00:A331  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  390  00:A332  A8            tay
  391  00:A333  B9 67 A7      lda kVol, y     ;get the low byte of the address from the pointer table
  392  00:A336  8D D2 00      sta sound_ptr               ;put it into our pointer variable
  393  00:A339  B9 68 A7      lda kVol+1, y   ;get the high byte of the address
  394  00:A33C  8D D3 00      sta sound_ptr+1
  395                         
  396  00:A33F            .read_ve:
  397  00:A33F  BC 4A 03      ldy stream_ve_index, x      ;our current position within the volume envelope.
  398  00:A342  B1 D2         lda [sound_ptr], y          ;grab the value.
  399  00:A344  C9 FF         cmp #$FF
  400  00:A346  D0 06         bne .set_vol                ;if not FF, set the volume
  401  00:A348  DE 4A 03      dec stream_ve_index, x      ;else if FF, go back one and read again
  402  00:A34B  4C 3F A3      jmp .read_ve                ;  FF essentially tells us to repeat the last
  403                                                     ;  volume value for the remainder of the note
  404  00:A34E            .set_vol:
  405  00:A34E  8D 03 03      sta sound_temp2             ;save our new volume value (about to destroy A)
  406                         
  407  00:A351  E0 02         cpx #TRIANGLE               
  408  00:A353  D0 09         bne .squares                ;if not triangle channel, go ahead
  409  00:A355  AD 03 03      lda sound_temp2
  410  00:A358  D0 04         bne .squares                ;else if volume not zero, go ahead (treat same as squares)
  411  00:A35A  A9 80         lda #$80
  412  00:A35C  30 08         bmi .store_vol              ;else silence the channel with #$80
  413  00:A35E            .squares:
  414  00:A35E  BD 52 03      lda stream_vol_duty, x      ;get current vol/duty settings
  415  00:A361  29 F0         and #$F0                    ;zero out the old volume
  416  00:A363  0D 03 03      ora sound_temp2             ;OR our new volume in.
  417                     
  418  00:A366            .store_vol:
  419  00:A366  AC 02 03      ldy sound_temp1             ;get our index into soft_apu_ports
  420  00:A369  99 06 03      sta soft_apu_ports, y       ;store the volume in our temp port
  421  00:A36C  FE 4A 03      inc stream_ve_index, x      ;set our volume envelop index to the next position
  422                     
  423  00:A36F            .rest_check:
  424                         ;check the rest flag. if set, overwrite volume with silence value 
  425  00:A36F  BD 22 03      lda stream_status, x
  426  00:A372  29 02         and #%00000010
  427  00:A374  F0 10         beq .done                   ;if clear, no rest, so quit
  428  00:A376  BD 2A 03      lda stream_channel, x
  429  00:A379  C9 02         cmp #TRIANGLE               ;if triangle, silence with #$80
  430  00:A37B  F0 04         beq .tri                    ;else, silence with #$30
  431  00:A37D  A9 30         lda #$30        
  432  00:A37F  D0 02         bne .store                  ;this always branches.  bne is cheaper than a jmp
  433  00:A381            .tri:
  434  00:A381  A9 80         lda #$80
  435  00:A383            .store:    
  436  00:A383  99 06 03      sta soft_apu_ports, y
  437  00:A386            .done:
  438  00:A386  60            rts   
