#[3]   Source/External/SoundEngine/Source/sound_opcodes.asm
  633                         .include "Source/External/SoundEngine/Source/sound_opcodes.asm"    ;our opcode subroutines, jump table and aliases
    1                     ;these are aliases to use in the sound data.
    2           00A0      endsound = $A0
    3           00A1      loop = $A1
    4           00A2      volume_envelope = $A2
    5           00A3      duty = $A3
    6           00A4      set_loop1_counter = $A4
    7           00A5      loop1 = $A5
    8           00A6      set_note_offset = $A6
    9           00A7      adjust_note_offset = $A7
   10           00A8      transpose = $A8
   11           00A9      pitch_envelope = $A9
   12           00AA      arpeggio = $AA
   13                     
   14                     ;-----------------------------------------------------------------------
   15                     ;this is our JUMP TABLE!
   16  00:A5AE            sound_opcodes:
   17  00:A5AE  C4 A5         .word se_op_endsound            ;$A0
   18  00:A5B0  DD A5         .word se_op_infinite_loop       ;$A1
   19  00:A5B2  F4 A5         .word se_op_change_ve           ;$A2
   20  00:A5B4  FF A5         .word se_op_duty                ;$A3
   21  00:A5B6  05 A6         .word se_op_set_loop1_counter   ;$A4
   22  00:A5B8  0B A6         .word se_op_loop1               ;$A5
   23  00:A5BA  18 A6         .word se_op_set_note_offset     ;$A6
   24  00:A5BC  1E A6         .word se_op_adjust_note_offset  ;$A7
   25  00:A5BE  28 A6         .word se_op_transpose           ;$A8
   26  00:A5C0  48 A6             .word se_op_change_pe                   ;$A9
   27  00:A5C2  56 A6             .word se_op_change_arp
   28                         ;etc, 1 entry per subroutine
   29                     
   30                         
   31                     ;-----------------------------------------------------------------
   32                     ; these are the actual opcode subroutines
   33  00:A5C4            se_op_endsound:
   34  00:A5C4  BD 21 03      lda stream_status, x    ;end of stream, so disable it and silence
   35  00:A5C7  29 FE         and #%11111110
   36  00:A5C9  9D 21 03      sta stream_status, x    ;clear enable flag in status byte
   37                         
   38  00:A5CC  BD 29 03      lda stream_channel, x
   39  00:A5CF  C9 02         cmp #TRIANGLE
   40  00:A5D1  F0 04         beq .silence_tri        ;triangle is silenced differently from squares and noise
   41  00:A5D3  A9 30         lda #$30                ;squares and noise silenced with #$30
   42  00:A5D5  D0 02         bne .silence            ; (this will always branch.  bne is cheaper than a jmp)
   43  00:A5D7            .silence_tri:
   44  00:A5D7  A9 80         lda #$80                ;triangle silenced with #$80
   45  00:A5D9            .silence:
   46  00:A5D9  9D 51 03      sta stream_vol_duty, x  ;store silence value in the stream's volume variable.
   47                     
   48  00:A5DC  60            rts
   49                         
   50  00:A5DD            se_op_infinite_loop:
   51  00:A5DD  B1 D2         lda [sound_ptr], y      ;read ptr LO from the data stream
   52  00:A5DF  9D 31 03      sta stream_ptr_LO, x    ;update our data stream position
   53  00:A5E2  C8            iny
   54  00:A5E3  B1 D2         lda [sound_ptr], y      ;read ptr HI from the data stream
   55  00:A5E5  9D 39 03      sta stream_ptr_HI, x    ;update our data stream position
   56                         
   57  00:A5E8  8D D3 00      sta sound_ptr+1         ;update the pointer to reflect the new position.
   58  00:A5EB  BD 31 03      lda stream_ptr_LO, x
   59  00:A5EE  8D D2 00      sta sound_ptr
   60  00:A5F1  A0 FF         ldy #$FF                ;after opcodes return, we do an iny.  Since we reset  
   61                                                 ;the stream buffer position, we will want y to start out at 0 again.
   62  00:A5F3  60            rts
   63                         
   64  00:A5F4            se_op_change_ve:
   65  00:A5F4  B1 D2         lda [sound_ptr], y      ;read the argument
   66  00:A5F6  9D 41 03      sta stream_ve, x        ;store it in our volume envelope variable
   67  00:A5F9  A9 00         lda #$00
   68  00:A5FB  9D 49 03      sta stream_ve_index, x  ;reset volume envelope index to the beginning
   69  00:A5FE  60            rts
   70                         
   71  00:A5FF            se_op_duty:
   72  00:A5FF  B1 D2         lda [sound_ptr], y
   73  00:A601  9D 51 03      sta stream_vol_duty, x
   74  00:A604  60            rts
   75                         
   76  00:A605            se_op_set_loop1_counter:
   77  00:A605  B1 D2         lda [sound_ptr], y      ;read the argument (# times to loop)
   78  00:A607  9D 91 03      sta stream_loop1, x     ;store it in the loop counter variable
   79  00:A60A  60            rts
   80                         
   81  00:A60B            se_op_loop1:
   82  00:A60B  DE 91 03      dec stream_loop1, x     ;decrement the counter
   83  00:A60E  BD 91 03      lda stream_loop1, x
   84  00:A611  F0 03         beq .last_iteration     ;if zero, we are done looping
   85  00:A613  4C DD A5      jmp se_op_infinite_loop ;if not zero, jump back
   86  00:A616            .last_iteration:
   87  00:A616  C8            iny                     ;skip the first byte of the address argument
   88                                                 ; the second byte will be skipped automatically upon return
   89                                                 ; (see se_fetch_byte after "jsr se_opcode_launcher")
   90  00:A617  60            rts
   91                         
   92  00:A618            se_op_set_note_offset:
   93  00:A618  B1 D2         lda [sound_ptr], y          ;read the argument
   94  00:A61A  9D 99 03      sta stream_note_offset, x      ;set the note offset.
   95  00:A61D  60            rts
   96                         
   97  00:A61E            se_op_adjust_note_offset:
   98  00:A61E  B1 D2         lda [sound_ptr], y          ;read the argument (what value to add)
   99  00:A620  18            clc
  100  00:A621  7D 99 03      adc stream_note_offset, x   ;add it to the current offset
  101  00:A624  9D 99 03      sta stream_note_offset, x   ;and save.
  102  00:A627  60            rts
  103                         
  104  00:A628            se_op_transpose:
  105  00:A628  B1 D2         lda [sound_ptr], y          ;read low byte of the pointer to our lookup table
  106  00:A62A  8D D4 00      sta sound_ptr2              ;store it in a new pointer variable
  107  00:A62D  C8            iny
  108  00:A62E  B1 D2         lda [sound_ptr], y          ;read high byte of pointer to table
  109  00:A630  8D D5 00      sta sound_ptr2+1
  110                         
  111  00:A633  8C 01 03      sty sound_temp1             ;save y because we are about to destroy it
  112  00:A636  BD 91 03      lda stream_loop1, x         ;get loop counter, put it in Y
  113  00:A639  A8            tay                         ;   this will be our index into the lookup table
  114  00:A63A  88            dey                         ;subtract 1 because indexes start from 0.
  115                         
  116  00:A63B  B1 D4         lda [sound_ptr2], y         ;read a value from the table.
  117  00:A63D  18            clc
  118  00:A63E  7D 99 03      adc stream_note_offset, x   ;add it to the note offset
  119  00:A641  9D 99 03      sta stream_note_offset, x
  120                         
  121  00:A644  AC 01 03      ldy sound_temp1             ;restore Y
  122  00:A647  60            rts
  123                             
  124  00:A648            se_op_change_pe:
  125  00:A648  B1 D2         lda [sound_ptr], y      ;read the argument
  126  00:A64A  9D 9F 03      sta stream_pe, x        ;store it in our volume envelope variable
  127  00:A64D  A9 00         lda #$00
  128  00:A64F  9D A7 03      sta stream_pe_index, x  ;reset volume envelope index to the beginning
  129  00:A652  9D B7 03          sta stream_pe_delay, x
  130  00:A655  60            rts
  131                             
  132  00:A656            se_op_change_arp:
  133  00:A656  B1 D2             lda [sound_ptr], y
  134  00:A658  9D BF 03          sta stream_arp, x
  135  00:A65B  A9 00             lda #$00
  136  00:A65D  9D C7 03          sta stream_arp_index, x
  137  00:A660  60                rts
