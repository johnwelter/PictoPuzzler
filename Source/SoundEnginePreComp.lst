  370  00:A31B  BD 62 03      lda stream_note_LO, x
  371  00:A31E  99 08 03      sta soft_apu_ports+2, y     ;period LO
  372                         
  373  00:A321  BD 6A 03      lda stream_note_HI, x
  374  00:A324  99 09 03      sta soft_apu_ports+3, y     ;period HI
  375                             
