  441                     ;
  442  00:A387            se_set_stream_arpeggio:
  443                         
  444  00:A387  BD 22 03          lda stream_status, x
  445  00:A38A  29 02         and #%00000010
  446  00:A38C  F0 01             beq .continue
  447  00:A38E  60                rts
  448                             
  449  00:A38F            .continue:
  450  00:A38F  8C 02 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  451                         
  452  00:A392  BD C0 03      lda stream_arp, x            ;which volume envelope?
  453  00:A395  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  454  00:A396  A8            tay
  455  00:A397  B9 1B A9      lda kArp, y     ;get the low byte of the address from the pointer table
  456  00:A39A  8D D2 00      sta sound_ptr               ;put it into our pointer variable
  457  00:A39D  B9 1C A9      lda kArp+1, y   ;get the high byte of the address
  458  00:A3A0  8D D3 00      sta sound_ptr+1
  459                         
  460  00:A3A3            .read_arp:
  461  00:A3A3  BC C8 03      ldy stream_arp_index, x      ;our current position within the volume envelope.
  462  00:A3A6  B1 D2         lda [sound_ptr], y          ;grab the value.
  463  00:A3A8  C9 81         cmp #$81
  464  00:A3AA  D0 08         bne .set_arp                ;if not 80, set the volume
  465  00:A3AC  A9 00             LDA #$00
  466  00:A3AE  9D C8 03      STA stream_arp_index, x      ;else if 80, go back one to start
  467  00:A3B1  4C A3 A3      jmp .read_arp                ;  FF essentially tells us to repeat the last
  468                                                     ;  volume value for the remainder of the note
  469  00:A3B4            .set_arp:
  470  00:A3B4  8D 03 03      STA sound_temp2             ;save our new volume value (about to destroy A)
  471  00:A3B7  BD 5A 03          LDA stream_note_idx, x          ;note indexes are premultiplied, un mult for an easier add
  472  00:A3BA  4A                LSR A                           
  473  00:A3BB  18                CLC
  474  00:A3BC  6D 03 03          ADC sound_temp2
  475  00:A3BF  8D 03 03          STA sound_temp2
  476                             
  477                             
  478  00:A3C2  AC 02 03          LDY sound_temp1
  479  00:A3C5  8E 02 03          STX sound_temp1
  480  00:A3C8  0A                ASL A
  481  00:A3C9  AA                TAX 
  482                     
  483  00:A3CA  BD 8D A6          LDA note_table, x
  484  00:A3CD  99 08 03          STA soft_apu_ports+2, y
  485  00:A3D0  BD 8E A6          LDA note_table+1, x
  486  00:A3D3  99 09 03          STA soft_apu_ports+3, y
  487                             
  488  00:A3D6  AE 02 03          LDX sound_temp1
  489                             
  490  00:A3D9  FE C8 03      inc stream_arp_index, x      ;set our volume envelop index to the next position
  491                             
  492  00:A3DC  98                TYA
  493  00:A3DD  8D 02 03          STA sound_temp1
  494                     
  495  00:A3E0  60            rts 
