  112                     ;--------------------------
  113                     ; sound_play_frame advances the sound engine by one frame
  114  00:A18B            sound_play_frame:
  115  00:A18B  AD 01 03      lda sound_disable_flag
  116  00:A18E  D0 31         bne .done   ;if disable flag is set, don't advance a frame
  117                     
  118  00:A190  20 ED A0      jsr se_silence  ;silence all channels.  se_set_apu will set volume later for all channels that are enabled.
  119                                         ;the purpose of this subroutine call is to silence channels that aren't used by any streams.
  120  00:A193  A2 00         ldx #$00
  121  00:A195            .loop:
  122  00:A195  BD 22 03      lda stream_status, x
  123  00:A198  29 01         and #$01    ;check whether the stream is active
  124  00:A19A  F0 1D         beq .endloop  ;if the stream isn't active, skip it
  125                         
  126                         ;add the tempo to the ticker total.  If there is a FF-> 0 transition, there is a tick
  127  00:A19C  BD 7A 03      lda stream_ticker_total, x
  128  00:A19F  18            clc
  129  00:A1A0  7D 72 03      adc stream_tempo, x
  130  00:A1A3  9D 7A 03      sta stream_ticker_total, x
  131  00:A1A6  90 0E         bcc .set_buffer    ;carry clear = no tick.  if no tick, we are done with this stream
  132                         
  133  00:A1A8  DE 82 03      dec stream_note_length_counter, x   ;else there is a tick. decrement the note length counter
  134  00:A1AB  D0 09         bne .set_buffer    ;if counter is non-zero, our note isn't finished playing yet
  135  00:A1AD  BD 8A 03      lda stream_note_length, x   ;else our note is finished. reload the note length counter
  136  00:A1B0  9D 82 03      sta stream_note_length_counter, x
  137                         
  138  00:A1B3  20 C2 A1      jsr se_fetch_byte   ;read the next byte from the data stream
  139                         
  140  00:A1B6            .set_buffer:
  141  00:A1B6  20 FD A2      jsr se_set_temp_ports   ;copy the current stream's sound data for the current frame into our temporary APU vars (soft_apu_ports)
  142  00:A1B9            .endloop:
  143  00:A1B9  E8            inx
  144  00:A1BA  E0 08         cpx #$08
  145  00:A1BC  D0 D7         bne .loop
  146  00:A1BE  20 90 A4      jsr se_set_apu      ;copy the temporary APU variables (soft_apu_ports) to the real APU ports ($4000, $4001, etc)
  147  00:A1C1            .done:
  148  00:A1C1  60            rts
