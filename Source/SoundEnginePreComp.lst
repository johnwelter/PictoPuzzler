  150                     ;--------------------------
  151                     ; se_fetch_byte reads one byte from a sound data stream and handles it
  152                     ;   input: 
  153                     ;       X: stream number    
  154  00:A1C2            se_fetch_byte:
  155  00:A1C2  BD 32 03      lda stream_ptr_LO, x
  156  00:A1C5  8D D2 00      sta sound_ptr
  157  00:A1C8  BD 3A 03      lda stream_ptr_HI, x
  158  00:A1CB  8D D3 00      sta sound_ptr+1
  159                         
  160  00:A1CE  A0 00         ldy #$00
  161  00:A1D0            .fetch:
  162  00:A1D0  B1 D2         lda [sound_ptr], y
  163  00:A1D2  10 26         bpl .note                ;if < #$80, it's a Note
  164  00:A1D4  C9 A0         cmp #$A0
  165  00:A1D6  90 0C         bcc .note_length         ;else if < #$A0, it's a Note Length
  166  00:A1D8            .opcode:                     ;else it's an opcode
  167                         ;do Opcode stuff
  168  00:A1D8  20 E2 A2      jsr se_opcode_launcher
  169  00:A1DB  C8            iny                      ;next position in the data stream
  170  00:A1DC  BD 22 03      lda stream_status, x
  171  00:A1DF  29 01         and #%00000001
  172  00:A1E1  D0 ED         bne .fetch               ;after our opcode is done, grab another byte unless the stream is disabled
  173  00:A1E3  60            rts                      ; in which case we quit  (explained below)
  174  00:A1E4            .note_length:
  175                         ;do note length stuff
  176  00:A1E4  29 7F         and #%01111111          ;chop off bit7
  177  00:A1E6  8C 02 03      sty sound_temp1         ;save Y because we are about to destroy it
  178  00:A1E9  A8            tay
  179  00:A1EA  B9 4B A7      lda note_length_table, y    ;get the note length count value
  180  00:A1ED  9D 8A 03      sta stream_note_length, x
  181  00:A1F0  9D 82 03      sta stream_note_length_counter, x   ;stick it in our note length counter
  182  00:A1F3  AC 02 03      ldy sound_temp1         ;restore Y
  183  00:A1F6  C8            iny                     ;set index to next byte in the stream
  184  00:A1F7  4C D0 A1      jmp .fetch              ;fetch another byte
  185  00:A1FA            .note:
  186                         ;do Note stuff
  187  00:A1FA  8D 03 03      sta sound_temp2
  188  00:A1FD  BD 2A 03      lda stream_channel, x
  189  00:A200  C9 03         cmp #NOISE
  190  00:A202  D0 06         bne .not_noise
  191  00:A204  20 52 A2      jsr se_do_noise
  192  00:A207  4C 35 A2      jmp .reset_ve
  193  00:A20A            .not_noise:
  194  00:A20A  C9 04             cmp #DPMC
  195  00:A20C  90 06             bcc .not_dpmc
  196  00:A20E  20 8A A2          jsr se_do_dpmc
  197  00:A211  4C 35 A2          jmp .reset_ve
  198  00:A214            .not_dpmc:
  199  00:A214  AD 03 03      lda sound_temp2
  200  00:A217  8C 02 03      sty sound_temp1     ;save our index into the data stream
  201  00:A21A  18            clc
  202  00:A21B  7D 9A 03      adc stream_note_offset, x   ;add note offset
  203  00:A21E  0A            asl a
  204  00:A21F  A8            tay
  205  00:A220  9D 5A 03          sta stream_note_idx, x
  206  00:A223  B9 8D A6      lda note_table, y
  207  00:A226  9D 62 03      sta stream_note_LO, x
  208  00:A229  B9 8E A6      lda note_table+1, y
  209  00:A22C  9D 6A 03      sta stream_note_HI, x
  210  00:A22F  AC 02 03      ldy sound_temp1     ;restore data stream index
  211                         
  212                         ;check if it's a rest and modify the status flag appropriately
  213                     
  214  00:A232  20 CC A2      jsr se_check_rest
  215  00:A235            .reset_ve:    
  216  00:A235  A9 00         lda #$00
  217  00:A237  9D 4A 03      sta stream_ve_index, x  
  218  00:A23A  9D A8 03          sta stream_pe_index, x
  219  00:A23D  9D B8 03          sta stream_pe_delay, x
  220  00:A240  9D C8 03          sta stream_arp_index,x
  221  00:A243            .update_pointer:
  222  00:A243  C8            iny
  223  00:A244  98            tya
  224  00:A245  18            clc
  225  00:A246  7D 32 03      adc stream_ptr_LO, x
  226  00:A249  9D 32 03      sta stream_ptr_LO, x
  227  00:A24C  90 03         bcc .end
  228  00:A24E  FE 3A 03      inc stream_ptr_HI, x
  229  00:A251            .end:
  230  00:A251  60            rts
