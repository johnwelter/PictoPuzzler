   97  00:A16F  9D 4A 03      sta stream_ve_index, x
   98  00:A172  9D A8 03          sta stream_pe_index, x
   99  00:A175  9D C8 03          sta stream_arp_index, x
  100  00:A178  9D 92 03      sta stream_loop1, x
  101  00:A17B  9D 9A 03      sta stream_note_offset, x
