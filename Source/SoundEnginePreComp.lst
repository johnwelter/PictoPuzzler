  497                     ;
  498  00:A3E1            se_set_stream_pitch:
  499  00:A3E1  8C 02 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  500                         
  501  00:A3E4  BD A0 03      lda stream_pe, x            ;which volume envelope?
  502  00:A3E7  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  503  00:A3E8  A8            tay
  504  00:A3E9  B9 CE A8      lda kMod, y     ;get the low byte of the address from the pointer table
  505  00:A3EC  8D D2 00      sta sound_ptr               ;put it into our pointer variable
  506  00:A3EF  B9 CF A8      lda kMod+1, y   ;get the high byte of the address
  507  00:A3F2  8D D3 00      sta sound_ptr+1
  508                             
  509  00:A3F5  BD B8 03          LDA stream_pe_delay, x
  510                             ;;if not 0, decrement
  511                             ;AND #$7F                       ;check if, without minus flag, the delay is 0
  512  00:A3F8  F0 04             BEQ .read_pe
  513  00:A3FA  DE B8 03          DEC stream_pe_delay, x
  514  00:A3FD  60                RTS
  515                         
  516  00:A3FE            .read_pe:
  517  00:A3FE  BC A8 03      ldy stream_pe_index, x      ;our current position within the volume envelope.
  518  00:A401  B1 D2         lda [sound_ptr], y          ;grab the value.
  519  00:A403  C9 80         cmp #l_cLast
  520  00:A405  D0 06             BNE .notLoopLast
  521  00:A407  DE A8 03          dec stream_pe_index, x      ;else if loop last, go back one and read again
  522  00:A40A  4C FE A3          jmp .read_pe 
  523                     
  524  00:A40D            .notLoopLast:
  525  00:A40D  C9 81             cmp #l_cAll
  526  00:A40F  D0 08             BNE .notLoopAll
  527  00:A411  A9 00             LDA #$00
  528  00:A413  9D A8 03          STA stream_pe_index, x
  529  00:A416  4C FE A3          jmp .read_pe
  530                             
  531  00:A419            .notLoopAll:
  532  00:A419  C9 82             cmp #l_cPart
  533  00:A41B  D0 0D             BNE .notLoopPart
  534  00:A41D  C8                iny
  535  00:A41E  BD A8 03          lda stream_pe_index, x
  536  00:A421  38                SEC
  537  00:A422  F1 D2             SBC [sound_ptr], y
  538  00:A424  9D A8 03          STA stream_pe_index, x
  539  00:A427  4C FE A3          jmp .read_pe
  540                     
  541  00:A42A            .notLoopPart:
  542  00:A42A  C9 83             cmp #l_cHold
  543  00:A42C  D0 15             BNE .notLoopDelay
  544                             ;LDA stream_pe_delay, x
  545                             ;BMI .delayUsed ;negative, delay was already used this time
  546  00:A42E  C8                iny
  547  00:A42F  B1 D2             lda [sound_ptr], y
  548                             ;ORA #$80
  549  00:A431  9D B8 03          STA stream_pe_delay, x
  550  00:A434  FE A8 03          inc stream_pe_index, x
  551  00:A437  4C 80 A4          jmp .finish_pitchShift
  552  00:A43A            .delayUsed:
  553  00:A43A  FE A8 03          inc stream_pe_index, x
  554  00:A43D  FE A8 03          inc stream_pe_index, x
  555  00:A440  4C FE A3          jmp .read_pe
  556                             
  557  00:A443            .notLoopDelay:
  558  00:A443            .set_pitch:
  559                     
  560  00:A443  9D B0 03      sta stream_pe_offset, x      ;get current vol/duty settings
  561  00:A446  8D 03 03          STA sound_temp2
  562  00:A449  AC 02 03          LDY sound_temp1
  563  00:A44C  AD 03 03          LDA sound_temp2
  564  00:A44F  10 1D             BPL .add_pitch
  565                             
  566  00:A451            .sub_pitch:
  567                             
  568  00:A451  49 FF             EOR #$FF        ;flip bits
  569  00:A453  18                CLC
  570  00:A454  69 01             ADC #$01        ;add one - two's compliment
  571  00:A456  8D 03 03          STA sound_temp2
  572                             
  573  00:A459  B9 08 03          LDA soft_apu_ports+2, y       
  574  00:A45C  38                SEC
  575  00:A45D  ED 03 03          SBC sound_temp2
  576  00:A460  99 08 03          STA soft_apu_ports+2, y
  577  00:A463  B9 09 03          LDA soft_apu_ports+3, y
  578  00:A466  E9 00             SBC #$00
  579  00:A468  99 09 03          STA soft_apu_ports+3, y
  580                             
  581  00:A46B  4C 80 A4          JMP .finish_pitchShift
  582                     
  583  00:A46E            .add_pitch:
  584                     
  585  00:A46E  B9 08 03      LDA soft_apu_ports+2, y       
  586  00:A471  18                CLC
  587  00:A472  6D 03 03          ADC sound_temp2
  588  00:A475  99 08 03          STA soft_apu_ports+2, y
  589  00:A478  B9 09 03          LDA soft_apu_ports+3, y
  590  00:A47B  69 00             ADC #$00
  591  00:A47D  99 09 03          STA soft_apu_ports+3, y
  592                             
  593  00:A480            .finish_pitchShift:
  594  00:A480  FE A8 03      inc stream_pe_index, x      ;set our volume envelop index to the next position
  595                     
  596  00:A483            .rest_check:
  597                         ;check the rest flag. if set, overwrite volume with silence value 
  598  00:A483  BD 22 03      lda stream_status, x
  599  00:A486  29 02         and #%00000010
  600  00:A488  F0 05         beq .done                   ;if clear, no rest, so quit
  601                        
  602  00:A48A  A9 00         LDA #$00
  603  00:A48C  9D B0 03          STA stream_pe_offset, x
  604  00:A48F            .done:
  605  00:A48F  60            rts    
