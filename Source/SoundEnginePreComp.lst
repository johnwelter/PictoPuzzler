  653                         
#[3]   Source/External/SoundEngine/Source/sound_opcodes.asm
  654                         .include "Source/External/SoundEngine/Source/sound_opcodes.asm"    ;our opcode subroutines, jump table and aliases
    1                     ;these are aliases to use in the sound data.
    2           00A0      endsound = $A0
    3           00A1      loop = $A1
    4           00A2      volume_envelope = $A2
    5           00A3      duty = $A3
    6           00A4      set_loop1_counter = $A4
    7           00A5      loop1 = $A5
    8           00A6      set_note_offset = $A6
    9           00A7      adjust_note_offset = $A7
   10           00A8      transpose = $A8
   11           00A9      pitch_envelope = $A9
   12           00AA      arpeggio = $AA
   13                     
   14                     ;-----------------------------------------------------------------------
   15                     ;this is our JUMP TABLE!
   16  00:A5DA            sound_opcodes:
   17  00:A5DA  F0 A5         .word se_op_endsound            ;$A0
   18  00:A5DC  09 A6         .word se_op_infinite_loop       ;$A1
   19  00:A5DE  20 A6         .word se_op_change_ve           ;$A2
   20  00:A5E0  2B A6         .word se_op_duty                ;$A3
   21  00:A5E2  31 A6         .word se_op_set_loop1_counter   ;$A4
   22  00:A5E4  37 A6         .word se_op_loop1               ;$A5
   23  00:A5E6  44 A6         .word se_op_set_note_offset     ;$A6
   24  00:A5E8  4A A6         .word se_op_adjust_note_offset  ;$A7
   25  00:A5EA  54 A6         .word se_op_transpose           ;$A8
   26  00:A5EC  74 A6             .word se_op_change_pe                   ;$A9
   27  00:A5EE  82 A6             .word se_op_change_arp
   28                         ;etc, 1 entry per subroutine
   29                     
   30                         
   31                     ;-----------------------------------------------------------------
   32                     ; these are the actual opcode subroutines
   33  00:A5F0            se_op_endsound:
   34  00:A5F0  BD 22 03      lda stream_status, x    ;end of stream, so disable it and silence
   35  00:A5F3  29 FE         and #%11111110
   36  00:A5F5  9D 22 03      sta stream_status, x    ;clear enable flag in status byte
   37                         
   38  00:A5F8  BD 2A 03      lda stream_channel, x
   39  00:A5FB  C9 02         cmp #TRIANGLE
   40  00:A5FD  F0 04         beq .silence_tri        ;triangle is silenced differently from squares and noise
   41  00:A5FF  A9 30         lda #$30                ;squares and noise silenced with #$30
   42  00:A601  D0 02         bne .silence            ; (this will always branch.  bne is cheaper than a jmp)
   43  00:A603            .silence_tri:
   44  00:A603  A9 80         lda #$80                ;triangle silenced with #$80
   45  00:A605            .silence:
   46  00:A605  9D 52 03      sta stream_vol_duty, x  ;store silence value in the stream's volume variable.
   47                     
   48  00:A608  60            rts
   49                         
   50  00:A609            se_op_infinite_loop:
   51  00:A609  B1 D2         lda [sound_ptr], y      ;read ptr LO from the data stream
   52  00:A60B  9D 32 03      sta stream_ptr_LO, x    ;update our data stream position
   53  00:A60E  C8            iny
   54  00:A60F  B1 D2         lda [sound_ptr], y      ;read ptr HI from the data stream
   55  00:A611  9D 3A 03      sta stream_ptr_HI, x    ;update our data stream position
   56                         
   57  00:A614  8D D3 00      sta sound_ptr+1         ;update the pointer to reflect the new position.
   58  00:A617  BD 32 03      lda stream_ptr_LO, x
   59  00:A61A  8D D2 00      sta sound_ptr
   60  00:A61D  A0 FF         ldy #$FF                ;after opcodes return, we do an iny.  Since we reset  
   61                                                 ;the stream buffer position, we will want y to start out at 0 again.
   62  00:A61F  60            rts
   63                         
   64  00:A620            se_op_change_ve:
   65  00:A620  B1 D2         lda [sound_ptr], y      ;read the argument
   66  00:A622  9D 42 03      sta stream_ve, x        ;store it in our volume envelope variable
   67  00:A625  A9 00         lda #$00
   68  00:A627  9D 4A 03      sta stream_ve_index, x  ;reset volume envelope index to the beginning
   69  00:A62A  60            rts
   70                         
   71  00:A62B            se_op_duty:
   72  00:A62B  B1 D2         lda [sound_ptr], y
   73  00:A62D  9D 52 03      sta stream_vol_duty, x
   74  00:A630  60            rts
   75                         
   76  00:A631            se_op_set_loop1_counter:
   77  00:A631  B1 D2         lda [sound_ptr], y      ;read the argument (# times to loop)
   78  00:A633  9D 92 03      sta stream_loop1, x     ;store it in the loop counter variable
   79  00:A636  60            rts
   80                         
   81  00:A637            se_op_loop1:
   82  00:A637  DE 92 03      dec stream_loop1, x     ;decrement the counter
   83  00:A63A  BD 92 03      lda stream_loop1, x
   84  00:A63D  F0 03         beq .last_iteration     ;if zero, we are done looping
   85  00:A63F  4C 09 A6      jmp se_op_infinite_loop ;if not zero, jump back
   86  00:A642            .last_iteration:
   87  00:A642  C8            iny                     ;skip the first byte of the address argument
   88                                                 ; the second byte will be skipped automatically upon return
   89                                                 ; (see se_fetch_byte after "jsr se_opcode_launcher")
   90  00:A643  60            rts
   91                         
   92  00:A644            se_op_set_note_offset:
   93  00:A644  B1 D2         lda [sound_ptr], y          ;read the argument
   94  00:A646  9D 9A 03      sta stream_note_offset, x      ;set the note offset.
   95  00:A649  60            rts
   96                         
   97  00:A64A            se_op_adjust_note_offset:
   98  00:A64A  B1 D2         lda [sound_ptr], y          ;read the argument (what value to add)
   99  00:A64C  18            clc
  100  00:A64D  7D 9A 03      adc stream_note_offset, x   ;add it to the current offset
  101  00:A650  9D 9A 03      sta stream_note_offset, x   ;and save.
  102  00:A653  60            rts
  103                         
  104  00:A654            se_op_transpose:
  105  00:A654  B1 D2         lda [sound_ptr], y          ;read low byte of the pointer to our lookup table
  106  00:A656  8D D4 00      sta sound_ptr2              ;store it in a new pointer variable
  107  00:A659  C8            iny
  108  00:A65A  B1 D2         lda [sound_ptr], y          ;read high byte of pointer to table
  109  00:A65C  8D D5 00      sta sound_ptr2+1
  110                         
  111  00:A65F  8C 02 03      sty sound_temp1             ;save y because we are about to destroy it
  112  00:A662  BD 92 03      lda stream_loop1, x         ;get loop counter, put it in Y
  113  00:A665  A8            tay                         ;   this will be our index into the lookup table
  114  00:A666  88            dey                         ;subtract 1 because indexes start from 0.
  115                         
  116  00:A667  B1 D4         lda [sound_ptr2], y         ;read a value from the table.
  117  00:A669  18            clc
  118  00:A66A  7D 9A 03      adc stream_note_offset, x   ;add it to the note offset
  119  00:A66D  9D 9A 03      sta stream_note_offset, x
  120                         
  121  00:A670  AC 02 03      ldy sound_temp1             ;restore Y
  122  00:A673  60            rts
  123                             
  124  00:A674            se_op_change_pe:
  125  00:A674  B1 D2         lda [sound_ptr], y      ;read the argument
  126  00:A676  9D A0 03      sta stream_pe, x        ;store it in our volume envelope variable
  127  00:A679  A9 00         lda #$00
  128  00:A67B  9D A8 03      sta stream_pe_index, x  ;reset volume envelope index to the beginning
  129  00:A67E  9D B8 03          sta stream_pe_delay, x
  130  00:A681  60            rts
  131                             
  132  00:A682            se_op_change_arp:
  133  00:A682  B1 D2             lda [sound_ptr], y
  134  00:A684  9D C0 03          sta stream_arp, x
  135  00:A687  A9 00             lda #$00
  136  00:A689  9D C8 03          sta stream_arp_index, x
  137  00:A68C  60                rts
