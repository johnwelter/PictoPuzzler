  262  00:A28A            se_do_dpmc:
  263  00:A28A  8A                TXA
  264  00:A28B  48                PHA
  265                             
  266  00:A28C  AD 00 03          lda sound_enable_flags
  267  00:A28F  29 0F             AND #$0F
  268  00:A291  8D 00 03          sta sound_enable_flags ;DPCM disable
  269  00:A294  8D 15 40          sta $4015
  270                             
  271  00:A297  AD 03 03          lda sound_temp2         ;load up sample index- we can cram in the pitch and keep ourselves to 6 samples (7 will be rest)
  272  00:A29A  C9 70             CMP #$70
  273  00:A29C  B0 2B             BCS .leave
  274                     
  275  00:A29E  29 0F             AND #$0F
  276  00:A2A0  8D 10 40          sta $4010 ;pitch
  277  00:A2A3  A9 7F             LDA #$7F
  278  00:A2A5  8D 11 40          sta $4011 ;temp = starting sample level
  279  00:A2A8  AD 03 03          lda sound_temp2
  280  00:A2AB  29 F0             AND #$F0
  281  00:A2AD  4A                LSR A
  282  00:A2AE  4A                LSR A
  283  00:A2AF  4A                LSR A
  284  00:A2B0  4A                LSR A
  285  00:A2B1  AA                TAX
  286  00:A2B2  BD 31 D9          lda SampleStart,x
  287  00:A2B5  8D 12 40          sta $4012 ;X = sample number
  288  00:A2B8  BD 33 D9          lda SampleLength,x
  289  00:A2BB  8D 13 40          sta $4013
  290                             
  291  00:A2BE  AD 00 03          lda sound_enable_flags
  292  00:A2C1  09 10             ORA #$10
  293  00:A2C3  8D 00 03          STA sound_enable_flags
  294  00:A2C6  8D 15 40          sta $4015
  295  00:A2C9            .leave:
  296  00:A2C9  68                PLA
  297  00:A2CA  AA                TAX
  298                     
  299  00:A2CB  60                rts
