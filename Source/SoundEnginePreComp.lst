  342                     ; se_set_temp_ports will copy a stream's sound data to the temporary apu variables
  343                     ;      input:
  344                     ;           X: stream number
  345  00:A2FD            se_set_temp_ports:
  346                     
  347  00:A2FD  E0 06             cpx #MUSIC_DPMC
  348  00:A2FF  90 01             bcc .contTempPorts
  349  00:A301  60                rts
  350  00:A302            .contTempPorts:
  351  00:A302  BD 2A 03      lda stream_channel, x
  352  00:A305  0A            asl a
  353  00:A306  0A            asl a
  354  00:A307  A8            tay
  355                         
  356  00:A308  20 2B A3      jsr se_set_stream_volume
  357                             
  358                         
  359  00:A30B  A9 08         lda #$08
  360  00:A30D  99 07 03      sta soft_apu_ports+1, y     ;sweep
  361                         
