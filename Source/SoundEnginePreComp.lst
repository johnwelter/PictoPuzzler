  427                             
  428  00:A363            .continue:
  429  00:A363  8C 01 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  430                         
  431  00:A366  BD BF 03      lda stream_arp, x            ;which volume envelope?
  432  00:A369  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  433  00:A36A  A8            tay
  434  00:A36B  B9 E7 A8      lda arpeggios, y     ;get the low byte of the address from the pointer table
  435  00:A36E  8D D2 00      sta sound_ptr               ;put it into our pointer variable
  436  00:A371  B9 E8 A8      lda arpeggios+1, y   ;get the high byte of the address
  437  00:A374  8D D3 00      sta sound_ptr+1
  438                         
  439  00:A377            .read_arp:
  440  00:A377  BC C7 03      ldy stream_arp_index, x      ;our current position within the volume envelope.
  441  00:A37A  B1 D2         lda [sound_ptr], y          ;grab the value.
  442  00:A37C  C9 80         cmp #$80
  443  00:A37E  D0 08         bne .set_arp                ;if not 80, set the volume
  444  00:A380  A9 00             LDA #$00
  445  00:A382  9D C7 03      STA stream_arp_index, x      ;else if 80, go back one to start
  446  00:A385  4C 77 A3      jmp .read_arp                ;  FF essentially tells us to repeat the last
  447                                                     ;  volume value for the remainder of the note
  448  00:A388            .set_arp:
  449  00:A388  8D 02 03      STA sound_temp2             ;save our new volume value (about to destroy A)
  450  00:A38B  BD 59 03          LDA stream_note_idx, x          ;note indexes are premultiplied, un mult for an easier add
  451  00:A38E  4A                LSR A                           
  452  00:A38F  18                CLC
  453  00:A390  6D 02 03          ADC sound_temp2
  454  00:A393  8D 02 03          STA sound_temp2
  455                             
  456                             
  457  00:A396  AC 01 03          LDY sound_temp1
  458  00:A399  8E 01 03          STX sound_temp1
  459  00:A39C  0A                ASL A
  460  00:A39D  AA                TAX 
  461                     
  462  00:A39E  BD 61 A6          LDA note_table, x
  463  00:A3A1  99 07 03          STA soft_apu_ports+2, y
  464  00:A3A4  BD 62 A6          LDA note_table+1, x
  465  00:A3A7  99 08 03          STA soft_apu_ports+3, y
  466                             
  467  00:A3AA  AE 01 03          LDX sound_temp1
  468                             
  469  00:A3AD  FE C7 03      inc stream_arp_index, x      ;set our volume envelop index to the next position
  470                             
  471  00:A3B0  98                TYA
  472  00:A3B1  8D 01 03          STA sound_temp1
  473                     
  474  00:A3B4  60            rts 
  475                     ;--------------------------------------
  476                     ;
  477  00:A3B5            se_set_stream_pitch:
  478  00:A3B5  8C 01 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  479                         
  480  00:A3B8  BD 9F 03      lda stream_pe, x            ;which volume envelope?
  481  00:A3BB  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  482  00:A3BC  A8            tay
  483  00:A3BD  B9 A2 A8      lda pitch_envelopes, y     ;get the low byte of the address from the pointer table
  484  00:A3C0  8D D2 00      sta sound_ptr               ;put it into our pointer variable
  485  00:A3C3  B9 A3 A8      lda pitch_envelopes+1, y   ;get the high byte of the address
  486  00:A3C6  8D D3 00      sta sound_ptr+1
  487                             
  488  00:A3C9  BD B7 03          LDA stream_pe_delay, x
  489                             ;;if not 0, decrement
  490                             ;AND #$7F                       ;check if, without minus flag, the delay is 0
  491  00:A3CC  F0 04             BEQ .read_pe
  492  00:A3CE  DE B7 03          DEC stream_pe_delay, x
  493  00:A3D1  60                RTS
  494                         
  495  00:A3D2            .read_pe:
  496  00:A3D2  BC A7 03      ldy stream_pe_index, x      ;our current position within the volume envelope.
  497  00:A3D5  B1 D2         lda [sound_ptr], y          ;grab the value.
  498  00:A3D7  C9 80         cmp #pe_loopLast
  499  00:A3D9  D0 06             BNE .notLoopLast
  500  00:A3DB  DE A7 03          dec stream_pe_index, x      ;else if loop last, go back one and read again
  501  00:A3DE  4C D2 A3          jmp .read_pe 
  502                     
  503  00:A3E1            .notLoopLast:
  504  00:A3E1  C9 81             cmp #pe_loopAll
  505  00:A3E3  D0 08             BNE .notLoopAll
  506  00:A3E5  A9 00             LDA #$00
  507  00:A3E7  9D A7 03          STA stream_pe_index, x
  508  00:A3EA  4C D2 A3          jmp .read_pe
  509                             
  510  00:A3ED            .notLoopAll:
  511  00:A3ED  C9 82             cmp #pe_loopPart
  512  00:A3EF  D0 0D             BNE .notLoopPart
  513  00:A3F1  C8                iny
  514  00:A3F2  BD A7 03          lda stream_pe_index, x
  515  00:A3F5  38                SEC
  516  00:A3F6  F1 D2             SBC [sound_ptr], y
  517  00:A3F8  9D A7 03          STA stream_pe_index, x
  518  00:A3FB  4C D2 A3          jmp .read_pe
  519                     
  520  00:A3FE            .notLoopPart:
  521  00:A3FE  C9 83             cmp #pe_delay
  522  00:A400  D0 15             BNE .notLoopDelay
  523                             ;LDA stream_pe_delay, x
  524                             ;BMI .delayUsed ;negative, delay was already used this time
  525  00:A402  C8                iny
  526  00:A403  B1 D2             lda [sound_ptr], y
  527                             ;ORA #$80
  528  00:A405  9D B7 03          STA stream_pe_delay, x
  529  00:A408  FE A7 03          inc stream_pe_index, x
  530  00:A40B  4C 54 A4          jmp .finish_pitchShift
  531  00:A40E            .delayUsed:
  532  00:A40E  FE A7 03          inc stream_pe_index, x
  533  00:A411  FE A7 03          inc stream_pe_index, x
  534  00:A414  4C D2 A3          jmp .read_pe
  535                             
  536  00:A417            .notLoopDelay:
  537  00:A417            .set_pitch:
  538                     
  539  00:A417  9D AF 03      sta stream_pe_offset, x      ;get current vol/duty settings
  540  00:A41A  8D 02 03          STA sound_temp2
  541  00:A41D  AC 01 03          LDY sound_temp1
  542  00:A420  AD 02 03          LDA sound_temp2
  543  00:A423  10 1D             BPL .add_pitch
  544                             
  545  00:A425            .sub_pitch:
  546                             
  547  00:A425  49 FF             EOR #$FF        ;flip bits
  548  00:A427  18                CLC
  549  00:A428  69 01             ADC #$01        ;add one - two's compliment
  550  00:A42A  8D 02 03          STA sound_temp2
  551                             
  552  00:A42D  B9 07 03          LDA soft_apu_ports+2, y       
  553  00:A430  38                SEC
  554  00:A431  ED 02 03          SBC sound_temp2
  555  00:A434  99 07 03          STA soft_apu_ports+2, y
  556  00:A437  B9 08 03          LDA soft_apu_ports+3, y
  557  00:A43A  E9 00             SBC #$00
  558  00:A43C  99 08 03          STA soft_apu_ports+3, y
  559                             
  560  00:A43F  4C 54 A4          JMP .finish_pitchShift
  561                     
  562  00:A442            .add_pitch:
  563                     
  564  00:A442  B9 07 03      LDA soft_apu_ports+2, y       
  565  00:A445  18                CLC
  566  00:A446  6D 02 03          ADC sound_temp2
  567  00:A449  99 07 03          STA soft_apu_ports+2, y
  568  00:A44C  B9 08 03          LDA soft_apu_ports+3, y
  569  00:A44F  69 00             ADC #$00
  570  00:A451  99 08 03          STA soft_apu_ports+3, y
  571                             
  572  00:A454            .finish_pitchShift:
  573  00:A454  FE A7 03      inc stream_pe_index, x      ;set our volume envelop index to the next position
  574                     
  575  00:A457            .rest_check:
  576                         ;check the rest flag. if set, overwrite volume with silence value 
  577  00:A457  BD 21 03      lda stream_status, x
  578  00:A45A  29 02         and #%00000010
  579  00:A45C  F0 05         beq .done                   ;if clear, no rest, so quit
  580                        
  581  00:A45E  A9 00         LDA #$00
  582  00:A460  9D AF 03          STA stream_pe_offset, x
  583  00:A463            .done:
  584  00:A463  60            rts    
  585                     
  586                     ;--------------------------
  587                     ; se_set_apu copies the temporary RAM ports to the APU ports
  588  00:A464            se_set_apu:
  589  00:A464            .square1:
  590  00:A464  AD 05 03      lda soft_apu_ports+0
  591  00:A467  8D 00 40      sta $4000
  592  00:A46A  AD 06 03      lda soft_apu_ports+1
  593  00:A46D  8D 01 40      sta $4001
  594  00:A470  AD 07 03      lda soft_apu_ports+2
  595  00:A473  8D 02 40      sta $4002
  596  00:A476  AD 08 03      lda soft_apu_ports+3
  597  00:A479  CD 03 03      cmp sound_sq1_old       ;compare to last write
  598  00:A47C  F0 06         beq .square2            ;don't write this frame if they were equal
  599  00:A47E  8D 03 40      sta $4003
  600  00:A481  8D 03 03      sta sound_sq1_old       ;save the value we just wrote to $4003
  601  00:A484            .square2:
  602  00:A484  AD 09 03      lda soft_apu_ports+4
  603  00:A487  8D 04 40      sta $4004
  604  00:A48A  AD 0A 03      lda soft_apu_ports+5
  605  00:A48D  8D 05 40      sta $4005
  606  00:A490  AD 0B 03      lda soft_apu_ports+6
  607  00:A493  8D 06 40      sta $4006
  608  00:A496  AD 0C 03      lda soft_apu_ports+7
  609  00:A499  CD 04 03      cmp sound_sq2_old
  610  00:A49C  F0 06         beq .triangle
  611  00:A49E  8D 07 40      sta $4007
  612  00:A4A1  8D 04 03      sta sound_sq2_old       ;save the value we just wrote to $4007
  613  00:A4A4            .triangle:
  614  00:A4A4  AD 0D 03      lda soft_apu_ports+8
  615  00:A4A7  8D 08 40      sta $4008
  616  00:A4AA  AD 0F 03      lda soft_apu_ports+10   ;there is no $4009, so we skip it
  617  00:A4AD  8D 0A 40      sta $400A
  618  00:A4B0  AD 10 03      lda soft_apu_ports+11
  619  00:A4B3  8D 0B 40      sta $400B
  620  00:A4B6            .noise:
  621  00:A4B6  AD 11 03      lda soft_apu_ports+12
  622  00:A4B9  8D 0C 40      sta $400C
  623  00:A4BC  AD 13 03      lda soft_apu_ports+14   ;there is no $400D, so we skip it
  624  00:A4BF  8D 0E 40      sta $400E
  625  00:A4C2  AD 14 03      lda soft_apu_ports+15
  626  00:A4C5  8D 0F 40      sta $400F
  627  00:A4C8  60            rts
