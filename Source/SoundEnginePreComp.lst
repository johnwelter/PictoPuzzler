   85  00:A15D  C8            iny
   86                         
   87  00:A15E  B1 D2         lda [sound_ptr], y
   88  00:A160  9D 72 03      sta stream_tempo, x
   89                         
   90  00:A163  A9 A0         lda #$A0
   91  00:A165  9D 7A 03      sta stream_ticker_total, x
   92                         
   93  00:A168  A9 01         lda #$01
   94  00:A16A  9D 82 03      sta stream_note_length_counter,x
   95                         
