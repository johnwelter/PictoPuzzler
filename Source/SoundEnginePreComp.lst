  607                     ;--------------------------
  608                     ; se_set_apu copies the temporary RAM ports to the APU ports
  609  00:A490            se_set_apu:
  610  00:A490            .square1:
  611  00:A490  AD 06 03      lda soft_apu_ports+0
  612  00:A493  8D 00 40      sta $4000
  613  00:A496  AD 07 03      lda soft_apu_ports+1
  614  00:A499  8D 01 40      sta $4001
  615  00:A49C  AD 08 03      lda soft_apu_ports+2
  616  00:A49F  8D 02 40      sta $4002
  617  00:A4A2  AD 09 03      lda soft_apu_ports+3
  618  00:A4A5  CD 04 03      cmp sound_sq1_old       ;compare to last write
  619  00:A4A8  F0 06         beq .square2            ;don't write this frame if they were equal
  620  00:A4AA  8D 03 40      sta $4003
  621  00:A4AD  8D 04 03      sta sound_sq1_old       ;save the value we just wrote to $4003
  622  00:A4B0            .square2:
  623  00:A4B0  AD 0A 03      lda soft_apu_ports+4
  624  00:A4B3  8D 04 40      sta $4004
  625  00:A4B6  AD 0B 03      lda soft_apu_ports+5
  626  00:A4B9  8D 05 40      sta $4005
  627  00:A4BC  AD 0C 03      lda soft_apu_ports+6
  628  00:A4BF  8D 06 40      sta $4006
  629  00:A4C2  AD 0D 03      lda soft_apu_ports+7
  630  00:A4C5  CD 05 03      cmp sound_sq2_old
  631  00:A4C8  F0 06         beq .triangle
  632  00:A4CA  8D 07 40      sta $4007
  633  00:A4CD  8D 05 03      sta sound_sq2_old       ;save the value we just wrote to $4007
  634  00:A4D0            .triangle:
  635  00:A4D0  AD 0E 03      lda soft_apu_ports+8
  636  00:A4D3  8D 08 40      sta $4008
  637  00:A4D6  AD 10 03      lda soft_apu_ports+10   ;there is no $4009, so we skip it
  638  00:A4D9  8D 0A 40      sta $400A
  639  00:A4DC  AD 11 03      lda soft_apu_ports+11
  640  00:A4DF  8D 0B 40      sta $400B
  641  00:A4E2            .noise:
  642  00:A4E2  AD 12 03      lda soft_apu_ports+12
  643  00:A4E5  8D 0C 40      sta $400C
  644  00:A4E8  AD 14 03      lda soft_apu_ports+14   ;there is no $400D, so we skip it
  645  00:A4EB  8D 0E 40      sta $400E
  646  00:A4EE  AD 15 03      lda soft_apu_ports+15
  647  00:A4F1  8D 0F 40      sta $400F
  648  00:A4F4  60            rts
