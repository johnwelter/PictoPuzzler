   54  00:A12E  B1 D2         lda [sound_ptr], y      ;status byte.  1= enable, 0=disable
   55  00:A130  9D 22 03      sta stream_status, x
   56  00:A133  F0 49         beq .next_stream        ;if status byte is 0, stream disabled, so we are done
   57  00:A135  C8            iny
