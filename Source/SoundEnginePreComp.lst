   45  00:A122  A0 00         ldy #$00
   46  00:A124  B1 D2         lda [sound_ptr], y      ;read the first byte: # streams
   47  00:A126  8D 03 03      sta sound_temp2         ;store in a temp variable.  We will use this as a loop counter: how many streams to read stream headers for
   48  00:A129  C8            iny
   49  00:A12A            .loop:
