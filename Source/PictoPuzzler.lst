  213  06:D403  C8                INY
  214  06:D404  CC 00 00          CPY DATA_LEN
  215  06:D407  90 F5             BCC .innerloop ;table should have the size in it, but since we count the byte count, we'll want to wait till we go over it
  216  06:D409  F0 F3             BEQ .innerloop
