    1  06:D76E            ReadControllersSafe:
    2  06:D76E  8A                TXA
    3  06:D76F  48                PHA
    4  06:D770  98                TYA
    5  06:D771  48                PHA
    6                     
    7  06:D772            .firstRead:
    8  06:D772  20 98 D7          JSR ReadControllers
    9  06:D775            .reRead:
   10  06:D775  AD 1A 00          LDA gamepad
   11  06:D778  48                PHA
   12  06:D779  20 98 D7          JSR ReadControllers
   13  06:D77C  68                PLA 
   14  06:D77D  CD 1A 00          CMP gamepad
   15  06:D780  D0 F3             BNE .reRead
   16                             
   17  06:D782            .finishARead:
   18                             ;;comapre last to current, find the pressed buttons this frame
   19  06:D782  AD 1B 00          LDA gamepadLast
   20  06:D785  49 FF             EOR #$FF
   21  06:D787  2D 1A 00          AND gamepad
   22  06:D78A  8D 1C 00          STA gamepadPressed
   23                             
   24                             
   25  06:D78D  AD 1A 00          LDA gamepad
   26  06:D790  8D 1B 00          STA gamepadLast
   27                             
   28  06:D793  68                PLA
   29  06:D794  A8                TAY
   30  06:D795  68                PLA
   31  06:D796  AA                TAX     
   32  06:D797  60                RTS
   33                             
   34  06:D798            ReadControllers:
   35                     
   36  06:D798  A9 01             LDA #$01        ;load 1
   37  06:D79A  8D 16 40          STA $4016       ; turn latch on
   38                             ;STA gamepad2
   39  06:D79D  4A                LSR     A               ; move acc it over for a 0 bit, better than loading 0 to the acc, I guess
   40  06:D79E  8D 16 40          STA $4016       ;turn latch off
   41                             
   42  06:D7A1  A9 80             LDA #$80
   43  06:D7A3  8D 1A 00          STA gamepad
   44                     
   45  06:D7A6            .readControllerABytesLoop:
   46  06:D7A6  AD 16 40          LDA $4016               ;acc: %00000001 c: 0
   47  06:D7A9  29 03             AND #%00000011  ;acc: %00000001 c: 0
   48  06:D7AB  C9 01             CMP #%00000001  ;acc: %00000001 c: 1
   49                             ;ror shifts everything right one position: carry->bit 7, bit 0-> carry
   50  06:D7AD  6E 1A 00          ROR gamepad             ;gamepad: %11000000
   51                             ;eventually, the ROR sends out the 1 instead of all the leading 0s, BCC (branch carry clear) gets the 1 and does not loop
   52  06:D7B0  90 F4             BCC .readControllerABytesLoop
   53                     
   54                             
   55                     
   56                             
   57  06:D7B2  60                RTS
