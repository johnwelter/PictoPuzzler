   24                       
   25                       
   26  06:D726  A9 00       LDA #$00        ;;tell the ppu there is no background scrolling
   27  06:D728  8D 05 20    STA PPU_SCROLL
   28  06:D72B  8D 05 20    STA PPU_SCROLL
   29                       
   30                       ; enable NMI, sprites from Pattern Table 0, background from Pattern Table 1
   31                       ; enable sprites, enable background, no clipping on left side 
   32  06:D72E  20 24 D2    JSR UpdatePPUControl
   33                     
