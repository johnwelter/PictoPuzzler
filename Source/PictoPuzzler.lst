  112                     ;--------------------------
  113                     ; sound_play_frame advances the sound engine by one frame
  114  07:E54F            sound_play_frame:
  115  07:E54F  AD 01 03      lda sound_disable_flag
  116  07:E552  D0 31         bne .done   ;if disable flag is set, don't advance a frame
  117                     
  118  07:E554  20 B1 E4      jsr se_silence  ;silence all channels.  se_set_apu will set volume later for all channels that are enabled.
  119                                         ;the purpose of this subroutine call is to silence channels that aren't used by any streams.
  120  07:E557  A2 00         ldx #$00
  121  07:E559            .loop:
  122  07:E559  BD 22 03      lda stream_status, x
  123  07:E55C  29 01         and #$01    ;check whether the stream is active
  124  07:E55E  F0 1D         beq .endloop  ;if the stream isn't active, skip it
  125                         
  126                         ;add the tempo to the ticker total.  If there is a FF-> 0 transition, there is a tick
  127  07:E560  BD 7A 03      lda stream_ticker_total, x
  128  07:E563  18            clc
  129  07:E564  7D 72 03      adc stream_tempo, x
  130  07:E567  9D 7A 03      sta stream_ticker_total, x
  131  07:E56A  90 0E         bcc .set_buffer    ;carry clear = no tick.  if no tick, we are done with this stream
  132                         
  133  07:E56C  DE 82 03      dec stream_note_length_counter, x   ;else there is a tick. decrement the note length counter
  134  07:E56F  D0 09         bne .set_buffer    ;if counter is non-zero, our note isn't finished playing yet
  135  07:E571  BD 8A 03      lda stream_note_length, x   ;else our note is finished. reload the note length counter
  136  07:E574  9D 82 03      sta stream_note_length_counter, x
  137                         
  138  07:E577  20 86 E5      jsr se_fetch_byte   ;read the next byte from the data stream
  139                         
  140  07:E57A            .set_buffer:
  141  07:E57A  20 C1 E6      jsr se_set_temp_ports   ;copy the current stream's sound data for the current frame into our temporary APU vars (soft_apu_ports)
  142  07:E57D            .endloop:
  143  07:E57D  E8            inx
  144  07:E57E  E0 08         cpx #$08
  145  07:E580  D0 D7         bne .loop
  146  07:E582  20 54 E8      jsr se_set_apu      ;copy the temporary APU variables (soft_apu_ports) to the real APU ports ($4000, $4001, etc)
  147  07:E585            .done:
  148  07:E585  60            rts
