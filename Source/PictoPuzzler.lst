  232  07:E5B0            se_do_noise:
  233                     
  234  07:E5B0  AD 15 40          lda $4015
  235  07:E5B3  29 10             AND #$10                                ;get the current DMC bytes remaining
  236  07:E5B5  09 07             ORA #$07                                ;add in the lower three bits
  237  07:E5B7  2D 00 03          AND sound_enable_flags  ;and with the current sound flags, minus noise
  238  07:E5BA  8D 00 03          sta sound_enable_flags  ;disable noise
  239  07:E5BD  8D 15 40          sta $4015
  240                     
  241  07:E5C0  AD 03 03      lda sound_temp2
  242  07:E5C3  29 20             AND #%00100000
  243  07:E5C5  D0 20             bne .leave
  244                             
  245  07:E5C7  AD 03 03          lda sound_temp2
  246  07:E5CA  29 10         and #%00010000
  247  07:E5CC  F0 08         beq .mode0
  248  07:E5CE  AD 03 03      lda sound_temp2
  249  07:E5D1  09 80         ora #%10000000      ;set bit 7 to set mode1
  250  07:E5D3  8D 03 03      sta sound_temp2
  251  07:E5D6            .mode0:
  252  07:E5D6  AD 03 03      lda sound_temp2
  253  07:E5D9  9D 62 03      sta stream_note_LO, x
  254                     
  255  07:E5DC  AD 00 03          lda sound_enable_flags
  256  07:E5DF  09 08             ORA #%00001000
  257  07:E5E1  8D 00 03          STA sound_enable_flags
  258  07:E5E4  8D 15 40          sta $4015
  259  07:E5E7            .leave:
  260  07:E5E7  60            rts
  261                             
  262  07:E5E8            se_do_dpmc:
  263  07:E5E8  8A                TXA
  264  07:E5E9  48                PHA
  265                             
  266  07:E5EA  AD 00 03          lda sound_enable_flags
  267  07:E5ED  29 0F             AND #$0F
  268  07:E5EF  8D 00 03          sta sound_enable_flags ;DPCM disable
  269  07:E5F2  8D 15 40          sta $4015
  270                             
  271  07:E5F5  AD 03 03          lda sound_temp2         ;load up sample index- we can cram in the pitch and keep ourselves to 6 samples (7 will be rest)
  272  07:E5F8  C9 70             CMP #$70
  273  07:E5FA  B0 2B             BCS .leave
  274                     
  275  07:E5FC  29 0F             AND #$0F
  276  07:E5FE  8D 10 40          sta $4010 ;pitch
  277  07:E601  A9 7F             LDA #$7F
  278  07:E603  8D 11 40          sta $4011 ;temp = starting sample level
  279  07:E606  AD 03 03          lda sound_temp2
  280  07:E609  29 F0             AND #$F0
  281  07:E60B  4A                LSR A
  282  07:E60C  4A                LSR A
  283  07:E60D  4A                LSR A
  284  07:E60E  4A                LSR A
  285  07:E60F  AA                TAX
  286  07:E610  BD 71 DC          lda SampleStart,x
  287  07:E613  8D 12 40          sta $4012 ;X = sample number
  288  07:E616  BD 73 DC          lda SampleLength,x
  289  07:E619  8D 13 40          sta $4013
  290                             
  291  07:E61C  AD 00 03          lda sound_enable_flags
  292  07:E61F  09 10             ORA #$10
  293  07:E621  8D 00 03          STA sound_enable_flags
  294  07:E624  8D 15 40          sta $4015
  295  07:E627            .leave:
  296  07:E627  68                PLA
  297  07:E628  AA                TAX
  298                     
  299  07:E629  60                rts
