  380  06:D4FC            FadeOutPalettes:
  381                     
  382                     ;;take the current values, and decrement the lower nibbles
  383                     ;;we can access from the palette copy 
  384                     ;;we'll make this fade out one level per call
  385                     ;;once all the palettes are blacked out we'll return true, so we'll keep the carry flag as a return result
  386                     
  387                     ;;go through the palette copy, decrement, make a raw data PPU string and add all the bytes into it
  388                     ;;for any palette color already in the 0x range, change it to 0f to get black
  389                     
  390                       MACROGetLabelPointer Palette_Copy, table_address
                          
       06:D4FC  A9 6C             LDA #HIGH(Palette_Copy)
       06:D4FE  A2 00             LDX #LOW(Palette_Copy)
                                  
       06:D500  8E 18 00          STX table_address
       06:D503  8D 19 00          STA table_address+1
                                  
  391                     ;;palette copy address is now X accessable
  392                     
  393  06:D506  A0 00       LDY #$00
