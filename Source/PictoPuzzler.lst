  498  07:E797            se_set_stream_pitch:
  499  07:E797  8C 02 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  500                         
  501  07:E79A  BD A0 03      lda stream_pe, x            ;which volume envelope?
  502  07:E79D  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  503  07:E79E  A8            tay
  504  07:E79F  B9 04 EE      lda kMod, y     ;get the low byte of the address from the pointer table
  505  07:E7A2  8D DF 00      sta sound_ptr               ;put it into our pointer variable
  506  07:E7A5  B9 05 EE      lda kMod+1, y   ;get the high byte of the address
  507  07:E7A8  8D E0 00      sta sound_ptr+1
  508                             
  509  07:E7AB  BD B8 03          LDA stream_pe_delay, x
  510                             ;;if not 0, decrement
  511                             ;AND #$7F                       ;check if, without minus flag, the delay is 0
  512  07:E7AE  F0 04             BEQ .read_pe
  513  07:E7B0  DE B8 03          DEC stream_pe_delay, x
  514  07:E7B3  60                RTS
  515                         
  516  07:E7B4            .read_pe:
  517  07:E7B4  BC A8 03      ldy stream_pe_index, x      ;our current position within the volume envelope.
  518  07:E7B7  B1 DF         lda [sound_ptr], y          ;grab the value.
  519  07:E7B9  C9 80         cmp #l_cLast
  520  07:E7BB  D0 06             BNE .notLoopLast
  521  07:E7BD  DE A8 03          dec stream_pe_index, x      ;else if loop last, go back one and read again
  522  07:E7C0  4C B4 E7          jmp .read_pe 
  523                     
  524  07:E7C3            .notLoopLast:
  525  07:E7C3  C9 81             cmp #l_cAll
  526  07:E7C5  D0 08             BNE .notLoopAll
  527  07:E7C7  A9 00             LDA #$00
  528  07:E7C9  9D A8 03          STA stream_pe_index, x
  529  07:E7CC  4C B4 E7          jmp .read_pe
  530                             
  531  07:E7CF            .notLoopAll:
  532  07:E7CF  C9 82             cmp #l_cPart
  533  07:E7D1  D0 0D             BNE .notLoopPart
  534  07:E7D3  C8                iny
  535  07:E7D4  BD A8 03          lda stream_pe_index, x
  536  07:E7D7  38                SEC
  537  07:E7D8  F1 DF             SBC [sound_ptr], y
  538  07:E7DA  9D A8 03          STA stream_pe_index, x
  539  07:E7DD  4C B4 E7          jmp .read_pe
  540                     
  541  07:E7E0            .notLoopPart:
  542  07:E7E0  C9 83             cmp #l_cHold
  543  07:E7E2  D0 15             BNE .notLoopDelay
  544                             ;LDA stream_pe_delay, x
  545                             ;BMI .delayUsed ;negative, delay was already used this time
  546  07:E7E4  C8                iny
  547  07:E7E5  B1 DF             lda [sound_ptr], y
  548                             ;ORA #$80
  549  07:E7E7  9D B8 03          STA stream_pe_delay, x
  550  07:E7EA  FE A8 03          inc stream_pe_index, x
  551  07:E7ED  4C 36 E8          jmp .finish_pitchShift
  552  07:E7F0            .delayUsed:
  553  07:E7F0  FE A8 03          inc stream_pe_index, x
  554  07:E7F3  FE A8 03          inc stream_pe_index, x
  555  07:E7F6  4C B4 E7          jmp .read_pe
  556                             
  557  07:E7F9            .notLoopDelay:
  558  07:E7F9            .set_pitch:
  559                     
  560  07:E7F9  9D B0 03      sta stream_pe_offset, x      ;get current vol/duty settings
  561  07:E7FC  8D 03 03          STA sound_temp2
  562  07:E7FF  AC 02 03          LDY sound_temp1
  563  07:E802  AD 03 03          LDA sound_temp2
  564  07:E805  10 1D             BPL .add_pitch
  565                             
  566  07:E807            .sub_pitch:
  567                             
  568  07:E807  49 FF             EOR #$FF        ;flip bits
  569  07:E809  18                CLC
  570  07:E80A  69 01             ADC #$01        ;add one - two's compliment
  571  07:E80C  8D 03 03          STA sound_temp2
  572                             
  573  07:E80F  B9 08 03          LDA soft_apu_ports+2, y       
  574  07:E812  38                SEC
  575  07:E813  ED 03 03          SBC sound_temp2
  576  07:E816  99 08 03          STA soft_apu_ports+2, y
  577  07:E819  B9 09 03          LDA soft_apu_ports+3, y
  578  07:E81C  E9 00             SBC #$00
  579  07:E81E  99 09 03          STA soft_apu_ports+3, y
  580                             
  581  07:E821  4C 36 E8          JMP .finish_pitchShift
  582                     
  583  07:E824            .add_pitch:
  584                     
