   24                       
   25                       
   26  06:DA54  A9 00       LDA #$00        ;;tell the ppu there is no background scrolling
   27  06:DA56  8D 05 20    STA PPU_SCROLL
   28  06:DA59  8D 05 20    STA PPU_SCROLL
   29                       
   30                       ; enable NMI, sprites from Pattern Table 0, background from Pattern Table 1
   31                       ; enable sprites, enable background, no clipping on left side 
   32  06:DA5C  20 D6 D2    JSR UpdatePPUControl
