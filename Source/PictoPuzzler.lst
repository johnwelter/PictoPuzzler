  227  06:D417            .loop:
  228  06:D417  B1 18       LDA [table_address], y; load data from address (sprites +  x)
  229  06:D419  99 00 02    STA SPRITE_DATA, y    ; store into RAM address ($0200 + x)
  230  06:D41C  C8          INY                   ; X = X + 1
  231  06:D41D  CC 00 00    CPY DATA_LEN             ; Compare X to hex $10, decimal 16
  232  06:D420  D0 F5       BNE .loop   ; Branch to LoadSpritesLoop if compare was Not Equal to zero
  233                                             ; if compare was equal to 16, keep going down   
  234  06:D422  60          RTS
