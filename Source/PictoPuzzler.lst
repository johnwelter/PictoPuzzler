   13  06:DDE0  A9 02       LDA #$02
   14  06:DDE2  8D 14 40    STA OAM_HI       ; set the high byte (02) of the RAM address, start the transfer
   15                     
   16  06:DDE5  AD 12 00    LDA NMI_locks
