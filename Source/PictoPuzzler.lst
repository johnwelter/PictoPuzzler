#[2]   Source/Routines/Common/NMI.asm
#[3]   Source/Routines/Common/ReadControllers.asm
   76                       .include "Source/Routines/Common/ReadControllers.asm"
    1  06:DCA3            ReadControllersSafe:
    2  06:DCA3  8A                TXA
    3  06:DCA4  48                PHA
    4  06:DCA5  98                TYA
    5  06:DCA6  48                PHA
    6                     
    7  06:DCA7            .firstRead:
    8  06:DCA7  20 CD DC          JSR ReadControllers
    9  06:DCAA            .reRead:
   10  06:DCAA  AD 24 00          LDA gamepad
   11  06:DCAD  48                PHA
   12  06:DCAE  20 CD DC          JSR ReadControllers
   13  06:DCB1  68                PLA 
   14  06:DCB2  CD 24 00          CMP gamepad
   15  06:DCB5  D0 F3             BNE .reRead
   16                             
   17  06:DCB7            .finishARead:
   18                             ;;comapre last to current, find the pressed buttons this frame
   19  06:DCB7  AD 25 00          LDA gamepadLast
   20  06:DCBA  49 FF             EOR #$FF
   21  06:DCBC  2D 24 00          AND gamepad
   22  06:DCBF  8D 26 00          STA gamepadPressed
   23                             
   24                             
   25  06:DCC2  AD 24 00          LDA gamepad
   26  06:DCC5  8D 25 00          STA gamepadLast
   27                             
   28  06:DCC8  68                PLA
   29  06:DCC9  A8                TAY
   30  06:DCCA  68                PLA
   31  06:DCCB  AA                TAX     
   32  06:DCCC  60                RTS
   33                             
   34  06:DCCD            ReadControllers:
   35                     
   36  06:DCCD  A9 01             LDA #$01        ;load 1
   37  06:DCCF  8D 16 40          STA $4016       ; turn latch on
   38                             ;STA gamepad2
   39  06:DCD2  4A                LSR     A               ; move acc it over for a 0 bit, better than loading 0 to the acc, I guess
   40  06:DCD3  8D 16 40          STA $4016       ;turn latch off
   41                             
   42  06:DCD6  A9 80             LDA #$80
   43  06:DCD8  8D 24 00          STA gamepad
   44                     
   45  06:DCDB            .readControllerABytesLoop:
   46  06:DCDB  AD 16 40          LDA $4016               ;acc: %00000001 c: 0
   47  06:DCDE  29 03             AND #%00000011  ;acc: %00000001 c: 0
   48  06:DCE0  C9 01             CMP #%00000001  ;acc: %00000001 c: 1
   49                             ;ror shifts everything right one position: carry->bit 7, bit 0-> carry
   50  06:DCE2  6E 24 00          ROR gamepad             ;gamepad: %11000000
   51                             ;eventually, the ROR sends out the 1 instead of all the leading 0s, BCC (branch carry clear) gets the 1 and does not loop
   52  06:DCE5  90 F4             BCC .readControllerABytesLoop
   53                     
   54                             
   55                     
   56                             
   57  06:DCE7  60                RTS
