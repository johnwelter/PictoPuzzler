   43  06:D718  AA                TAX
   44  06:D719  A9 A0             LDA #CHRBANK1
   45  06:D71B  8D B0 00          STA mapper_address+1
   46  06:D71E  8A                TXA
   47  06:D71F  20 2E D7          JSR SendMapperCommand
   48  06:D722  60                RTS
   49                             
   50  06:D723            LoadCHRBankB:
   51                             ;;A is the desired CHR bank
   52  06:D723  AA                TAX
   53  06:D724  A9 C0             LDA #CHRBANK2
   54  06:D726  8D B0 00          STA mapper_address+1
   55  06:D729  8A                TXA
   56  06:D72A  20 2E D7          JSR SendMapperCommand
   57  06:D72D  60                RTS
   58                             
