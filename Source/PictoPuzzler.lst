  143                             
  144  06:D3FE            .checkRepeat:
  145  06:D3FE  AD 01 00    LDA WRITE_SETTINGS
  146  06:D401  29 40       AND #%01000000
  147  06:D403  F0 19       BEQ .checkTable
  148                       
  149  06:D405  AD 01 00    LDA WRITE_SETTINGS
  150  06:D408  29 3F       AND #$3F
  151  06:D40A  8D 00 00    STA DATA_LEN
  152                       ;;the usual data length byte is now the repeatable byte
  153  06:D40D  A2 00       LDX #$00
  154                       
  155  06:D40F            .repeatLoop:
  156  06:D40F  B1 14       LDA [pointer_address], y
  157  06:D411  8D 07 20    STA PPU_DATA
  158  06:D414  E8          INX 
  159  06:D415  EC 00 00    CPX DATA_LEN
  160  06:D418  D0 F5       BNE .repeatLoop
  161  06:D41A  C8          INY
  162  06:D41B  4C D2 D3    JMP .outerloop
  163                             
  164  06:D41E            .checkTable:
  165  06:D41E  AD 01 00          LDA WRITE_SETTINGS
  166  06:D421  29 20             AND #%00100000
  167  06:D423  F0 16             BEQ .rawData
  168                             
  169  06:D425  B1 14             LDA [pointer_address], y
  170  06:D427  8D 18 00          STA table_address
  171  06:D42A  C8                INY 
  172  06:D42B  B1 14             LDA [pointer_address], y
  173  06:D42D  8D 19 00          STA table_address + 1
  174  06:D430  C8                INY
  175  06:D431  98                TYA 
  176  06:D432  48                PHA
  177  06:D433  20 56 D4          JSR WriteToPPUFromTable
  178  06:D436  68                PLA
  179  06:D437  A8                TAY
  180  06:D438  4C D2 D3          JMP .outerloop
