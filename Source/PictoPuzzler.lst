       07:E417  60        
   44  07:E418  9B FF 00          .db $9B,$FF,$00,$A4
       07:E41B  A4        
   45  07:E41C  9B FF 00          .db $9B,$FF,$00,$AC
       07:E41F  AC        
   46  07:E420  A3 FF 00          .db $A3,$FF,$00,$A4
       07:E423  A4        
   47  07:E424  A3 FF 00          .db $A3,$FF,$00,$AC
       07:E427  AC        
