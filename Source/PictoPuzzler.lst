    1           0080      MAPPERCONTROL = $80
    2           00A0      CHRBANK1 = $A0
    3           00C0      CHRBANK2 = $C0
    4           00E0      PRGBANK = $E0
    5                     
    6  06:D566            ResetMapper:
    7  06:D566  EE 66 D5    inc ResetMapper
    8  06:D569  60          RTS
    9                       
   10                     ;;now, set up the controls for the mapper
   11                     ;;4bit0
   12                     ;;-----
   13                     ;;CPPMM
   14                     ;;|||||
   15                     ;;|||++- Mirroring (0: one-screen, lower bank; 1: one-screen, upper bank;
   16                     ;;|||               2: vertical; 3: horizontal)
   17                     ;;|++--- PRG ROM bank mode (0, 1: switch 32 KB at $8000, ignoring low bit of bank number;
   18                     ;;|                         2: fix first bank at $8000 and switch 16 KB bank at $C000;
   19                     ;;|                         3: fix last bank at $C000 and switch 16 KB bank at $8000)
   20                     ;;+----- CHR ROM bank mode (0: switch 8 KB at a time; 1: switch two separate 4 KB banks)
   21                        
   22  06:D56A            SetMapperControls:
   23                       ;;A = controls
   24  06:D56A  AA          TAX
   25  06:D56B  A9 80       LDA #MAPPERCONTROL
   26  06:D56D  8D B0 00    STA mapper_address+1
   27  06:D570  8A          TXA
   28  06:D571  20 96 D5    JSR SendMapperCommand
   29  06:D574  60          RTS
   30                     
   31  06:D575            LoadPRGBank:
   32                     
   33                             ;;A is the desired PRG number
   34  06:D575  AA                TAX
   35  06:D576  A9 E0             LDA #PRGBANK
   36  06:D578  8D B0 00          STA mapper_address+1
   37  06:D57B  8A                TXA
   38  06:D57C  20 96 D5          JSR SendMapperCommand
   39  06:D57F  60                RTS
   40                             
   41  06:D580            LoadCHRBankA:
   42                             ;;A is the desired CHR bank
   43  06:D580  AA                TAX
   44  06:D581  A9 A0             LDA #CHRBANK1
   45  06:D583  8D B0 00          STA mapper_address+1
   46  06:D586  8A                TXA
   47  06:D587  20 96 D5          JSR SendMapperCommand
   48  06:D58A  60                RTS
   49                             
   50  06:D58B            LoadCHRBankB:
   51                             ;;A is the desired CHR bank
   52  06:D58B  AA                TAX
   53  06:D58C  A9 C0             LDA #CHRBANK2
   54  06:D58E  8D B0 00          STA mapper_address+1
   55  06:D591  8A                TXA
   56  06:D592  20 96 D5          JSR SendMapperCommand
   57  06:D595  60                RTS
   58                             
   59  06:D596            SendMapperCommand:
   60                     
   61  06:D596  A0 00             LDY #$00
   62                             
   63  06:D598  91 AF             STA [mapper_address], y
   64  06:D59A  4A                LSR A
   65  06:D59B  91 AF             STA [mapper_address], y
   66  06:D59D  4A                LSR A
   67  06:D59E  91 AF             STA [mapper_address], y
   68  06:D5A0  4A                LSR A 
   69  06:D5A1  91 AF             STA [mapper_address], y
   70  06:D5A3  4A                LSR A
   71  06:D5A4  91 AF             STA [mapper_address], y
   72                             
   73  06:D5A6  60                RTS
   74                             
   75  06:D5A7            ResetBanks:
   76                     
   77  06:D5A7  20 66 D5          JSR ResetMapper
   78  06:D5AA  A9 00             LDA #$00
   79  06:D5AC  20 75 D5          JSR LoadPRGBank
   80                       
   81                             ;;as a test, load up the initial CHR banks
   82  06:D5AF  20 66 D5          JSR ResetMapper
   83  06:D5B2  A9 00             LDA #$00
   84  06:D5B4  20 80 D5          JSR LoadCHRBankA
   85  06:D5B7  A9 01             LDA #$01
   86  06:D5B9  20 8B D5          JSR LoadCHRBankB
   87  06:D5BC  60                RTS
