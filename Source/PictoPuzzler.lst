  219  06:D46C            LoadSprites_impl:
  220                       ;;A will be the amount of sprites to load
  221  06:D46C  8D 00 00    STA DATA_LEN
  222  06:D46F  0E 00 00    ASL DATA_LEN
  223  06:D472  0E 00 00    ASL DATA_LEN
  224                       
  225  06:D475  A0 00       LDY #$00              ; start at 0
  226                       
  227  06:D477            .loop:
  228  06:D477  B1 18       LDA [table_address], y; load data from address (sprites +  x)
  229  06:D479  99 00 02    STA SPRITE_DATA, y    ; store into RAM address ($0200 + x)
  230  06:D47C  C8          INY                   ; X = X + 1
  231  06:D47D  CC 00 00    CPY DATA_LEN             ; Compare X to hex $10, decimal 16
  232  06:D480  D0 F5       BNE .loop   ; Branch to LoadSpritesLoop if compare was Not Equal to zero
  233                                             ; if compare was equal to 16, keep going down   
  234  06:D482  60          RTS
