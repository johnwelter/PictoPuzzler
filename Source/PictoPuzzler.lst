  232  07:E616            se_do_noise:
  233                     
  234  07:E616  AD 15 40          lda $4015
  235  07:E619  29 10             AND #$10                                ;get the current DMC bytes remaining
  236  07:E61B  09 07             ORA #$07                                ;add in the lower three bits
  237  07:E61D  2D 00 03          AND sound_enable_flags  ;and with the current sound flags, minus noise
  238  07:E620  8D 00 03          sta sound_enable_flags  ;disable noise
  239  07:E623  8D 15 40          sta $4015
  240                     
  241  07:E626  AD 03 03      lda sound_temp2
  242  07:E629  29 20             AND #%00100000
  243  07:E62B  D0 20             bne .leave
  244                             
  245  07:E62D  AD 03 03          lda sound_temp2
  246  07:E630  29 10         and #%00010000
  247  07:E632  F0 08         beq .mode0
  248  07:E634  AD 03 03      lda sound_temp2
  249  07:E637  09 80         ora #%10000000      ;set bit 7 to set mode1
  250  07:E639  8D 03 03      sta sound_temp2
  251  07:E63C            .mode0:
  252  07:E63C  AD 03 03      lda sound_temp2
  253  07:E63F  9D 62 03      sta stream_note_LO, x
  254                     
  255  07:E642  AD 00 03          lda sound_enable_flags
  256  07:E645  09 08             ORA #%00001000
  257  07:E647  8D 00 03          STA sound_enable_flags
  258  07:E64A  8D 15 40          sta $4015
  259  07:E64D            .leave:
  260  07:E64D  60            rts
  261                             
  262  07:E64E            se_do_dpmc:
  263  07:E64E  8A                TXA
  264  07:E64F  48                PHA
  265                             
  266  07:E650  AD 00 03          lda sound_enable_flags
  267  07:E653  29 0F             AND #$0F
  268  07:E655  8D 00 03          sta sound_enable_flags ;DPCM disable
  269  07:E658  8D 15 40          sta $4015
  270                             
  271  07:E65B  AD 03 03          lda sound_temp2         ;load up sample index- we can cram in the pitch and keep ourselves to 6 samples (7 will be rest)
  272  07:E65E  C9 70             CMP #$70
  273  07:E660  B0 2B             BCS .leave
  274                     
  275  07:E662  29 0F             AND #$0F
  276  07:E664  8D 10 40          sta $4010 ;pitch
  277  07:E667  A9 7F             LDA #$7F
  278  07:E669  8D 11 40          sta $4011 ;temp = starting sample level
  279  07:E66C  AD 03 03          lda sound_temp2
  280  07:E66F  29 F0             AND #$F0
  281  07:E671  4A                LSR A
  282  07:E672  4A                LSR A
  283  07:E673  4A                LSR A
  284  07:E674  4A                LSR A
  285  07:E675  AA                TAX
  286  07:E676  BD 31 C0          lda SampleStart,x
  287  07:E679  8D 12 40          sta $4012 ;X = sample number
  288  07:E67C  BD 33 C0          lda SampleLength,x
  289  07:E67F  8D 13 40          sta $4013
  290                             
  291  07:E682  AD 00 03          lda sound_enable_flags
  292  07:E685  09 10             ORA #$10
  293  07:E687  8D 00 03          STA sound_enable_flags
  294  07:E68A  8D 15 40          sta $4015
  295  07:E68D            .leave:
  296  07:E68D  68                PLA
  297  07:E68E  AA                TAX
  298                     
  299  07:E68F  60                rts
  300                             
  301                     ;--------------------------------------------------
  302                     ; se_check_rest will read a byte from the data stream and
  303                     ;       determine if it is a rest or not.  It will set or clear the current
  304                     ;       stream's rest flag accordingly.
  305                     ;       input:
  306                     ;           X: stream number
  307                     ;           Y: data stream index
  308  07:E690            se_check_rest:
  309  07:E690  B1 DF         lda [sound_ptr], y  ;read the note byte again
  310  07:E692  C9 5E         cmp #rest
  311  07:E694  D0 07         bne .not_rest
  312  07:E696  BD 22 03      lda stream_status, x
  313  07:E699  09 02         ora #%00000010  ;set the rest bit in the status byte
  314  07:E69B  D0 05         bne .store  ;this will always branch.  bne is cheaper than a jmp.
  315  07:E69D            .not_rest:
  316  07:E69D  BD 22 03      lda stream_status, x
  317  07:E6A0  29 FD         and #%11111101  ;clear the rest bit in the status byte
  318  07:E6A2            .store:
  319  07:E6A2  9D 22 03      sta stream_status, x
  320  07:E6A5  60            rts
  321                         
  322                     ;-----------------------------------------
  323                     ; se_opcode_launcher will read an address from the opcode jump table and indirect jump there.
  324                     ;    input: A: opcode byte
  325                     ;               Y: data stream position
  326                     ;               X: stream number
  327  07:E6A6            se_opcode_launcher:
  328  07:E6A6  8C 02 03      sty sound_temp1         ;save y register, because we are about to destroy it
  329  07:E6A9  38            sec
  330  07:E6AA  E9 A0         sbc #$A0                ;turn our opcode byte into a table index by subtracting $A0
  331  07:E6AC  0A            asl a                   ;multiply by 2 because we index into a table of addresses (words)
  332  07:E6AD  A8            tay
  333  07:E6AE  B9 1E EB      lda sound_opcodes, y    ;get low byte of subroutine address
  334  07:E6B1  8D E1 00      sta sound_ptr2
  335  07:E6B4  B9 1F EB      lda sound_opcodes+1, y  ;get high byte
  336  07:E6B7  8D E2 00      sta sound_ptr2+1
  337  07:E6BA  AC 02 03      ldy sound_temp1         ;restore our y register
  338  07:E6BD  C8            iny                     ;set to next position in data stream (assume an argument)
  339  07:E6BE  6C E1 00      jmp [sound_ptr2]           ;indirect jump to our opcode subroutine    
  340                         
  341                     ;----------------------------------------------------
  342                     ; se_set_temp_ports will copy a stream's sound data to the temporary apu variables
  343                     ;      input:
  344                     ;           X: stream number
  345  07:E6C1            se_set_temp_ports:
  346                     
  347  07:E6C1  E0 06             cpx #MUSIC_DPMC
  348  07:E6C3  90 01             bcc .contTempPorts
  349  07:E6C5  60                rts
  350  07:E6C6            .contTempPorts:
  351  07:E6C6  BD 2A 03      lda stream_channel, x
  352  07:E6C9  0A            asl a
  353  07:E6CA  0A            asl a
  354  07:E6CB  A8            tay
  355                         
  356  07:E6CC  20 EF E6      jsr se_set_stream_volume
  357                             
  358                         
  359  07:E6CF  A9 08         lda #$08
  360  07:E6D1  99 07 03      sta soft_apu_ports+1, y     ;sweep
  361                         
  362                             
  363  07:E6D4  BD C0 03          LDA stream_arp, x
  364  07:E6D7  F0 06             BEQ .updatePitch
  365                             
  366  07:E6D9  20 4B E7          JSR se_set_stream_arpeggio
  367  07:E6DC  4C EE E6          JMP .leaveTempSet
  368                             
  369  07:E6DF            .updatePitch:
  370  07:E6DF  BD 62 03      lda stream_note_LO, x
  371  07:E6E2  99 08 03      sta soft_apu_ports+2, y     ;period LO
  372                         
  373  07:E6E5  BD 6A 03      lda stream_note_HI, x
  374  07:E6E8  99 09 03      sta soft_apu_ports+3, y     ;period HI
  375                             
  376                     
  377  07:E6EB  20 A5 E7          jsr se_set_stream_pitch
  378                     
  379  07:E6EE            .leaveTempSet:
  380  07:E6EE  60            rts    
  381                     
  382                     ;----------------------------------
  383                     ;    
  384  07:E6EF            se_set_stream_volume:
  385                             
  386  07:E6EF  8C 02 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  387                         
  388  07:E6F2  BD 42 03      lda stream_ve, x            ;which volume envelope?
  389  07:E6F5  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  390  07:E6F6  A8            tay
  391  07:E6F7  B9 AB EC      lda kVol, y     ;get the low byte of the address from the pointer table
  392  07:E6FA  8D DF 00      sta sound_ptr               ;put it into our pointer variable
  393  07:E6FD  B9 AC EC      lda kVol+1, y   ;get the high byte of the address
  394  07:E700  8D E0 00      sta sound_ptr+1
  395                         
  396  07:E703            .read_ve:
  397  07:E703  BC 4A 03      ldy stream_ve_index, x      ;our current position within the volume envelope.
  398  07:E706  B1 DF         lda [sound_ptr], y          ;grab the value.
  399  07:E708  C9 FF         cmp #$FF
  400  07:E70A  D0 06         bne .set_vol                ;if not FF, set the volume
  401  07:E70C  DE 4A 03      dec stream_ve_index, x      ;else if FF, go back one and read again
  402  07:E70F  4C 03 E7      jmp .read_ve                ;  FF essentially tells us to repeat the last
  403                                                     ;  volume value for the remainder of the note
  404  07:E712            .set_vol:
  405  07:E712  8D 03 03      sta sound_temp2             ;save our new volume value (about to destroy A)
  406                         
  407  07:E715  E0 02         cpx #TRIANGLE               
  408  07:E717  D0 09         bne .squares                ;if not triangle channel, go ahead
  409  07:E719  AD 03 03      lda sound_temp2
  410  07:E71C  D0 04         bne .squares                ;else if volume not zero, go ahead (treat same as squares)
  411  07:E71E  A9 80         lda #$80
  412  07:E720  30 08         bmi .store_vol              ;else silence the channel with #$80
  413  07:E722            .squares:
  414  07:E722  BD 52 03      lda stream_vol_duty, x      ;get current vol/duty settings
  415  07:E725  29 F0         and #$F0                    ;zero out the old volume
  416  07:E727  0D 03 03      ora sound_temp2             ;OR our new volume in.
  417                     
  418  07:E72A            .store_vol:
  419  07:E72A  AC 02 03      ldy sound_temp1             ;get our index into soft_apu_ports
  420  07:E72D  99 06 03      sta soft_apu_ports, y       ;store the volume in our temp port
  421  07:E730  FE 4A 03      inc stream_ve_index, x      ;set our volume envelop index to the next position
  422                     
  423  07:E733            .rest_check:
  424                         ;check the rest flag. if set, overwrite volume with silence value 
  425  07:E733  BD 22 03      lda stream_status, x
  426  07:E736  29 02         and #%00000010
  427  07:E738  F0 10         beq .done                   ;if clear, no rest, so quit
  428  07:E73A  BD 2A 03      lda stream_channel, x
  429  07:E73D  C9 02         cmp #TRIANGLE               ;if triangle, silence with #$80
  430  07:E73F  F0 04         beq .tri                    ;else, silence with #$30
  431  07:E741  A9 30         lda #$30        
  432  07:E743  D0 02         bne .store                  ;this always branches.  bne is cheaper than a jmp
  433  07:E745            .tri:
  434  07:E745  A9 80         lda #$80
  435  07:E747            .store:    
  436  07:E747  99 06 03      sta soft_apu_ports, y
  437  07:E74A            .done:
  438  07:E74A  60            rts   
  439                             
  440                     ;---------------------------------------
  441                     ;
  442  07:E74B            se_set_stream_arpeggio:
  443                         
  444  07:E74B  BD 22 03          lda stream_status, x
  445  07:E74E  29 02         and #%00000010
  446  07:E750  F0 01             beq .continue
  447  07:E752  60                rts
  448                             
  449  07:E753            .continue:
  450  07:E753  8C 02 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  451                         
  452  07:E756  BD C0 03      lda stream_arp, x            ;which volume envelope?
  453  07:E759  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  454  07:E75A  A8            tay
  455  07:E75B  B9 5F EE      lda kArp, y     ;get the low byte of the address from the pointer table
  456  07:E75E  8D DF 00      sta sound_ptr               ;put it into our pointer variable
  457  07:E761  B9 60 EE      lda kArp+1, y   ;get the high byte of the address
  458  07:E764  8D E0 00      sta sound_ptr+1
  459                         
  460  07:E767            .read_arp:
  461  07:E767  BC C8 03      ldy stream_arp_index, x      ;our current position within the volume envelope.
  462  07:E76A  B1 DF         lda [sound_ptr], y          ;grab the value.
  463  07:E76C  C9 81         cmp #$81
  464  07:E76E  D0 08         bne .set_arp                ;if not 80, set the volume
  465  07:E770  A9 00             LDA #$00
  466  07:E772  9D C8 03      STA stream_arp_index, x      ;else if 80, go back one to start
  467  07:E775  4C 67 E7      jmp .read_arp                ;  FF essentially tells us to repeat the last
  468                                                     ;  volume value for the remainder of the note
  469  07:E778            .set_arp:
  470  07:E778  8D 03 03      STA sound_temp2             ;save our new volume value (about to destroy A)
  471  07:E77B  BD 5A 03          LDA stream_note_idx, x          ;note indexes are premultiplied, un mult for an easier add
  472  07:E77E  4A                LSR A                           
  473  07:E77F  18                CLC
  474  07:E780  6D 03 03          ADC sound_temp2
  475  07:E783  8D 03 03          STA sound_temp2
  476                             
  477                             
  478  07:E786  AC 02 03          LDY sound_temp1
  479  07:E789  8E 02 03          STX sound_temp1
  480  07:E78C  0A                ASL A
  481  07:E78D  AA                TAX 
  482                     
  483  07:E78E  BD D1 EB          LDA note_table, x
  484  07:E791  99 08 03          STA soft_apu_ports+2, y
  485  07:E794  BD D2 EB          LDA note_table+1, x
  486  07:E797  99 09 03          STA soft_apu_ports+3, y
  487                             
  488  07:E79A  AE 02 03          LDX sound_temp1
  489                             
  490  07:E79D  FE C8 03      inc stream_arp_index, x      ;set our volume envelop index to the next position
  491                             
  492  07:E7A0  98                TYA
  493  07:E7A1  8D 02 03          STA sound_temp1
  494                     
  495  07:E7A4  60            rts 
  496                     ;--------------------------------------
  497                     ;
  498  07:E7A5            se_set_stream_pitch:
  499  07:E7A5  8C 02 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  500                         
  501  07:E7A8  BD A0 03      lda stream_pe, x            ;which volume envelope?
  502  07:E7AB  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  503  07:E7AC  A8            tay
  504  07:E7AD  B9 12 EE      lda kMod, y     ;get the low byte of the address from the pointer table
  505  07:E7B0  8D DF 00      sta sound_ptr               ;put it into our pointer variable
  506  07:E7B3  B9 13 EE      lda kMod+1, y   ;get the high byte of the address
  507  07:E7B6  8D E0 00      sta sound_ptr+1
  508                             
  509  07:E7B9  BD B8 03          LDA stream_pe_delay, x
  510                             ;;if not 0, decrement
  511                             ;AND #$7F                       ;check if, without minus flag, the delay is 0
  512  07:E7BC  F0 04             BEQ .read_pe
  513  07:E7BE  DE B8 03          DEC stream_pe_delay, x
  514  07:E7C1  60                RTS
  515                         
  516  07:E7C2            .read_pe:
  517  07:E7C2  BC A8 03      ldy stream_pe_index, x      ;our current position within the volume envelope.
  518  07:E7C5  B1 DF         lda [sound_ptr], y          ;grab the value.
  519  07:E7C7  C9 80         cmp #l_cLast
  520  07:E7C9  D0 06             BNE .notLoopLast
  521  07:E7CB  DE A8 03          dec stream_pe_index, x      ;else if loop last, go back one and read again
  522  07:E7CE  4C C2 E7          jmp .read_pe 
  523                     
  524  07:E7D1            .notLoopLast:
  525  07:E7D1  C9 81             cmp #l_cAll
  526  07:E7D3  D0 08             BNE .notLoopAll
  527  07:E7D5  A9 00             LDA #$00
  528  07:E7D7  9D A8 03          STA stream_pe_index, x
  529  07:E7DA  4C C2 E7          jmp .read_pe
  530                             
  531  07:E7DD            .notLoopAll:
  532  07:E7DD  C9 82             cmp #l_cPart
  533  07:E7DF  D0 0D             BNE .notLoopPart
  534  07:E7E1  C8                iny
  535  07:E7E2  BD A8 03          lda stream_pe_index, x
  536  07:E7E5  38                SEC
  537  07:E7E6  F1 DF             SBC [sound_ptr], y
  538  07:E7E8  9D A8 03          STA stream_pe_index, x
  539  07:E7EB  4C C2 E7          jmp .read_pe
  540                     
  541  07:E7EE            .notLoopPart:
  542  07:E7EE  C9 83             cmp #l_cHold
  543  07:E7F0  D0 15             BNE .notLoopDelay
  544                             ;LDA stream_pe_delay, x
  545                             ;BMI .delayUsed ;negative, delay was already used this time
  546  07:E7F2  C8                iny
  547  07:E7F3  B1 DF             lda [sound_ptr], y
  548                             ;ORA #$80
  549  07:E7F5  9D B8 03          STA stream_pe_delay, x
  550  07:E7F8  FE A8 03          inc stream_pe_index, x
  551  07:E7FB  4C 44 E8          jmp .finish_pitchShift
  552  07:E7FE            .delayUsed:
  553  07:E7FE  FE A8 03          inc stream_pe_index, x
  554  07:E801  FE A8 03          inc stream_pe_index, x
  555  07:E804  4C C2 E7          jmp .read_pe
  556                             
  557  07:E807            .notLoopDelay:
  558  07:E807            .set_pitch:
  559                     
  560  07:E807  9D B0 03      sta stream_pe_offset, x      ;get current vol/duty settings
  561  07:E80A  8D 03 03          STA sound_temp2
  562  07:E80D  AC 02 03          LDY sound_temp1
  563  07:E810  AD 03 03          LDA sound_temp2
  564  07:E813  10 1D             BPL .add_pitch
  565                             
  566  07:E815            .sub_pitch:
  567                             
  568  07:E815  49 FF             EOR #$FF        ;flip bits
  569  07:E817  18                CLC
  570  07:E818  69 01             ADC #$01        ;add one - two's compliment
  571  07:E81A  8D 03 03          STA sound_temp2
  572                             
  573  07:E81D  B9 08 03          LDA soft_apu_ports+2, y       
  574  07:E820  38                SEC
  575  07:E821  ED 03 03          SBC sound_temp2
  576  07:E824  99 08 03          STA soft_apu_ports+2, y
  577  07:E827  B9 09 03          LDA soft_apu_ports+3, y
  578  07:E82A  E9 00             SBC #$00
  579  07:E82C  99 09 03          STA soft_apu_ports+3, y
  580                             
  581  07:E82F  4C 44 E8          JMP .finish_pitchShift
  582                     
  583  07:E832            .add_pitch:
  584                     
  585  07:E832  B9 08 03      LDA soft_apu_ports+2, y       
  586  07:E835  18                CLC
  587  07:E836  6D 03 03          ADC sound_temp2
  588  07:E839  99 08 03          STA soft_apu_ports+2, y
  589  07:E83C  B9 09 03          LDA soft_apu_ports+3, y
  590  07:E83F  69 00             ADC #$00
  591  07:E841  99 09 03          STA soft_apu_ports+3, y
  592                             
  593  07:E844            .finish_pitchShift:
  594  07:E844  FE A8 03      inc stream_pe_index, x      ;set our volume envelop index to the next position
  595                     
  596  07:E847            .rest_check:
  597                         ;check the rest flag. if set, overwrite volume with silence value 
  598  07:E847  BD 22 03      lda stream_status, x
  599  07:E84A  29 02         and #%00000010
  600  07:E84C  F0 05         beq .done                   ;if clear, no rest, so quit
  601                        
  602  07:E84E  A9 00         LDA #$00
  603  07:E850  9D B0 03          STA stream_pe_offset, x
  604  07:E853            .done:
  605  07:E853  60            rts    
  606                     
  607                     ;--------------------------
  608                     ; se_set_apu copies the temporary RAM ports to the APU ports
  609  07:E854            se_set_apu:
  610  07:E854            .square1:
  611  07:E854  AD 06 03      lda soft_apu_ports+0
  612  07:E857  8D 00 40      sta $4000
  613  07:E85A  AD 07 03      lda soft_apu_ports+1
  614  07:E85D  8D 01 40      sta $4001
  615  07:E860  AD 08 03      lda soft_apu_ports+2
  616  07:E863  8D 02 40      sta $4002
  617  07:E866  AD 09 03      lda soft_apu_ports+3
  618  07:E869  CD 04 03      cmp sound_sq1_old       ;compare to last write
  619  07:E86C  F0 06         beq .square2            ;don't write this frame if they were equal
  620  07:E86E  8D 03 40      sta $4003
  621  07:E871  8D 04 03      sta sound_sq1_old       ;save the value we just wrote to $4003
  622  07:E874            .square2:
  623  07:E874  AD 0A 03      lda soft_apu_ports+4
  624  07:E877  8D 04 40      sta $4004
  625  07:E87A  AD 0B 03      lda soft_apu_ports+5
  626  07:E87D  8D 05 40      sta $4005
  627  07:E880  AD 0C 03      lda soft_apu_ports+6
  628  07:E883  8D 06 40      sta $4006
  629  07:E886  AD 0D 03      lda soft_apu_ports+7
  630  07:E889  CD 05 03      cmp sound_sq2_old
  631  07:E88C  F0 06         beq .triangle
  632  07:E88E  8D 07 40      sta $4007
  633  07:E891  8D 05 03      sta sound_sq2_old       ;save the value we just wrote to $4007
  634  07:E894            .triangle:
  635  07:E894  AD 0E 03      lda soft_apu_ports+8
  636  07:E897  8D 08 40      sta $4008
  637  07:E89A  AD 10 03      lda soft_apu_ports+10   ;there is no $4009, so we skip it
  638  07:E89D  8D 0A 40      sta $400A
  639  07:E8A0  AD 11 03      lda soft_apu_ports+11
  640  07:E8A3  8D 0B 40      sta $400B
  641  07:E8A6            .noise:
  642  07:E8A6  AD 12 03      lda soft_apu_ports+12
  643  07:E8A9  8D 0C 40      sta $400C
  644  07:E8AC  AD 14 03      lda soft_apu_ports+14   ;there is no $400D, so we skip it
  645  07:E8AF  8D 0E 40      sta $400E
  646  07:E8B2  AD 15 03      lda soft_apu_ports+15
  647  07:E8B5  8D 0F 40      sta $400F
  648  07:E8B8  60            rts
