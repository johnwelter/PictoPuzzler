    1           0080      MAPPERCONTROL = $80
    2           00A0      CHRBANK1 = $A0
    3           00C0      CHRBANK2 = $C0
    4           00E0      PRGBANK = $E0
    5                     
    6  06:D2B1            ResetMapper:
    7  06:D2B1  EE B1 D2    inc ResetMapper
    8  06:D2B4  60          RTS
    9                       
   10                     ;;now, set up the controls for the mapper
   11                     ;;4bit0
   12                     ;;-----
   13                     ;;CPPMM
   14                     ;;|||||
   15                     ;;|||++- Mirroring (0: one-screen, lower bank; 1: one-screen, upper bank;
   16                     ;;|||               2: vertical; 3: horizontal)
   17                     ;;|++--- PRG ROM bank mode (0, 1: switch 32 KB at $8000, ignoring low bit of bank number;
   18                     ;;|                         2: fix first bank at $8000 and switch 16 KB bank at $C000;
   19                     ;;|                         3: fix last bank at $C000 and switch 16 KB bank at $8000)
   20                     ;;+----- CHR ROM bank mode (0: switch 8 KB at a time; 1: switch two separate 4 KB banks)
   21                        
   22  06:D2B5            SetMapperControls:
   23                       ;;A = controls
   24  06:D2B5  AA          TAX
   25  06:D2B6  A9 80       LDA #MAPPERCONTROL
   26  06:D2B8  8D A6 00    STA mapper_address+1
   27  06:D2BB  8A          TXA
   28  06:D2BC  20 E1 D2    JSR SendMapperCommand
   29  06:D2BF  60          RTS
   30                     
   31  06:D2C0            LoadPRGBank:
   32                     
   33                             ;;A is the desired PRG number
   34  06:D2C0  AA                TAX
   35  06:D2C1  A9 E0             LDA #PRGBANK
   36  06:D2C3  8D A6 00          STA mapper_address+1
   37  06:D2C6  8A                TXA
   38  06:D2C7  20 E1 D2          JSR SendMapperCommand
   39  06:D2CA  60                RTS
   40                             
   41  06:D2CB            LoadCHRBankA:
   42                             ;;A is the desired CHR bank
   43  06:D2CB  AA                TAX
   44  06:D2CC  A9 A0             LDA #CHRBANK1
   45  06:D2CE  8D A6 00          STA mapper_address+1
   46  06:D2D1  8A                TXA
   47  06:D2D2  20 E1 D2          JSR SendMapperCommand
   48  06:D2D5  60                RTS
   49                             
   50  06:D2D6            LoadCHRBankB:
   51                             ;;A is the desired CHR bank
   52  06:D2D6  AA                TAX
   53  06:D2D7  A9 C0             LDA #CHRBANK2
   54  06:D2D9  8D A6 00          STA mapper_address+1
   55  06:D2DC  8A                TXA
   56  06:D2DD  20 E1 D2          JSR SendMapperCommand
   57  06:D2E0  60                RTS
   58                             
   59  06:D2E1            SendMapperCommand:
   60                     
   61  06:D2E1  A0 00             LDY #$00
   62                             
   63  06:D2E3  91 A5             STA [mapper_address], y
   64  06:D2E5  4A                LSR A
   65  06:D2E6  91 A5             STA [mapper_address], y
   66  06:D2E8  4A                LSR A
   67  06:D2E9  91 A5             STA [mapper_address], y
   68  06:D2EB  4A                LSR A 
   69  06:D2EC  91 A5             STA [mapper_address], y
   70  06:D2EE  4A                LSR A
   71  06:D2EF  91 A5             STA [mapper_address], y
   72                             
   73  06:D2F1  60                RTS
   74                             
   75  06:D2F2            ResetBanks:
   76                     
   77  06:D2F2  20 B1 D2          JSR ResetMapper
   78  06:D2F5  A9 00             LDA #$00
   79  06:D2F7  20 C0 D2          JSR LoadPRGBank
   80                       
   81                             ;;as a test, load up the initial CHR banks
   82  06:D2FA  20 B1 D2          JSR ResetMapper
   83  06:D2FD  A9 00             LDA #$00
   84  06:D2FF  20 CB D2          JSR LoadCHRBankA
   85  06:D302  A9 01             LDA #$01
   86  06:D304  20 D6 D2          JSR LoadCHRBankB
   87  06:D307  60                RTS
