    9                       
   10  06:DA3C            nmi_started:
   11  06:DA3C  A9 00       LDA #$00
   12  06:DA3E  8D 03 20    STA OAM_LO      ; set the low byte (00) of the RAM address
   13  06:DA41  A9 02       LDA #$02
   14  06:DA43  8D 14 40    STA OAM_HI       ; set the high byte (02) of the RAM address, start the transfer
   15                     
   16  06:DA46  AD 12 00    LDA NMI_locks
   17  06:DA49  F0 03       BEQ update_controllers
   18  06:DA4B  4C 8B DA    JMP WakeUp
