  211                         
  212                         ;check if it's a rest and modify the status flag appropriately
  213                     
  214  07:E5E8  20 82 E6      jsr se_check_rest
  215  07:E5EB            .reset_ve:    
  216  07:E5EB  A9 00         lda #$00
  217  07:E5ED  9D 4A 03      sta stream_ve_index, x  
