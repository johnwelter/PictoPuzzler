  230  06:D216  C8          INY                   ; X = X + 1
  231  06:D217  CC 00 00    CPY DATA_LEN             ; Compare X to hex $10, decimal 16
  232  06:D21A  D0 F5       BNE .loop   ; Branch to LoadSpritesLoop if compare was Not Equal to zero
