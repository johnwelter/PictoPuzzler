  607                     ;--------------------------
  608                     ; se_set_apu copies the temporary RAM ports to the APU ports
  609  07:E846            se_set_apu:
  610  07:E846            .square1:
  611  07:E846  AD 06 03      lda soft_apu_ports+0
  612  07:E849  8D 00 40      sta $4000
  613  07:E84C  AD 07 03      lda soft_apu_ports+1
  614  07:E84F  8D 01 40      sta $4001
  615  07:E852  AD 08 03      lda soft_apu_ports+2
  616  07:E855  8D 02 40      sta $4002
  617  07:E858  AD 09 03      lda soft_apu_ports+3
  618  07:E85B  CD 04 03      cmp sound_sq1_old       ;compare to last write
  619  07:E85E  F0 06         beq .square2            ;don't write this frame if they were equal
  620  07:E860  8D 03 40      sta $4003
  621  07:E863  8D 04 03      sta sound_sq1_old       ;save the value we just wrote to $4003
  622  07:E866            .square2:
  623  07:E866  AD 0A 03      lda soft_apu_ports+4
  624  07:E869  8D 04 40      sta $4004
  625  07:E86C  AD 0B 03      lda soft_apu_ports+5
  626  07:E86F  8D 05 40      sta $4005
  627  07:E872  AD 0C 03      lda soft_apu_ports+6
  628  07:E875  8D 06 40      sta $4006
  629  07:E878  AD 0D 03      lda soft_apu_ports+7
  630  07:E87B  CD 05 03      cmp sound_sq2_old
  631  07:E87E  F0 06         beq .triangle
  632  07:E880  8D 07 40      sta $4007
  633  07:E883  8D 05 03      sta sound_sq2_old       ;save the value we just wrote to $4007
  634  07:E886            .triangle:
  635  07:E886  AD 0E 03      lda soft_apu_ports+8
  636  07:E889  8D 08 40      sta $4008
  637  07:E88C  AD 10 03      lda soft_apu_ports+10   ;there is no $4009, so we skip it
  638  07:E88F  8D 0A 40      sta $400A
  639  07:E892  AD 11 03      lda soft_apu_ports+11
  640  07:E895  8D 0B 40      sta $400B
  641  07:E898            .noise:
  642  07:E898  AD 12 03      lda soft_apu_ports+12
  643  07:E89B  8D 0C 40      sta $400C
  644  07:E89E  AD 14 03      lda soft_apu_ports+14   ;there is no $400D, so we skip it
  645  07:E8A1  8D 0E 40      sta $400E
  646  07:E8A4  AD 15 03      lda soft_apu_ports+15
  647  07:E8A7  8D 0F 40      sta $400F
  648  07:E8AA  60            rts
