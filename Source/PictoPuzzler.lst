  368  06:D2E8            InitPPUControl:
  369                       
  370                       ; enable NMI, sprites from Pattern Table 0, background from Pattern Table 1
  371                       ; enable sprites, enable background, no clipping on left side
  372  06:D2E8  A9 90       LDA #%10010000
  373  06:D2EA  8D 00 20    STA PPU_CTRL
  374  06:D2ED  8D 27 00    STA PPU_Control
