       06:D512  A9 00       LDA #$00
       06:D514  20 23 D4    JSR WriteToPPUString
       06:D517  A9 00       LDA #DRAW_HORIZONTAL
       06:D519  20 23 D4    JSR WriteToPPUString
       06:D51C  A9 20       LDA #$20 
       06:D51E  20 23 D4    JSR WriteToPPUString
                            
