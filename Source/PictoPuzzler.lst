   60                     
   61  06:D72E  A0 00             LDY #$00
   62                             
   63  06:D730  91 AF             STA [mapper_address], y
   64  06:D732  4A                LSR A
   65  06:D733  91 AF             STA [mapper_address], y
   66  06:D735  4A                LSR A
   67  06:D736  91 AF             STA [mapper_address], y
   68  06:D738  4A                LSR A 
   69  06:D739  91 AF             STA [mapper_address], y
   70  06:D73B  4A                LSR A
   71  06:D73C  91 AF             STA [mapper_address], y
   72                             
   73  06:D73E  60                RTS
