#[2]   Source/Routines/Utils/MapperUtils.asm
  183                       .include "Source/Routines/Utils/MapperUtils.asm"
    1           0080      MAPPERCONTROL = $80
    2           00A0      CHRBANK1 = $A0
    3           00C0      CHRBANK2 = $C0
    4           00E0      PRGBANK = $E0
    5                     
    6  06:D363            ResetMapper:
    7  06:D363  EE 63 D3    inc ResetMapper
    8  06:D366  60          RTS
    9                       
   10                     ;;now, set up the controls for the mapper
   11                     ;;4bit0
   12                     ;;-----
   13                     ;;CPPMM
   14                     ;;|||||
   15                     ;;|||++- Mirroring (0: one-screen, lower bank; 1: one-screen, upper bank;
   16                     ;;|||               2: vertical; 3: horizontal)
   17                     ;;|++--- PRG ROM bank mode (0, 1: switch 32 KB at $8000, ignoring low bit of bank number;
   18                     ;;|                         2: fix first bank at $8000 and switch 16 KB bank at $C000;
   19                     ;;|                         3: fix last bank at $C000 and switch 16 KB bank at $8000)
   20                     ;;+----- CHR ROM bank mode (0: switch 8 KB at a time; 1: switch two separate 4 KB banks)
   21                        
   22  06:D367            SetMapperControls:
   23                       ;;A = controls
   24  06:D367  AA          TAX
   25  06:D368  A9 80       LDA #MAPPERCONTROL
   26  06:D36A  8D B0 00    STA mapper_address+1
   27  06:D36D  8A          TXA
   28  06:D36E  20 93 D3    JSR SendMapperCommand
   29  06:D371  60          RTS
   30                     
   31  06:D372            LoadPRGBank:
   32                     
   33                             ;;A is the desired PRG number
   34  06:D372  AA                TAX
   35  06:D373  A9 E0             LDA #PRGBANK
   36  06:D375  8D B0 00          STA mapper_address+1
   37  06:D378  8A                TXA
   38  06:D379  20 93 D3          JSR SendMapperCommand
   39  06:D37C  60                RTS
   40                             
   41  06:D37D            LoadCHRBankA:
   42                             ;;A is the desired CHR bank
   43  06:D37D  AA                TAX
   44  06:D37E  A9 A0             LDA #CHRBANK1
   45  06:D380  8D B0 00          STA mapper_address+1
   46  06:D383  8A                TXA
   47  06:D384  20 93 D3          JSR SendMapperCommand
   48  06:D387  60                RTS
   49                             
   50  06:D388            LoadCHRBankB:
   51                             ;;A is the desired CHR bank
   52  06:D388  AA                TAX
   53  06:D389  A9 C0             LDA #CHRBANK2
   54  06:D38B  8D B0 00          STA mapper_address+1
   55  06:D38E  8A                TXA
   56  06:D38F  20 93 D3          JSR SendMapperCommand
   57  06:D392  60                RTS
   58                             
   59  06:D393            SendMapperCommand:
   60                     
   61  06:D393  A0 00             LDY #$00
   62                             
   63  06:D395  91 AF             STA [mapper_address], y
   64  06:D397  4A                LSR A
   65  06:D398  91 AF             STA [mapper_address], y
   66  06:D39A  4A                LSR A
