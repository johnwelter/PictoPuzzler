    4                     MACROGetDoubleIndex .macro
    5                     
    6                             LDA \1
    7                             ASL A
    8                             TAY
    9                             
   10                       .endm
#[2]   Source/Routines/Macros/Macros.asm
#[3]   Source/Routines/Macros/GetLabelPointer.asm
    6                             .include "Source/Routines/Macros/GetLabelPointer.asm"
    1                     ;;macro to load a full name table
    2                     ;; \1 = label we want address of
    3                     ;; \2 = address to store address to
    4                     ;; all registers clobbered, as well as table_address
    5                     MACROGetLabelPointer .macro
    6                     
    7                             LDA #HIGH(\1)
    8                             LDX #LOW(\1)
    9                             
   10                             STX \2
   11                             STA \2+1
   12                             
   13                       .endm
   14                       
   15                     MACROGetPointer .macro
   16                     
   17                             LDA \1
   18                             STA \2
   19                             LDA \1+1
   20                             STA \2+1
   21                     
   22                       .endm
   23                       
   24                     MACROAdd32ToPointer .macro
   25                     
   26                             LDA \1+1
   27                             LDX \1
   28                             JSR Add32ToAddress
   29                             STA \1+1
   30                             STX \1
   31                             
   32                             .endm
#[2]   Source/Routines/Macros/Macros.asm
