#[1]   Source/PictoPuzzler.asm
#[2]   Source/External/SoundEngine/Source/sound_engine.asm
  234                       .include "Source/External/SoundEngine/Source/sound_engine.asm"
    1  07:E48E            sound_init:
    2  07:E48E  A9 1F         lda #$1F
    3  07:E490  8D 15 40      sta $4015   ;enable Square 1, Square 2, Triangle and Noise channels
    4  07:E493  8D 00 03          sta sound_enable_flags
    5                         
    6  07:E496  A9 00         lda #$00
    7  07:E498  8D 01 03      sta sound_disable_flag  ;clear disable flag
    8                         ;later, if we have other variables we want to initialize, we will do that here.
    9  07:E49B  A9 FF         lda #$FF
   10  07:E49D  8D 04 03      sta sound_sq1_old   ;initializing these to $FF ensures that the first notes of the first song isn't skipped
   11  07:E4A0  8D 05 03      sta sound_sq2_old
   12  07:E4A3            se_silence:
   13  07:E4A3  A9 30         lda #$30
   14  07:E4A5  8D 06 03      sta soft_apu_ports      ;set Square 1 volume to 0
   15  07:E4A8  8D 0A 03      sta soft_apu_ports+4    ;set Square 2 volume to 0
   16  07:E4AB  8D 12 03      sta soft_apu_ports+12   ;set Noise volume to 0
   17  07:E4AE  A9 80         lda #$80
   18  07:E4B0  8D 0E 03      sta soft_apu_ports+8     ;silence Triangle
   19  07:E4B3  A9 00             lda #$00
   20  07:E4B5  8D 17 03          sta soft_apu_ports+17    ;silence DPMC
   21                     
   22  07:E4B8  60            rts
   23                         
   24  07:E4B9            sound_disable:
   25  07:E4B9  A9 00         lda #$00
   26  07:E4BB  8D 15 40      sta $4015   ;disable all channels
   27  07:E4BE  8D 00 03          sta sound_enable_flags
   28  07:E4C1  A9 01         lda #$01
   29  07:E4C3  8D 01 03      sta sound_disable_flag  ;set disable flag
   30  07:E4C6  60            rts
   31                         
   32                     ;-------------------------------------
   33                     ; load_sound will prepare the sound engine to play a song or sfx.
   34                     ;   input:
   35                     ;       A: song/sfx number to play
   36  07:E4C7            sound_load:
   37  07:E4C7  8D 02 03      sta sound_temp1         ;save song number
   38  07:E4CA  0A            asl a                   ;multiply by 2.  We are indexing into a table of pointers (words)
   39  07:E4CB  A8            tay
   40  07:E4CC  B9 AB E8      lda song_headers, y     ;setup the pointer to our song header
   41  07:E4CF  8D DF 00      sta sound_ptr
   42  07:E4D2  B9 AC E8      lda song_headers+1, y
   43  07:E4D5  8D E0 00      sta sound_ptr+1
   44                         
   45  07:E4D8  A0 00         ldy #$00
   46  07:E4DA  B1 DF         lda [sound_ptr], y      ;read the first byte: # streams
   47  07:E4DC  8D 03 03      sta sound_temp2         ;store in a temp variable.  We will use this as a loop counter: how many streams to read stream headers for
   48  07:E4DF  C8            iny
   49  07:E4E0            .loop:
   50  07:E4E0  B1 DF         lda [sound_ptr], y      ;stream number
   51  07:E4E2  AA            tax                     ;stream number acts as our variable index
   52  07:E4E3  C8            iny
   53                         
   54  07:E4E4  B1 DF         lda [sound_ptr], y      ;status byte.  1= enable, 0=disable
   55  07:E4E6  9D 22 03      sta stream_status, x
   56  07:E4E9  F0 49         beq .next_stream        ;if status byte is 0, stream disabled, so we are done
   57  07:E4EB  C8            iny
   58                         
   59  07:E4EC  B1 DF         lda [sound_ptr], y      ;channel number
   60  07:E4EE  9D 2A 03      sta stream_channel, x
   61  07:E4F1  C8            iny
   62                         
   63  07:E4F2  B1 DF         lda [sound_ptr], y      ;initial duty and volume settings
   64  07:E4F4  9D 52 03      sta stream_vol_duty, x
   65  07:E4F7  C8            iny
   66                         
   67  07:E4F8  B1 DF         lda [sound_ptr], y
   68  07:E4FA  9D 42 03      sta stream_ve, x
   69  07:E4FD  C8            iny
   70                             
   71                             ;temp solution
   72  07:E4FE  A9 00             lda #me_none
   73  07:E500  9D A0 03          sta stream_pe, x
   74                             
   75                             ;temp solution
   76  07:E503  A9 00             lda #arp_none
   77  07:E505  9D C0 03          sta stream_arp, x
   78                         
   79  07:E508  B1 DF         lda [sound_ptr], y      ;pointer to stream data.  Little endian, so low byte first
   80  07:E50A  9D 32 03      sta stream_ptr_LO, x
   81  07:E50D  C8            iny
   82                         
   83  07:E50E  B1 DF         lda [sound_ptr], y
   84  07:E510  9D 3A 03      sta stream_ptr_HI, x
   85  07:E513  C8            iny
   86                         
   87  07:E514  B1 DF         lda [sound_ptr], y
   88  07:E516  9D 72 03      sta stream_tempo, x
   89                         
   90  07:E519  A9 A0         lda #$A0
   91  07:E51B  9D 7A 03      sta stream_ticker_total, x
   92                         
   93  07:E51E  A9 01         lda #$01
   94  07:E520  9D 82 03      sta stream_note_length_counter,x
   95                         
   96  07:E523  A9 00         lda #$00
   97  07:E525  9D 4A 03      sta stream_ve_index, x
   98  07:E528  9D A8 03          sta stream_pe_index, x
   99  07:E52B  9D C8 03          sta stream_arp_index, x
  100  07:E52E  9D 92 03      sta stream_loop1, x
  101  07:E531  9D 9A 03      sta stream_note_offset, x
  102  07:E534            .next_stream:
  103  07:E534  C8            iny
  104                         
  105  07:E535  AD 02 03      lda sound_temp1         ;song number
  106  07:E538  9D 1A 03      sta stream_curr_sound, x
  107                         
  108  07:E53B  CE 03 03      dec sound_temp2         ;our loop counter
  109  07:E53E  D0 A0         bne .loop
  110  07:E540  60            rts
  111                     
  112                     ;--------------------------
  113                     ; sound_play_frame advances the sound engine by one frame
  114  07:E541            sound_play_frame:
  115  07:E541  AD 01 03      lda sound_disable_flag
  116  07:E544  D0 31         bne .done   ;if disable flag is set, don't advance a frame
  117                     
  118  07:E546  20 A3 E4      jsr se_silence  ;silence all channels.  se_set_apu will set volume later for all channels that are enabled.
  119                                         ;the purpose of this subroutine call is to silence channels that aren't used by any streams.
  120  07:E549  A2 00         ldx #$00
  121  07:E54B            .loop:
  122  07:E54B  BD 22 03      lda stream_status, x
  123  07:E54E  29 01         and #$01    ;check whether the stream is active
  124  07:E550  F0 1D         beq .endloop  ;if the stream isn't active, skip it
  125                         
  126                         ;add the tempo to the ticker total.  If there is a FF-> 0 transition, there is a tick
  127  07:E552  BD 7A 03      lda stream_ticker_total, x
  128  07:E555  18            clc
  129  07:E556  7D 72 03      adc stream_tempo, x
  130  07:E559  9D 7A 03      sta stream_ticker_total, x
  131  07:E55C  90 0E         bcc .set_buffer    ;carry clear = no tick.  if no tick, we are done with this stream
  132                         
  133  07:E55E  DE 82 03      dec stream_note_length_counter, x   ;else there is a tick. decrement the note length counter
  134  07:E561  D0 09         bne .set_buffer    ;if counter is non-zero, our note isn't finished playing yet
  135  07:E563  BD 8A 03      lda stream_note_length, x   ;else our note is finished. reload the note length counter
  136  07:E566  9D 82 03      sta stream_note_length_counter, x
  137                         
  138  07:E569  20 78 E5      jsr se_fetch_byte   ;read the next byte from the data stream
  139                         
  140  07:E56C            .set_buffer:
  141  07:E56C  20 B3 E6      jsr se_set_temp_ports   ;copy the current stream's sound data for the current frame into our temporary APU vars (soft_apu_ports)
  142  07:E56F            .endloop:
  143  07:E56F  E8            inx
  144  07:E570  E0 08         cpx #$08
  145  07:E572  D0 D7         bne .loop
  146  07:E574  20 46 E8      jsr se_set_apu      ;copy the temporary APU variables (soft_apu_ports) to the real APU ports ($4000, $4001, etc)
  147  07:E577            .done:
  148  07:E577  60            rts
  149                     
  150                     ;--------------------------
  151                     ; se_fetch_byte reads one byte from a sound data stream and handles it
  152                     ;   input: 
  153                     ;       X: stream number    
  154  07:E578            se_fetch_byte:
  155  07:E578  BD 32 03      lda stream_ptr_LO, x
  156  07:E57B  8D DF 00      sta sound_ptr
  157  07:E57E  BD 3A 03      lda stream_ptr_HI, x
  158  07:E581  8D E0 00      sta sound_ptr+1
  159                         
  160  07:E584  A0 00         ldy #$00
  161  07:E586            .fetch:
  162  07:E586  B1 DF         lda [sound_ptr], y
  163  07:E588  10 26         bpl .note                ;if < #$80, it's a Note
  164  07:E58A  C9 A0         cmp #$A0
  165  07:E58C  90 0C         bcc .note_length         ;else if < #$A0, it's a Note Length
  166  07:E58E            .opcode:                     ;else it's an opcode
  167                         ;do Opcode stuff
  168  07:E58E  20 98 E6      jsr se_opcode_launcher
  169  07:E591  C8            iny                      ;next position in the data stream
  170  07:E592  BD 22 03      lda stream_status, x
  171  07:E595  29 01         and #%00000001
  172  07:E597  D0 ED         bne .fetch               ;after our opcode is done, grab another byte unless the stream is disabled
  173  07:E599  60            rts                      ; in which case we quit  (explained below)
  174  07:E59A            .note_length:
  175                         ;do note length stuff
  176  07:E59A  29 7F         and #%01111111          ;chop off bit7
  177  07:E59C  8C 02 03      sty sound_temp1         ;save Y because we are about to destroy it
  178  07:E59F  A8            tay
  179  07:E5A0  B9 81 EC      lda note_length_table, y    ;get the note length count value
  180  07:E5A3  9D 8A 03      sta stream_note_length, x
  181  07:E5A6  9D 82 03      sta stream_note_length_counter, x   ;stick it in our note length counter
  182  07:E5A9  AC 02 03      ldy sound_temp1         ;restore Y
  183  07:E5AC  C8            iny                     ;set index to next byte in the stream
  184  07:E5AD  4C 86 E5      jmp .fetch              ;fetch another byte
  185  07:E5B0            .note:
  186                         ;do Note stuff
  187  07:E5B0  8D 03 03      sta sound_temp2
  188  07:E5B3  BD 2A 03      lda stream_channel, x
  189  07:E5B6  C9 03         cmp #NOISE
  190  07:E5B8  D0 06         bne .not_noise
  191  07:E5BA  20 08 E6      jsr se_do_noise
  192  07:E5BD  4C EB E5      jmp .reset_ve
  193  07:E5C0            .not_noise:
  194  07:E5C0  C9 04             cmp #DPMC
  195  07:E5C2  90 06             bcc .not_dpmc
  196  07:E5C4  20 40 E6          jsr se_do_dpmc
  197  07:E5C7  4C EB E5          jmp .reset_ve
  198  07:E5CA            .not_dpmc:
  199  07:E5CA  AD 03 03      lda sound_temp2
  200  07:E5CD  8C 02 03      sty sound_temp1     ;save our index into the data stream
  201  07:E5D0  18            clc
  202  07:E5D1  7D 9A 03      adc stream_note_offset, x   ;add note offset
  203  07:E5D4  0A            asl a
  204  07:E5D5  A8            tay
  205  07:E5D6  9D 5A 03          sta stream_note_idx, x
  206  07:E5D9  B9 C3 EB      lda note_table, y
  207  07:E5DC  9D 62 03      sta stream_note_LO, x
  208  07:E5DF  B9 C4 EB      lda note_table+1, y
  209  07:E5E2  9D 6A 03      sta stream_note_HI, x
  210  07:E5E5  AC 02 03      ldy sound_temp1     ;restore data stream index
  211                         
  212                         ;check if it's a rest and modify the status flag appropriately
  213                     
  214  07:E5E8  20 82 E6      jsr se_check_rest
  215  07:E5EB            .reset_ve:    
  216  07:E5EB  A9 00         lda #$00
  217  07:E5ED  9D 4A 03      sta stream_ve_index, x  
  218  07:E5F0  9D A8 03          sta stream_pe_index, x
  219  07:E5F3  9D B8 03          sta stream_pe_delay, x
  220  07:E5F6  9D C8 03          sta stream_arp_index,x
  221  07:E5F9            .update_pointer:
  222  07:E5F9  C8            iny
  223  07:E5FA  98            tya
  224  07:E5FB  18            clc
  225  07:E5FC  7D 32 03      adc stream_ptr_LO, x
  226  07:E5FF  9D 32 03      sta stream_ptr_LO, x
  227  07:E602  90 03         bcc .end
  228  07:E604  FE 3A 03      inc stream_ptr_HI, x
  229  07:E607            .end:
  230  07:E607  60            rts
  231                     
  232  07:E608            se_do_noise:
  233                     
  234  07:E608  AD 15 40          lda $4015
  235  07:E60B  29 10             AND #$10                                ;get the current DMC bytes remaining
  236  07:E60D  09 07             ORA #$07                                ;add in the lower three bits
  237  07:E60F  2D 00 03          AND sound_enable_flags  ;and with the current sound flags, minus noise
  238  07:E612  8D 00 03          sta sound_enable_flags  ;disable noise
  239  07:E615  8D 15 40          sta $4015
  240                     
  241  07:E618  AD 03 03      lda sound_temp2
  242  07:E61B  29 20             AND #%00100000
  243  07:E61D  D0 20             bne .leave
  244                             
  245  07:E61F  AD 03 03          lda sound_temp2
  246  07:E622  29 10         and #%00010000
  247  07:E624  F0 08         beq .mode0
  248  07:E626  AD 03 03      lda sound_temp2
  249  07:E629  09 80         ora #%10000000      ;set bit 7 to set mode1
  250  07:E62B  8D 03 03      sta sound_temp2
  251  07:E62E            .mode0:
  252  07:E62E  AD 03 03      lda sound_temp2
  253  07:E631  9D 62 03      sta stream_note_LO, x
  254                     
  255  07:E634  AD 00 03          lda sound_enable_flags
  256  07:E637  09 08             ORA #%00001000
  257  07:E639  8D 00 03          STA sound_enable_flags
  258  07:E63C  8D 15 40          sta $4015
  259  07:E63F            .leave:
  260  07:E63F  60            rts
  261                             
  262  07:E640            se_do_dpmc:
  263  07:E640  8A                TXA
  264  07:E641  48                PHA
  265                             
  266  07:E642  AD 00 03          lda sound_enable_flags
  267  07:E645  29 0F             AND #$0F
  268  07:E647  8D 00 03          sta sound_enable_flags ;DPCM disable
  269  07:E64A  8D 15 40          sta $4015
  270                             
  271  07:E64D  AD 03 03          lda sound_temp2         ;load up sample index- we can cram in the pitch and keep ourselves to 6 samples (7 will be rest)
  272  07:E650  C9 70             CMP #$70
  273  07:E652  B0 2B             BCS .leave
  274                     
  275  07:E654  29 0F             AND #$0F
  276  07:E656  8D 10 40          sta $4010 ;pitch
  277  07:E659  A9 7F             LDA #$7F
  278  07:E65B  8D 11 40          sta $4011 ;temp = starting sample level
  279  07:E65E  AD 03 03          lda sound_temp2
  280  07:E661  29 F0             AND #$F0
  281  07:E663  4A                LSR A
  282  07:E664  4A                LSR A
  283  07:E665  4A                LSR A
  284  07:E666  4A                LSR A
  285  07:E667  AA                TAX
  286  07:E668  BD F1 DE          lda SampleStart,x
  287  07:E66B  8D 12 40          sta $4012 ;X = sample number
  288  07:E66E  BD F3 DE          lda SampleLength,x
  289  07:E671  8D 13 40          sta $4013
  290                             
  291  07:E674  AD 00 03          lda sound_enable_flags
  292  07:E677  09 10             ORA #$10
  293  07:E679  8D 00 03          STA sound_enable_flags
  294  07:E67C  8D 15 40          sta $4015
  295  07:E67F            .leave:
  296  07:E67F  68                PLA
  297  07:E680  AA                TAX
  298                     
  299  07:E681  60                rts
  300                             
  301                     ;--------------------------------------------------
  302                     ; se_check_rest will read a byte from the data stream and
  303                     ;       determine if it is a rest or not.  It will set or clear the current
  304                     ;       stream's rest flag accordingly.
  305                     ;       input:
  306                     ;           X: stream number
  307                     ;           Y: data stream index
  308  07:E682            se_check_rest:
  309  07:E682  B1 DF         lda [sound_ptr], y  ;read the note byte again
  310  07:E684  C9 5E         cmp #rest
  311  07:E686  D0 07         bne .not_rest
  312  07:E688  BD 22 03      lda stream_status, x
  313  07:E68B  09 02         ora #%00000010  ;set the rest bit in the status byte
  314  07:E68D  D0 05         bne .store  ;this will always branch.  bne is cheaper than a jmp.
  315  07:E68F            .not_rest:
  316  07:E68F  BD 22 03      lda stream_status, x
  317  07:E692  29 FD         and #%11111101  ;clear the rest bit in the status byte
  318  07:E694            .store:
  319  07:E694  9D 22 03      sta stream_status, x
  320  07:E697  60            rts
  321                         
  322                     ;-----------------------------------------
  323                     ; se_opcode_launcher will read an address from the opcode jump table and indirect jump there.
  324                     ;    input: A: opcode byte
  325                     ;               Y: data stream position
  326                     ;               X: stream number
  327  07:E698            se_opcode_launcher:
  328  07:E698  8C 02 03      sty sound_temp1         ;save y register, because we are about to destroy it
  329  07:E69B  38            sec
  330  07:E69C  E9 A0         sbc #$A0                ;turn our opcode byte into a table index by subtracting $A0
  331  07:E69E  0A            asl a                   ;multiply by 2 because we index into a table of addresses (words)
  332  07:E69F  A8            tay
  333  07:E6A0  B9 10 EB      lda sound_opcodes, y    ;get low byte of subroutine address
  334  07:E6A3  8D E1 00      sta sound_ptr2
  335  07:E6A6  B9 11 EB      lda sound_opcodes+1, y  ;get high byte
  336  07:E6A9  8D E2 00      sta sound_ptr2+1
  337  07:E6AC  AC 02 03      ldy sound_temp1         ;restore our y register
  338  07:E6AF  C8            iny                     ;set to next position in data stream (assume an argument)
  339  07:E6B0  6C E1 00      jmp [sound_ptr2]           ;indirect jump to our opcode subroutine    
  340                         
  341                     ;----------------------------------------------------
  342                     ; se_set_temp_ports will copy a stream's sound data to the temporary apu variables
  343                     ;      input:
  344                     ;           X: stream number
  345  07:E6B3            se_set_temp_ports:
  346                     
  347  07:E6B3  E0 06             cpx #MUSIC_DPMC
  348  07:E6B5  90 01             bcc .contTempPorts
  349  07:E6B7  60                rts
  350  07:E6B8            .contTempPorts:
  351  07:E6B8  BD 2A 03      lda stream_channel, x
  352  07:E6BB  0A            asl a
  353  07:E6BC  0A            asl a
  354  07:E6BD  A8            tay
  355                         
  356  07:E6BE  20 E1 E6      jsr se_set_stream_volume
  357                             
  358                         
  359  07:E6C1  A9 08         lda #$08
  360  07:E6C3  99 07 03      sta soft_apu_ports+1, y     ;sweep
  361                         
  362                             
  363  07:E6C6  BD C0 03          LDA stream_arp, x
  364  07:E6C9  F0 06             BEQ .updatePitch
  365                             
  366  07:E6CB  20 3D E7          JSR se_set_stream_arpeggio
  367  07:E6CE  4C E0 E6          JMP .leaveTempSet
  368                             
  369  07:E6D1            .updatePitch:
  370  07:E6D1  BD 62 03      lda stream_note_LO, x
  371  07:E6D4  99 08 03      sta soft_apu_ports+2, y     ;period LO
  372                         
  373  07:E6D7  BD 6A 03      lda stream_note_HI, x
  374  07:E6DA  99 09 03      sta soft_apu_ports+3, y     ;period HI
  375                             
  376                     
  377  07:E6DD  20 97 E7          jsr se_set_stream_pitch
  378                     
  379  07:E6E0            .leaveTempSet:
  380  07:E6E0  60            rts    
  381                     
  382                     ;----------------------------------
  383                     ;    
  384  07:E6E1            se_set_stream_volume:
  385                             
  386  07:E6E1  8C 02 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  387                         
  388  07:E6E4  BD 42 03      lda stream_ve, x            ;which volume envelope?
  389  07:E6E7  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  390  07:E6E8  A8            tay
  391  07:E6E9  B9 9D EC      lda kVol, y     ;get the low byte of the address from the pointer table
  392  07:E6EC  8D DF 00      sta sound_ptr               ;put it into our pointer variable
  393  07:E6EF  B9 9E EC      lda kVol+1, y   ;get the high byte of the address
  394  07:E6F2  8D E0 00      sta sound_ptr+1
  395                         
  396  07:E6F5            .read_ve:
  397  07:E6F5  BC 4A 03      ldy stream_ve_index, x      ;our current position within the volume envelope.
  398  07:E6F8  B1 DF         lda [sound_ptr], y          ;grab the value.
  399  07:E6FA  C9 FF         cmp #$FF
  400  07:E6FC  D0 06         bne .set_vol                ;if not FF, set the volume
  401  07:E6FE  DE 4A 03      dec stream_ve_index, x      ;else if FF, go back one and read again
  402  07:E701  4C F5 E6      jmp .read_ve                ;  FF essentially tells us to repeat the last
  403                                                     ;  volume value for the remainder of the note
  404  07:E704            .set_vol:
  405  07:E704  8D 03 03      sta sound_temp2             ;save our new volume value (about to destroy A)
  406                         
  407  07:E707  E0 02         cpx #TRIANGLE               
  408  07:E709  D0 09         bne .squares                ;if not triangle channel, go ahead
  409  07:E70B  AD 03 03      lda sound_temp2
  410  07:E70E  D0 04         bne .squares                ;else if volume not zero, go ahead (treat same as squares)
  411  07:E710  A9 80         lda #$80
  412  07:E712  30 08         bmi .store_vol              ;else silence the channel with #$80
  413  07:E714            .squares:
  414  07:E714  BD 52 03      lda stream_vol_duty, x      ;get current vol/duty settings
  415  07:E717  29 F0         and #$F0                    ;zero out the old volume
  416  07:E719  0D 03 03      ora sound_temp2             ;OR our new volume in.
  417                     
  418  07:E71C            .store_vol:
  419  07:E71C  AC 02 03      ldy sound_temp1             ;get our index into soft_apu_ports
  420  07:E71F  99 06 03      sta soft_apu_ports, y       ;store the volume in our temp port
  421  07:E722  FE 4A 03      inc stream_ve_index, x      ;set our volume envelop index to the next position
  422                     
  423  07:E725            .rest_check:
  424                         ;check the rest flag. if set, overwrite volume with silence value 
  425  07:E725  BD 22 03      lda stream_status, x
  426  07:E728  29 02         and #%00000010
  427  07:E72A  F0 10         beq .done                   ;if clear, no rest, so quit
  428  07:E72C  BD 2A 03      lda stream_channel, x
  429  07:E72F  C9 02         cmp #TRIANGLE               ;if triangle, silence with #$80
  430  07:E731  F0 04         beq .tri                    ;else, silence with #$30
  431  07:E733  A9 30         lda #$30        
  432  07:E735  D0 02         bne .store                  ;this always branches.  bne is cheaper than a jmp
  433  07:E737            .tri:
  434  07:E737  A9 80         lda #$80
  435  07:E739            .store:    
  436  07:E739  99 06 03      sta soft_apu_ports, y
  437  07:E73C            .done:
  438  07:E73C  60            rts   
  439                             
  440                     ;---------------------------------------
  441                     ;
  442  07:E73D            se_set_stream_arpeggio:
  443                         
  444  07:E73D  BD 22 03          lda stream_status, x
  445  07:E740  29 02         and #%00000010
  446  07:E742  F0 01             beq .continue
  447  07:E744  60                rts
  448                             
  449  07:E745            .continue:
  450  07:E745  8C 02 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  451                         
  452  07:E748  BD C0 03      lda stream_arp, x            ;which volume envelope?
  453  07:E74B  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  454  07:E74C  A8            tay
  455  07:E74D  B9 51 EE      lda kArp, y     ;get the low byte of the address from the pointer table
  456  07:E750  8D DF 00      sta sound_ptr               ;put it into our pointer variable
  457  07:E753  B9 52 EE      lda kArp+1, y   ;get the high byte of the address
  458  07:E756  8D E0 00      sta sound_ptr+1
  459                         
  460  07:E759            .read_arp:
  461  07:E759  BC C8 03      ldy stream_arp_index, x      ;our current position within the volume envelope.
  462  07:E75C  B1 DF         lda [sound_ptr], y          ;grab the value.
  463  07:E75E  C9 81         cmp #$81
  464  07:E760  D0 08         bne .set_arp                ;if not 80, set the volume
  465  07:E762  A9 00             LDA #$00
  466  07:E764  9D C8 03      STA stream_arp_index, x      ;else if 80, go back one to start
  467  07:E767  4C 59 E7      jmp .read_arp                ;  FF essentially tells us to repeat the last
  468                                                     ;  volume value for the remainder of the note
  469  07:E76A            .set_arp:
  470  07:E76A  8D 03 03      STA sound_temp2             ;save our new volume value (about to destroy A)
  471  07:E76D  BD 5A 03          LDA stream_note_idx, x          ;note indexes are premultiplied, un mult for an easier add
  472  07:E770  4A                LSR A                           
  473  07:E771  18                CLC
  474  07:E772  6D 03 03          ADC sound_temp2
  475  07:E775  8D 03 03          STA sound_temp2
  476                             
  477                             
  478  07:E778  AC 02 03          LDY sound_temp1
  479  07:E77B  8E 02 03          STX sound_temp1
  480  07:E77E  0A                ASL A
  481  07:E77F  AA                TAX 
  482                     
  483  07:E780  BD C3 EB          LDA note_table, x
  484  07:E783  99 08 03          STA soft_apu_ports+2, y
  485  07:E786  BD C4 EB          LDA note_table+1, x
  486  07:E789  99 09 03          STA soft_apu_ports+3, y
  487                             
  488  07:E78C  AE 02 03          LDX sound_temp1
  489                             
  490  07:E78F  FE C8 03      inc stream_arp_index, x      ;set our volume envelop index to the next position
  491                             
  492  07:E792  98                TYA
  493  07:E793  8D 02 03          STA sound_temp1
  494                     
  495  07:E796  60            rts 
  496                     ;--------------------------------------
  497                     ;
  498  07:E797            se_set_stream_pitch:
  499  07:E797  8C 02 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  500                         
  501  07:E79A  BD A0 03      lda stream_pe, x            ;which volume envelope?
  502  07:E79D  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  503  07:E79E  A8            tay
  504  07:E79F  B9 04 EE      lda kMod, y     ;get the low byte of the address from the pointer table
  505  07:E7A2  8D DF 00      sta sound_ptr               ;put it into our pointer variable
  506  07:E7A5  B9 05 EE      lda kMod+1, y   ;get the high byte of the address
  507  07:E7A8  8D E0 00      sta sound_ptr+1
  508                             
  509  07:E7AB  BD B8 03          LDA stream_pe_delay, x
  510                             ;;if not 0, decrement
  511                             ;AND #$7F                       ;check if, without minus flag, the delay is 0
  512  07:E7AE  F0 04             BEQ .read_pe
  513  07:E7B0  DE B8 03          DEC stream_pe_delay, x
  514  07:E7B3  60                RTS
  515                         
  516  07:E7B4            .read_pe:
  517  07:E7B4  BC A8 03      ldy stream_pe_index, x      ;our current position within the volume envelope.
  518  07:E7B7  B1 DF         lda [sound_ptr], y          ;grab the value.
  519  07:E7B9  C9 80         cmp #l_cLast
  520  07:E7BB  D0 06             BNE .notLoopLast
  521  07:E7BD  DE A8 03          dec stream_pe_index, x      ;else if loop last, go back one and read again
  522  07:E7C0  4C B4 E7          jmp .read_pe 
  523                     
  524  07:E7C3            .notLoopLast:
  525  07:E7C3  C9 81             cmp #l_cAll
  526  07:E7C5  D0 08             BNE .notLoopAll
  527  07:E7C7  A9 00             LDA #$00
  528  07:E7C9  9D A8 03          STA stream_pe_index, x
  529  07:E7CC  4C B4 E7          jmp .read_pe
  530                             
  531  07:E7CF            .notLoopAll:
  532  07:E7CF  C9 82             cmp #l_cPart
  533  07:E7D1  D0 0D             BNE .notLoopPart
  534  07:E7D3  C8                iny
  535  07:E7D4  BD A8 03          lda stream_pe_index, x
  536  07:E7D7  38                SEC
  537  07:E7D8  F1 DF             SBC [sound_ptr], y
  538  07:E7DA  9D A8 03          STA stream_pe_index, x
  539  07:E7DD  4C B4 E7          jmp .read_pe
  540                     
  541  07:E7E0            .notLoopPart:
  542  07:E7E0  C9 83             cmp #l_cHold
  543  07:E7E2  D0 15             BNE .notLoopDelay
  544                             ;LDA stream_pe_delay, x
  545                             ;BMI .delayUsed ;negative, delay was already used this time
  546  07:E7E4  C8                iny
  547  07:E7E5  B1 DF             lda [sound_ptr], y
  548                             ;ORA #$80
  549  07:E7E7  9D B8 03          STA stream_pe_delay, x
  550  07:E7EA  FE A8 03          inc stream_pe_index, x
  551  07:E7ED  4C 36 E8          jmp .finish_pitchShift
  552  07:E7F0            .delayUsed:
  553  07:E7F0  FE A8 03          inc stream_pe_index, x
  554  07:E7F3  FE A8 03          inc stream_pe_index, x
  555  07:E7F6  4C B4 E7          jmp .read_pe
  556                             
  557  07:E7F9            .notLoopDelay:
  558  07:E7F9            .set_pitch:
  559                     
  560  07:E7F9  9D B0 03      sta stream_pe_offset, x      ;get current vol/duty settings
  561  07:E7FC  8D 03 03          STA sound_temp2
  562  07:E7FF  AC 02 03          LDY sound_temp1
  563  07:E802  AD 03 03          LDA sound_temp2
  564  07:E805  10 1D             BPL .add_pitch
  565                             
  566  07:E807            .sub_pitch:
  567                             
  568  07:E807  49 FF             EOR #$FF        ;flip bits
  569  07:E809  18                CLC
  570  07:E80A  69 01             ADC #$01        ;add one - two's compliment
  571  07:E80C  8D 03 03          STA sound_temp2
  572                             
  573  07:E80F  B9 08 03          LDA soft_apu_ports+2, y       
  574  07:E812  38                SEC
  575  07:E813  ED 03 03          SBC sound_temp2
  576  07:E816  99 08 03          STA soft_apu_ports+2, y
  577  07:E819  B9 09 03          LDA soft_apu_ports+3, y
  578  07:E81C  E9 00             SBC #$00
  579  07:E81E  99 09 03          STA soft_apu_ports+3, y
  580                             
  581  07:E821  4C 36 E8          JMP .finish_pitchShift
  582                     
  583  07:E824            .add_pitch:
  584                     
  585  07:E824  B9 08 03      LDA soft_apu_ports+2, y       
  586  07:E827  18                CLC
  587  07:E828  6D 03 03          ADC sound_temp2
  588  07:E82B  99 08 03          STA soft_apu_ports+2, y
  589  07:E82E  B9 09 03          LDA soft_apu_ports+3, y
  590  07:E831  69 00             ADC #$00
  591  07:E833  99 09 03          STA soft_apu_ports+3, y
  592                             
  593  07:E836            .finish_pitchShift:
  594  07:E836  FE A8 03      inc stream_pe_index, x      ;set our volume envelop index to the next position
  595                     
  596  07:E839            .rest_check:
  597                         ;check the rest flag. if set, overwrite volume with silence value 
  598  07:E839  BD 22 03      lda stream_status, x
  599  07:E83C  29 02         and #%00000010
  600  07:E83E  F0 05         beq .done                   ;if clear, no rest, so quit
  601                        
  602  07:E840  A9 00         LDA #$00
  603  07:E842  9D B0 03          STA stream_pe_offset, x
  604  07:E845            .done:
  605  07:E845  60            rts    
