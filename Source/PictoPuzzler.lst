   32                     ;-------------------------------------
   33                     ; load_sound will prepare the sound engine to play a song or sfx.
   34                     ;   input:
   35                     ;       A: song/sfx number to play
   36  07:E4D5            sound_load:
   37  07:E4D5  8D 02 03      sta sound_temp1         ;save song number
   38  07:E4D8  0A            asl a                   ;multiply by 2.  We are indexing into a table of pointers (words)
   39  07:E4D9  A8            tay
   40  07:E4DA  B9 B9 E8      lda song_headers, y     ;setup the pointer to our song header
   41  07:E4DD  8D DF 00      sta sound_ptr
   42  07:E4E0  B9 BA E8      lda song_headers+1, y
   43  07:E4E3  8D E0 00      sta sound_ptr+1
   44                         
   45  07:E4E6  A0 00         ldy #$00
   46  07:E4E8  B1 DF         lda [sound_ptr], y      ;read the first byte: # streams
   47  07:E4EA  8D 03 03      sta sound_temp2         ;store in a temp variable.  We will use this as a loop counter: how many streams to read stream headers for
   48  07:E4ED  C8            iny
   49  07:E4EE            .loop:
   50  07:E4EE  B1 DF         lda [sound_ptr], y      ;stream number
   51  07:E4F0  AA            tax                     ;stream number acts as our variable index
   52  07:E4F1  C8            iny
   53                         
   54  07:E4F2  B1 DF         lda [sound_ptr], y      ;status byte.  1= enable, 0=disable
   55  07:E4F4  9D 22 03      sta stream_status, x
   56  07:E4F7  F0 49         beq .next_stream        ;if status byte is 0, stream disabled, so we are done
   57  07:E4F9  C8            iny
   58                         
   59  07:E4FA  B1 DF         lda [sound_ptr], y      ;channel number
   60  07:E4FC  9D 2A 03      sta stream_channel, x
   61  07:E4FF  C8            iny
   62                         
   63  07:E500  B1 DF         lda [sound_ptr], y      ;initial duty and volume settings
   64  07:E502  9D 52 03      sta stream_vol_duty, x
   65  07:E505  C8            iny
   66                         
   67  07:E506  B1 DF         lda [sound_ptr], y
   68  07:E508  9D 42 03      sta stream_ve, x
   69  07:E50B  C8            iny
   70                             
   71                             ;temp solution
   72  07:E50C  A9 00             lda #me_none
   73  07:E50E  9D A0 03          sta stream_pe, x
   74                             
   75                             ;temp solution
   76  07:E511  A9 00             lda #arp_none
   77  07:E513  9D C0 03          sta stream_arp, x
   78                         
   79  07:E516  B1 DF         lda [sound_ptr], y      ;pointer to stream data.  Little endian, so low byte first
   80  07:E518  9D 32 03      sta stream_ptr_LO, x
   81  07:E51B  C8            iny
   82                         
   83  07:E51C  B1 DF         lda [sound_ptr], y
   84  07:E51E  9D 3A 03      sta stream_ptr_HI, x
   85  07:E521  C8            iny
   86                         
   87  07:E522  B1 DF         lda [sound_ptr], y
   88  07:E524  9D 72 03      sta stream_tempo, x
   89                         
   90  07:E527  A9 A0         lda #$A0
   91  07:E529  9D 7A 03      sta stream_ticker_total, x
   92                         
   93  07:E52C  A9 01         lda #$01
   94  07:E52E  9D 82 03      sta stream_note_length_counter,x
   95                         
   96  07:E531  A9 00         lda #$00
   97  07:E533  9D 4A 03      sta stream_ve_index, x
   98  07:E536  9D A8 03          sta stream_pe_index, x
   99  07:E539  9D C8 03          sta stream_arp_index, x
  100  07:E53C  9D 92 03      sta stream_loop1, x
  101  07:E53F  9D 9A 03      sta stream_note_offset, x
  102  07:E542            .next_stream:
  103  07:E542  C8            iny
  104                         
  105  07:E543  AD 02 03      lda sound_temp1         ;song number
  106  07:E546  9D 1A 03      sta stream_curr_sound, x
  107                         
  108  07:E549  CE 03 03      dec sound_temp2         ;our loop counter
  109  07:E54C  D0 A0         bne .loop
  110  07:E54E  60            rts
