    2  06:D709            NMI:
    3                     
    4  06:D709  48          PHA                              ;protect the registers
    5  06:D70A  8A          TXA
    6  06:D70B  48          PHA
    7  06:D70C  98          TYA
    8  06:D70D  48          PHA
    9                       
   10  06:D70E            nmi_started:
   11  06:D70E  A9 00       LDA #$00
   12  06:D710  8D 03 20    STA OAM_LO      ; set the low byte (00) of the RAM address
   13  06:D713  A9 02       LDA #$02
   14  06:D715  8D 14 40    STA OAM_HI       ; set the high byte (02) of the RAM address, start the transfer
   15                     
   16  06:D718  AD 10 00    LDA NMI_locks
   17  06:D71B  F0 03       BEQ update_controllers
   18  06:D71D  4C 5D D7    JMP WakeUp
