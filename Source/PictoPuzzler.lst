  404  06:D576            FadeOutPalettes:
  405                     
  406                     ;;take the current values, and decrement the lower nibbles
  407                     ;;we can access from the palette copy 
  408                     ;;we'll make this fade out one level per call
  409                     ;;once all the palettes are blacked out we'll return true, so we'll keep the carry flag as a return result
  410                     
  411                     ;;go through the palette copy, decrement, make a raw data PPU string and add all the bytes into it
  412                     ;;for any palette color already in the 0x range, change it to 0f to get black
  413                     
  414                       MACROGetLabelPointer Palette_Copy, table_address
                          
       06:D576  A9 6C             LDA #HIGH(Palette_Copy)
       06:D578  A2 00             LDX #LOW(Palette_Copy)
                                  
       06:D57A  8E 18 00          STX table_address
       06:D57D  8D 19 00          STA table_address+1
                                  
  415                     ;;palette copy address is now X accessable
  416                     
  417  06:D580  A0 00       LDY #$00
  418                       MACROAddPPUStringEntryRawData #$3F, #$00, #DRAW_HORIZONTAL, #$20  
                          
       06:D582  A9 01       LDA #$01
       06:D584  8D 2D 00    STA PPU_PendingWrite
       06:D587  A9 3F       LDA #$3F
       06:D589  20 83 D4    JSR WriteToPPUString
       06:D58C  A9 00       LDA #$00
       06:D58E  20 83 D4    JSR WriteToPPUString
       06:D591  A9 00       LDA #DRAW_HORIZONTAL
       06:D593  20 83 D4    JSR WriteToPPUString
       06:D596  A9 20       LDA #$20 
       06:D598  20 83 D4    JSR WriteToPPUString
                            
