#[3]   Source/External/SoundEngine/Source/sound_opcodes.asm
  654                         .include "Source/External/SoundEngine/Source/sound_opcodes.asm"    ;our opcode subroutines, jump table and aliases
    1                     ;these are aliases to use in the sound data.
    2           00A0      endsound = $A0
    3           00A1      loop = $A1
    4           00A2      volume_envelope = $A2
    5           00A3      duty = $A3
    6           00A4      set_loop1_counter = $A4
    7           00A5      loop1 = $A5
    8           00A6      set_note_offset = $A6
    9           00A7      adjust_note_offset = $A7
   10           00A8      transpose = $A8
   11           00A9      pitch_envelope = $A9
   12           00AA      arpeggio = $AA
   13                     
   14                     ;-----------------------------------------------------------------------
   15                     ;this is our JUMP TABLE!
   16  07:E938            sound_opcodes:
   17  07:E938  4E E9         .word se_op_endsound            ;$A0
   18  07:E93A  67 E9         .word se_op_infinite_loop       ;$A1
   19  07:E93C  7E E9         .word se_op_change_ve           ;$A2
   20  07:E93E  89 E9         .word se_op_duty                ;$A3
   21  07:E940  8F E9         .word se_op_set_loop1_counter   ;$A4
   22  07:E942  95 E9         .word se_op_loop1               ;$A5
   23  07:E944  A2 E9         .word se_op_set_note_offset     ;$A6
   24  07:E946  A8 E9         .word se_op_adjust_note_offset  ;$A7
   25  07:E948  B2 E9         .word se_op_transpose           ;$A8
   26  07:E94A  D2 E9             .word se_op_change_pe                   ;$A9
   27  07:E94C  E0 E9             .word se_op_change_arp
   28                         ;etc, 1 entry per subroutine
   29                     
   30                         
   31                     ;-----------------------------------------------------------------
   32                     ; these are the actual opcode subroutines
   33  07:E94E            se_op_endsound:
   34  07:E94E  BD 22 03      lda stream_status, x    ;end of stream, so disable it and silence
   35  07:E951  29 FE         and #%11111110
   36  07:E953  9D 22 03      sta stream_status, x    ;clear enable flag in status byte
   37                         
   38  07:E956  BD 2A 03      lda stream_channel, x
   39  07:E959  C9 02         cmp #TRIANGLE
   40  07:E95B  F0 04         beq .silence_tri        ;triangle is silenced differently from squares and noise
   41  07:E95D  A9 30         lda #$30                ;squares and noise silenced with #$30
   42  07:E95F  D0 02         bne .silence            ; (this will always branch.  bne is cheaper than a jmp)
   43  07:E961            .silence_tri:
   44  07:E961  A9 80         lda #$80                ;triangle silenced with #$80
   45  07:E963            .silence:
   46  07:E963  9D 52 03      sta stream_vol_duty, x  ;store silence value in the stream's volume variable.
   47                     
   48  07:E966  60            rts
   49                         
   50  07:E967            se_op_infinite_loop:
   51  07:E967  B1 DC         lda [sound_ptr], y      ;read ptr LO from the data stream
   52  07:E969  9D 32 03      sta stream_ptr_LO, x    ;update our data stream position
   53  07:E96C  C8            iny
   54  07:E96D  B1 DC         lda [sound_ptr], y      ;read ptr HI from the data stream
   55  07:E96F  9D 3A 03      sta stream_ptr_HI, x    ;update our data stream position
   56                         
   57  07:E972  8D DD 00      sta sound_ptr+1         ;update the pointer to reflect the new position.
   58  07:E975  BD 32 03      lda stream_ptr_LO, x
   59  07:E978  8D DC 00      sta sound_ptr
   60  07:E97B  A0 FF         ldy #$FF                ;after opcodes return, we do an iny.  Since we reset  
   61                                                 ;the stream buffer position, we will want y to start out at 0 again.
   62  07:E97D  60            rts
   63                         
   64  07:E97E            se_op_change_ve:
   65  07:E97E  B1 DC         lda [sound_ptr], y      ;read the argument
   66  07:E980  9D 42 03      sta stream_ve, x        ;store it in our volume envelope variable
   67  07:E983  A9 00         lda #$00
   68  07:E985  9D 4A 03      sta stream_ve_index, x  ;reset volume envelope index to the beginning
   69  07:E988  60            rts
   70                         
   71  07:E989            se_op_duty:
   72  07:E989  B1 DC         lda [sound_ptr], y
   73  07:E98B  9D 52 03      sta stream_vol_duty, x
   74  07:E98E  60            rts
   75                         
   76  07:E98F            se_op_set_loop1_counter:
   77  07:E98F  B1 DC         lda [sound_ptr], y      ;read the argument (# times to loop)
   78  07:E991  9D 92 03      sta stream_loop1, x     ;store it in the loop counter variable
   79  07:E994  60            rts
   80                         
   81  07:E995            se_op_loop1:
   82  07:E995  DE 92 03      dec stream_loop1, x     ;decrement the counter
   83  07:E998  BD 92 03      lda stream_loop1, x
   84  07:E99B  F0 03         beq .last_iteration     ;if zero, we are done looping
   85  07:E99D  4C 67 E9      jmp se_op_infinite_loop ;if not zero, jump back
   86  07:E9A0            .last_iteration:
   87  07:E9A0  C8            iny                     ;skip the first byte of the address argument
   88                                                 ; the second byte will be skipped automatically upon return
   89                                                 ; (see se_fetch_byte after "jsr se_opcode_launcher")
   90  07:E9A1  60            rts
   91                         
   92  07:E9A2            se_op_set_note_offset:
   93  07:E9A2  B1 DC         lda [sound_ptr], y          ;read the argument
   94  07:E9A4  9D 9A 03      sta stream_note_offset, x      ;set the note offset.
   95  07:E9A7  60            rts
   96                         
   97  07:E9A8            se_op_adjust_note_offset:
   98  07:E9A8  B1 DC         lda [sound_ptr], y          ;read the argument (what value to add)
   99  07:E9AA  18            clc
  100  07:E9AB  7D 9A 03      adc stream_note_offset, x   ;add it to the current offset
  101  07:E9AE  9D 9A 03      sta stream_note_offset, x   ;and save.
  102  07:E9B1  60            rts
  103                         
  104  07:E9B2            se_op_transpose:
  105  07:E9B2  B1 DC         lda [sound_ptr], y          ;read low byte of the pointer to our lookup table
  106  07:E9B4  8D DE 00      sta sound_ptr2              ;store it in a new pointer variable
  107  07:E9B7  C8            iny
  108  07:E9B8  B1 DC         lda [sound_ptr], y          ;read high byte of pointer to table
  109  07:E9BA  8D DF 00      sta sound_ptr2+1
  110                         
  111  07:E9BD  8C 02 03      sty sound_temp1             ;save y because we are about to destroy it
  112  07:E9C0  BD 92 03      lda stream_loop1, x         ;get loop counter, put it in Y
  113  07:E9C3  A8            tay                         ;   this will be our index into the lookup table
  114  07:E9C4  88            dey                         ;subtract 1 because indexes start from 0.
  115                         
  116  07:E9C5  B1 DE         lda [sound_ptr2], y         ;read a value from the table.
  117  07:E9C7  18            clc
  118  07:E9C8  7D 9A 03      adc stream_note_offset, x   ;add it to the note offset
  119  07:E9CB  9D 9A 03      sta stream_note_offset, x
  120                         
  121  07:E9CE  AC 02 03      ldy sound_temp1             ;restore Y
  122  07:E9D1  60            rts
  123                             
  124  07:E9D2            se_op_change_pe:
  125  07:E9D2  B1 DC         lda [sound_ptr], y      ;read the argument
  126  07:E9D4  9D A0 03      sta stream_pe, x        ;store it in our volume envelope variable
  127  07:E9D7  A9 00         lda #$00
  128  07:E9D9  9D A8 03      sta stream_pe_index, x  ;reset volume envelope index to the beginning
  129  07:E9DC  9D B8 03          sta stream_pe_delay, x
  130  07:E9DF  60            rts
  131                             
  132  07:E9E0            se_op_change_arp:
  133  07:E9E0  B1 DC             lda [sound_ptr], y
  134  07:E9E2  9D C0 03          sta stream_arp, x
  135  07:E9E5  A9 00             lda #$00
  136  07:E9E7  9D C8 03          sta stream_arp_index, x
  137  07:E9EA  60                rts
