    9                       
   10                     ;;now, set up the controls for the mapper
   11                     ;;4bit0
   12                     ;;-----
   13                     ;;CPPMM
   14                     ;;|||||
   15                     ;;|||++- Mirroring (0: one-screen, lower bank; 1: one-screen, upper bank;
   16                     ;;|||               2: vertical; 3: horizontal)
   17                     ;;|++--- PRG ROM bank mode (0, 1: switch 32 KB at $8000, ignoring low bit of bank number;
   18                     ;;|                         2: fix first bank at $8000 and switch 16 KB bank at $C000;
   19                     ;;|                         3: fix last bank at $C000 and switch 16 KB bank at $8000)
   20                     ;;+----- CHR ROM bank mode (0: switch 8 KB at a time; 1: switch two separate 4 KB banks)
   21                        
   22  06:D702            SetMapperControls:
   23                       ;;A = controls
   24  06:D702  AA          TAX
   25  06:D703  A9 80       LDA #MAPPERCONTROL
   26  06:D705  8D B0 00    STA mapper_address+1
   27  06:D708  8A          TXA
   28  06:D709  20 2E D7    JSR SendMapperCommand
   29  06:D70C  60          RTS
   30                     
   31  06:D70D            LoadPRGBank:
   32                     
   33                             ;;A is the desired PRG number
   34  06:D70D  AA                TAX
   35  06:D70E  A9 E0             LDA #PRGBANK
   36  06:D710  8D B0 00          STA mapper_address+1
   37  06:D713  8A                TXA
   38  06:D714  20 2E D7          JSR SendMapperCommand
   39  06:D717  60                RTS
   40                             
   41  06:D718            LoadCHRBankA:
