  331  06:D50F  AD 02 20    LDA PPU_STATUS                        ;; load the PPU status to reset the write register
  332  06:D512  68          PLA                                           ;; Retrieve index
  333  06:D513  0A          ASL A                                         ;; double it (indexing a 2 byte table)
  334  06:D514  AA          TAX                                           ;; put it in X
  335  06:D515  BD C9 D5    LDA NameTableMemList+1, x     ;; get the nametable from the list, store it in the PPU Address
  336  06:D518  8D 06 20    STA PPU_ADDR                          
