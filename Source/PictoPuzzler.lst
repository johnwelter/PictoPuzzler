    9  06:DA9B            .reRead:
   10  06:DA9B  AD 24 00          LDA gamepad
   11  06:DA9E  48                PHA
   12  06:DA9F  20 BE DA          JSR ReadControllers
   13  06:DAA2  68                PLA 
   14  06:DAA3  CD 24 00          CMP gamepad
   15  06:DAA6  D0 F3             BNE .reRead
   16                             
   17  06:DAA8            .finishARead:
   18                             ;;comapre last to current, find the pressed buttons this frame
   19  06:DAA8  AD 25 00          LDA gamepadLast
   20  06:DAAB  49 FF             EOR #$FF
   21  06:DAAD  2D 24 00          AND gamepad
   22  06:DAB0  8D 26 00          STA gamepadPressed
   23                             
   24                             
   25  06:DAB3  AD 24 00          LDA gamepad
   26  06:DAB6  8D 25 00          STA gamepadLast
   27                             
   28  06:DAB9  68                PLA
   29  06:DABA  A8                TAY
   30  06:DABB  68                PLA
   31  06:DABC  AA                TAX     
