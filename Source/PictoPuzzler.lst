  380  06:D2F9            FadeOutPalettes:
  381                     
  382                     ;;take the current values, and decrement the lower nibbles
  383                     ;;we can access from the palette copy 
  384                     ;;we'll make this fade out one level per call
  385                     ;;once all the palettes are blacked out we'll return true, so we'll keep the carry flag as a return result
  386                     
  387                     ;;go through the palette copy, decrement, make a raw data PPU string and add all the bytes into it
  388                     ;;for any palette color already in the 0x range, change it to 0f to get black
  389                     
  390                       MACROGetLabelPointer Palette_Copy, table_address
                          
       06:D2F9  A9 6C             LDA #HIGH(Palette_Copy)
       06:D2FB  A2 00             LDX #LOW(Palette_Copy)
                                  
       06:D2FD  8E 18 00          STX table_address
       06:D300  8D 19 00          STA table_address+1
                                  
  391                     ;;palette copy address is now X accessable
  392                     
  393  06:D303  A0 00       LDY #$00
  394                       MACROAddPPUStringEntryRawData #$3F, #$00, #DRAW_HORIZONTAL, #$20  
                          
       06:D305  A9 01       LDA #$01
       06:D307  8D 2D 00    STA PPU_PendingWrite
       06:D30A  A9 3F       LDA #$3F
       06:D30C  20 1D D2    JSR WriteToPPUString
       06:D30F  A9 00       LDA #$00
       06:D311  20 1D D2    JSR WriteToPPUString
       06:D314  A9 00       LDA #DRAW_HORIZONTAL
       06:D316  20 1D D2    JSR WriteToPPUString
       06:D319  A9 20       LDA #$20 
       06:D31B  20 1D D2    JSR WriteToPPUString
                            
