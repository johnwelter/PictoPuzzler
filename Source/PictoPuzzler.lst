       07:E46F  60        
   44  07:E470  9B FF 00          .db $9B,$FF,$00,$A4
       07:E473  A4        
   45  07:E474  9B FF 00          .db $9B,$FF,$00,$AC
       07:E477  AC        
   46  07:E478  A3 FF 00          .db $A3,$FF,$00,$A4
       07:E47B  A4        
   47  07:E47C  A3 FF 00          .db $A3,$FF,$00,$AC
       07:E47F  AC        
