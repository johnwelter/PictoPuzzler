#[3]   Source/External/SoundEngine/Source/sound_opcodes.asm
  654                         .include "Source/External/SoundEngine/Source/sound_opcodes.asm"    ;our opcode subroutines, jump table and aliases
    1                     ;these are aliases to use in the sound data.
    2           00A0      endsound = $A0
    3           00A1      loop = $A1
    4           00A2      volume_envelope = $A2
    5           00A3      duty = $A3
    6           00A4      set_loop1_counter = $A4
    7           00A5      loop1 = $A5
    8           00A6      set_note_offset = $A6
    9           00A7      adjust_note_offset = $A7
   10           00A8      transpose = $A8
   11           00A9      pitch_envelope = $A9
   12           00AA      arpeggio = $AA
   13                     
   14                     ;-----------------------------------------------------------------------
   15                     ;this is our JUMP TABLE!
   16  07:EB1E            sound_opcodes:
   17  07:EB1E  34 EB         .word se_op_endsound            ;$A0
   18  07:EB20  4D EB         .word se_op_infinite_loop       ;$A1
   19  07:EB22  64 EB         .word se_op_change_ve           ;$A2
   20  07:EB24  6F EB         .word se_op_duty                ;$A3
   21  07:EB26  75 EB         .word se_op_set_loop1_counter   ;$A4
   22  07:EB28  7B EB         .word se_op_loop1               ;$A5
   23  07:EB2A  88 EB         .word se_op_set_note_offset     ;$A6
   24  07:EB2C  8E EB         .word se_op_adjust_note_offset  ;$A7
   25  07:EB2E  98 EB         .word se_op_transpose           ;$A8
   26  07:EB30  B8 EB             .word se_op_change_pe                   ;$A9
   27  07:EB32  C6 EB             .word se_op_change_arp
   28                         ;etc, 1 entry per subroutine
   29                     
   30                         
   31                     ;-----------------------------------------------------------------
   32                     ; these are the actual opcode subroutines
   33  07:EB34            se_op_endsound:
   34  07:EB34  BD 22 03      lda stream_status, x    ;end of stream, so disable it and silence
   35  07:EB37  29 FE         and #%11111110
   36  07:EB39  9D 22 03      sta stream_status, x    ;clear enable flag in status byte
   37                         
   38  07:EB3C  BD 2A 03      lda stream_channel, x
   39  07:EB3F  C9 02         cmp #TRIANGLE
   40  07:EB41  F0 04         beq .silence_tri        ;triangle is silenced differently from squares and noise
   41  07:EB43  A9 30         lda #$30                ;squares and noise silenced with #$30
   42  07:EB45  D0 02         bne .silence            ; (this will always branch.  bne is cheaper than a jmp)
   43  07:EB47            .silence_tri:
   44  07:EB47  A9 80         lda #$80                ;triangle silenced with #$80
   45  07:EB49            .silence:
   46  07:EB49  9D 52 03      sta stream_vol_duty, x  ;store silence value in the stream's volume variable.
   47                     
   48  07:EB4C  60            rts
   49                         
   50  07:EB4D            se_op_infinite_loop:
   51  07:EB4D  B1 DF         lda [sound_ptr], y      ;read ptr LO from the data stream
   52  07:EB4F  9D 32 03      sta stream_ptr_LO, x    ;update our data stream position
   53  07:EB52  C8            iny
   54  07:EB53  B1 DF         lda [sound_ptr], y      ;read ptr HI from the data stream
   55  07:EB55  9D 3A 03      sta stream_ptr_HI, x    ;update our data stream position
   56                         
   57  07:EB58  8D E0 00      sta sound_ptr+1         ;update the pointer to reflect the new position.
   58  07:EB5B  BD 32 03      lda stream_ptr_LO, x
   59  07:EB5E  8D DF 00      sta sound_ptr
   60  07:EB61  A0 FF         ldy #$FF                ;after opcodes return, we do an iny.  Since we reset  
   61                                                 ;the stream buffer position, we will want y to start out at 0 again.
   62  07:EB63  60            rts
   63                         
   64  07:EB64            se_op_change_ve:
   65  07:EB64  B1 DF         lda [sound_ptr], y      ;read the argument
   66  07:EB66  9D 42 03      sta stream_ve, x        ;store it in our volume envelope variable
   67  07:EB69  A9 00         lda #$00
   68  07:EB6B  9D 4A 03      sta stream_ve_index, x  ;reset volume envelope index to the beginning
   69  07:EB6E  60            rts
   70                         
   71  07:EB6F            se_op_duty:
   72  07:EB6F  B1 DF         lda [sound_ptr], y
   73  07:EB71  9D 52 03      sta stream_vol_duty, x
   74  07:EB74  60            rts
   75                         
   76  07:EB75            se_op_set_loop1_counter:
   77  07:EB75  B1 DF         lda [sound_ptr], y      ;read the argument (# times to loop)
   78  07:EB77  9D 92 03      sta stream_loop1, x     ;store it in the loop counter variable
   79  07:EB7A  60            rts
   80                         
   81  07:EB7B            se_op_loop1:
   82  07:EB7B  DE 92 03      dec stream_loop1, x     ;decrement the counter
   83  07:EB7E  BD 92 03      lda stream_loop1, x
   84  07:EB81  F0 03         beq .last_iteration     ;if zero, we are done looping
   85  07:EB83  4C 4D EB      jmp se_op_infinite_loop ;if not zero, jump back
   86  07:EB86            .last_iteration:
   87  07:EB86  C8            iny                     ;skip the first byte of the address argument
   88                                                 ; the second byte will be skipped automatically upon return
   89                                                 ; (see se_fetch_byte after "jsr se_opcode_launcher")
   90  07:EB87  60            rts
   91                         
   92  07:EB88            se_op_set_note_offset:
   93  07:EB88  B1 DF         lda [sound_ptr], y          ;read the argument
   94  07:EB8A  9D 9A 03      sta stream_note_offset, x      ;set the note offset.
   95  07:EB8D  60            rts
   96                         
   97  07:EB8E            se_op_adjust_note_offset:
   98  07:EB8E  B1 DF         lda [sound_ptr], y          ;read the argument (what value to add)
   99  07:EB90  18            clc
  100  07:EB91  7D 9A 03      adc stream_note_offset, x   ;add it to the current offset
  101  07:EB94  9D 9A 03      sta stream_note_offset, x   ;and save.
  102  07:EB97  60            rts
  103                         
  104  07:EB98            se_op_transpose:
  105  07:EB98  B1 DF         lda [sound_ptr], y          ;read low byte of the pointer to our lookup table
  106  07:EB9A  8D E1 00      sta sound_ptr2              ;store it in a new pointer variable
  107  07:EB9D  C8            iny
  108  07:EB9E  B1 DF         lda [sound_ptr], y          ;read high byte of pointer to table
  109  07:EBA0  8D E2 00      sta sound_ptr2+1
  110                         
  111  07:EBA3  8C 02 03      sty sound_temp1             ;save y because we are about to destroy it
  112  07:EBA6  BD 92 03      lda stream_loop1, x         ;get loop counter, put it in Y
  113  07:EBA9  A8            tay                         ;   this will be our index into the lookup table
  114  07:EBAA  88            dey                         ;subtract 1 because indexes start from 0.
  115                         
  116  07:EBAB  B1 E1         lda [sound_ptr2], y         ;read a value from the table.
  117  07:EBAD  18            clc
  118  07:EBAE  7D 9A 03      adc stream_note_offset, x   ;add it to the note offset
  119  07:EBB1  9D 9A 03      sta stream_note_offset, x
  120                         
  121  07:EBB4  AC 02 03      ldy sound_temp1             ;restore Y
  122  07:EBB7  60            rts
  123                             
  124  07:EBB8            se_op_change_pe:
  125  07:EBB8  B1 DF         lda [sound_ptr], y      ;read the argument
  126  07:EBBA  9D A0 03      sta stream_pe, x        ;store it in our volume envelope variable
  127  07:EBBD  A9 00         lda #$00
  128  07:EBBF  9D A8 03      sta stream_pe_index, x  ;reset volume envelope index to the beginning
  129  07:EBC2  9D B8 03          sta stream_pe_delay, x
  130  07:EBC5  60            rts
  131                             
  132  07:EBC6            se_op_change_arp:
  133  07:EBC6  B1 DF             lda [sound_ptr], y
  134  07:EBC8  9D C0 03          sta stream_arp, x
  135  07:EBCB  A9 00             lda #$00
  136  07:EBCD  9D C8 03          sta stream_arp_index, x
  137  07:EBD0  60                rts
