    9                       
   10                     ;;now, set up the controls for the mapper
   11                     ;;4bit0
   12                     ;;-----
   13                     ;;CPPMM
   14                     ;;|||||
   15                     ;;|||++- Mirroring (0: one-screen, lower bank; 1: one-screen, upper bank;
   16                     ;;|||               2: vertical; 3: horizontal)
   17                     ;;|++--- PRG ROM bank mode (0, 1: switch 32 KB at $8000, ignoring low bit of bank number;
   18                     ;;|                         2: fix first bank at $8000 and switch 16 KB bank at $C000;
   19                     ;;|                         3: fix last bank at $C000 and switch 16 KB bank at $8000)
   20                     ;;+----- CHR ROM bank mode (0: switch 8 KB at a time; 1: switch two separate 4 KB banks)
   21                        
   22  06:D394            SetMapperControls:
   23                       ;;A = controls
   24  06:D394  AA          TAX
   25  06:D395  A9 80       LDA #MAPPERCONTROL
   26  06:D397  8D B0 00    STA mapper_address+1
   27  06:D39A  8A          TXA
   28  06:D39B  20 C0 D3    JSR SendMapperCommand
   29  06:D39E  60          RTS
   30                     
   31  06:D39F            LoadPRGBank:
   32                     
   33                             ;;A is the desired PRG number
   34  06:D39F  AA                TAX
   35  06:D3A0  A9 E0             LDA #PRGBANK
   36  06:D3A2  8D B0 00          STA mapper_address+1
   37  06:D3A5  8A                TXA
   38  06:D3A6  20 C0 D3          JSR SendMapperCommand
   39  06:D3A9  60                RTS
   40                             
   41  06:D3AA            LoadCHRBankA:
   42                             ;;A is the desired CHR bank
   43  06:D3AA  AA                TAX
   44  06:D3AB  A9 A0             LDA #CHRBANK1
   45  06:D3AD  8D B0 00          STA mapper_address+1
   46  06:D3B0  8A                TXA
   47  06:D3B1  20 C0 D3          JSR SendMapperCommand
   48  06:D3B4  60                RTS
   49                             
   50  06:D3B5            LoadCHRBankB:
   51                             ;;A is the desired CHR bank
   52  06:D3B5  AA                TAX
   53  06:D3B6  A9 C0             LDA #CHRBANK2
   54  06:D3B8  8D B0 00          STA mapper_address+1
   55  06:D3BB  8A                TXA
   56  06:D3BC  20 C0 D3          JSR SendMapperCommand
   57  06:D3BF  60                RTS
   58                             
   59  06:D3C0            SendMapperCommand:
   60                     
   61  06:D3C0  A0 00             LDY #$00
   62                             
   63  06:D3C2  91 AF             STA [mapper_address], y
   64  06:D3C4  4A                LSR A
   65  06:D3C5  91 AF             STA [mapper_address], y
   66  06:D3C7  4A                LSR A
   67  06:D3C8  91 AF             STA [mapper_address], y
   68  06:D3CA  4A                LSR A 
   69  06:D3CB  91 AF             STA [mapper_address], y
   70  06:D3CD  4A                LSR A
   71  06:D3CE  91 AF             STA [mapper_address], y
   72                             
   73  06:D3D0  60                RTS
   74                             
   75  06:D3D1            ResetBanks:
   76                     
   77  06:D3D1  20 90 D3          JSR ResetMapper
   78  06:D3D4  A9 00             LDA #$00
   79  06:D3D6  20 9F D3          JSR LoadPRGBank
   80                       
   81                             ;;as a test, load up the initial CHR banks
   82  06:D3D9  20 90 D3          JSR ResetMapper
   83  06:D3DC  A9 00             LDA #$00
   84  06:D3DE  20 AA D3          JSR LoadCHRBankA
   85  06:D3E1  A9 01             LDA #$01
   86  06:D3E3  20 B5 D3          JSR LoadCHRBankB
   87  06:D3E6  60                RTS
