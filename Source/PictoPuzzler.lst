   25                       ; enable NMI, sprites from Pattern Table 0, background from Pattern Table 1
   26                       ; enable sprites, enable background, no clipping on left side 
   27  06:DDF3  A9 00       LDA #$00        ;;tell the ppu there is no background scrolling
   28  06:DDF5  8D 05 20    STA PPU_SCROLL
   29  06:DDF8  8D 05 20    STA PPU_SCROLL
   30  06:DDFB  20 7F D6    JSR UpdatePPUMask
