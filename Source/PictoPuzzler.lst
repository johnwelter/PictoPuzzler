  150                     ;--------------------------
  151                     ; se_fetch_byte reads one byte from a sound data stream and handles it
  152                     ;   input: 
  153                     ;       X: stream number    
  154  07:E586            se_fetch_byte:
  155  07:E586  BD 32 03      lda stream_ptr_LO, x
  156  07:E589  8D DF 00      sta sound_ptr
  157  07:E58C  BD 3A 03      lda stream_ptr_HI, x
  158  07:E58F  8D E0 00      sta sound_ptr+1
  159                         
  160  07:E592  A0 00         ldy #$00
  161  07:E594            .fetch:
  162  07:E594  B1 DF         lda [sound_ptr], y
  163  07:E596  10 26         bpl .note                ;if < #$80, it's a Note
  164  07:E598  C9 A0         cmp #$A0
  165  07:E59A  90 0C         bcc .note_length         ;else if < #$A0, it's a Note Length
  166  07:E59C            .opcode:                     ;else it's an opcode
  167                         ;do Opcode stuff
  168  07:E59C  20 A6 E6      jsr se_opcode_launcher
  169  07:E59F  C8            iny                      ;next position in the data stream
  170  07:E5A0  BD 22 03      lda stream_status, x
  171  07:E5A3  29 01         and #%00000001
  172  07:E5A5  D0 ED         bne .fetch               ;after our opcode is done, grab another byte unless the stream is disabled
  173  07:E5A7  60            rts                      ; in which case we quit  (explained below)
  174  07:E5A8            .note_length:
  175                         ;do note length stuff
  176  07:E5A8  29 7F         and #%01111111          ;chop off bit7
  177  07:E5AA  8C 02 03      sty sound_temp1         ;save Y because we are about to destroy it
  178  07:E5AD  A8            tay
  179  07:E5AE  B9 8F EC      lda note_length_table, y    ;get the note length count value
  180  07:E5B1  9D 8A 03      sta stream_note_length, x
  181  07:E5B4  9D 82 03      sta stream_note_length_counter, x   ;stick it in our note length counter
  182  07:E5B7  AC 02 03      ldy sound_temp1         ;restore Y
  183  07:E5BA  C8            iny                     ;set index to next byte in the stream
  184  07:E5BB  4C 94 E5      jmp .fetch              ;fetch another byte
  185  07:E5BE            .note:
  186                         ;do Note stuff
  187  07:E5BE  8D 03 03      sta sound_temp2
  188  07:E5C1  BD 2A 03      lda stream_channel, x
  189  07:E5C4  C9 03         cmp #NOISE
  190  07:E5C6  D0 06         bne .not_noise
  191  07:E5C8  20 16 E6      jsr se_do_noise
  192  07:E5CB  4C F9 E5      jmp .reset_ve
  193  07:E5CE            .not_noise:
  194  07:E5CE  C9 04             cmp #DPMC
  195  07:E5D0  90 06             bcc .not_dpmc
  196  07:E5D2  20 4E E6          jsr se_do_dpmc
  197  07:E5D5  4C F9 E5          jmp .reset_ve
  198  07:E5D8            .not_dpmc:
  199  07:E5D8  AD 03 03      lda sound_temp2
  200  07:E5DB  8C 02 03      sty sound_temp1     ;save our index into the data stream
  201  07:E5DE  18            clc
  202  07:E5DF  7D 9A 03      adc stream_note_offset, x   ;add note offset
  203  07:E5E2  0A            asl a
  204  07:E5E3  A8            tay
  205  07:E5E4  9D 5A 03          sta stream_note_idx, x
  206  07:E5E7  B9 D1 EB      lda note_table, y
  207  07:E5EA  9D 62 03      sta stream_note_LO, x
  208  07:E5ED  B9 D2 EB      lda note_table+1, y
  209  07:E5F0  9D 6A 03      sta stream_note_HI, x
  210  07:E5F3  AC 02 03      ldy sound_temp1     ;restore data stream index
  211                         
  212                         ;check if it's a rest and modify the status flag appropriately
  213                     
  214  07:E5F6  20 90 E6      jsr se_check_rest
  215  07:E5F9            .reset_ve:    
  216  07:E5F9  A9 00         lda #$00
  217  07:E5FB  9D 4A 03      sta stream_ve_index, x  
  218  07:E5FE  9D A8 03          sta stream_pe_index, x
  219  07:E601  9D B8 03          sta stream_pe_delay, x
  220  07:E604  9D C8 03          sta stream_arp_index,x
  221  07:E607            .update_pointer:
  222  07:E607  C8            iny
  223  07:E608  98            tya
  224  07:E609  18            clc
  225  07:E60A  7D 32 03      adc stream_ptr_LO, x
  226  07:E60D  9D 32 03      sta stream_ptr_LO, x
  227  07:E610  90 03         bcc .end
  228  07:E612  FE 3A 03      inc stream_ptr_HI, x
  229  07:E615            .end:
  230  07:E615  60            rts
