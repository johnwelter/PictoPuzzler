    4  07:E4A1  8D 00 03          sta sound_enable_flags
    5                         
    6  07:E4A4  A9 00         lda #$00
    7  07:E4A6  8D 01 03      sta sound_disable_flag  ;clear disable flag
    8                         ;later, if we have other variables we want to initialize, we will do that here.
    9  07:E4A9  A9 FF         lda #$FF
   10  07:E4AB  8D 04 03      sta sound_sq1_old   ;initializing these to $FF ensures that the first notes of the first song isn't skipped
   11  07:E4AE  8D 05 03      sta sound_sq2_old
   12  07:E4B1            se_silence:
   13  07:E4B1  A9 30         lda #$30
   14  07:E4B3  8D 06 03      sta soft_apu_ports      ;set Square 1 volume to 0
   15  07:E4B6  8D 0A 03      sta soft_apu_ports+4    ;set Square 2 volume to 0
   16  07:E4B9  8D 12 03      sta soft_apu_ports+12   ;set Noise volume to 0
   17  07:E4BC  A9 80         lda #$80
   18  07:E4BE  8D 0E 03      sta soft_apu_ports+8     ;silence Triangle
   19  07:E4C1  A9 00             lda #$00
   20  07:E4C3  8D 17 03          sta soft_apu_ports+17    ;silence DPMC
