  441                     ;
  442  07:E6E5            se_set_stream_arpeggio:
  443                         
  444  07:E6E5  BD 22 03          lda stream_status, x
  445  07:E6E8  29 02         and #%00000010
  446  07:E6EA  F0 01             beq .continue
  447  07:E6EC  60                rts
  448                             
  449  07:E6ED            .continue:
  450  07:E6ED  8C 02 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  451                         
  452  07:E6F0  BD C0 03      lda stream_arp, x            ;which volume envelope?
  453  07:E6F3  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  454  07:E6F4  A8            tay
  455  07:E6F5  B9 EF ED      lda kArp, y     ;get the low byte of the address from the pointer table
  456  07:E6F8  8D DC 00      sta sound_ptr               ;put it into our pointer variable
  457  07:E6FB  B9 F0 ED      lda kArp+1, y   ;get the high byte of the address
  458  07:E6FE  8D DD 00      sta sound_ptr+1
  459                         
  460  07:E701            .read_arp:
  461  07:E701  BC C8 03      ldy stream_arp_index, x      ;our current position within the volume envelope.
  462  07:E704  B1 DC         lda [sound_ptr], y          ;grab the value.
  463  07:E706  C9 81         cmp #$81
  464  07:E708  D0 08         bne .set_arp                ;if not 80, set the volume
  465  07:E70A  A9 00             LDA #$00
  466  07:E70C  9D C8 03      STA stream_arp_index, x      ;else if 80, go back one to start
  467  07:E70F  4C 01 E7      jmp .read_arp                ;  FF essentially tells us to repeat the last
  468                                                     ;  volume value for the remainder of the note
  469  07:E712            .set_arp:
  470  07:E712  8D 03 03      STA sound_temp2             ;save our new volume value (about to destroy A)
  471  07:E715  BD 5A 03          LDA stream_note_idx, x          ;note indexes are premultiplied, un mult for an easier add
  472  07:E718  4A                LSR A                           
  473  07:E719  18                CLC
  474  07:E71A  6D 03 03          ADC sound_temp2
  475  07:E71D  8D 03 03          STA sound_temp2
  476                             
  477                             
  478  07:E720  AC 02 03          LDY sound_temp1
  479  07:E723  8E 02 03          STX sound_temp1
  480  07:E726  0A                ASL A
  481  07:E727  AA                TAX 
  482                     
  483  07:E728  BD 61 EB          LDA note_table, x
  484  07:E72B  99 08 03          STA soft_apu_ports+2, y
  485  07:E72E  BD 62 EB          LDA note_table+1, x
  486  07:E731  99 09 03          STA soft_apu_ports+3, y
  487                             
  488  07:E734  AE 02 03          LDX sound_temp1
  489                             
  490  07:E737  FE C8 03      inc stream_arp_index, x      ;set our volume envelop index to the next position
  491                             
  492  07:E73A  98                TYA
  493  07:E73B  8D 02 03          STA sound_temp1
  494                     
  495  07:E73E  60            rts 
  496                     ;--------------------------------------
  497                     ;
  498  07:E73F            se_set_stream_pitch:
  499  07:E73F  8C 02 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  500                         
  501  07:E742  BD A0 03      lda stream_pe, x            ;which volume envelope?
  502  07:E745  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  503  07:E746  A8            tay
  504  07:E747  B9 A2 ED      lda kMod, y     ;get the low byte of the address from the pointer table
  505  07:E74A  8D DC 00      sta sound_ptr               ;put it into our pointer variable
  506  07:E74D  B9 A3 ED      lda kMod+1, y   ;get the high byte of the address
  507  07:E750  8D DD 00      sta sound_ptr+1
  508                             
  509  07:E753  BD B8 03          LDA stream_pe_delay, x
  510                             ;;if not 0, decrement
  511                             ;AND #$7F                       ;check if, without minus flag, the delay is 0
  512  07:E756  F0 04             BEQ .read_pe
  513  07:E758  DE B8 03          DEC stream_pe_delay, x
  514  07:E75B  60                RTS
  515                         
  516  07:E75C            .read_pe:
  517  07:E75C  BC A8 03      ldy stream_pe_index, x      ;our current position within the volume envelope.
  518  07:E75F  B1 DC         lda [sound_ptr], y          ;grab the value.
  519  07:E761  C9 80         cmp #l_cLast
  520  07:E763  D0 06             BNE .notLoopLast
  521  07:E765  DE A8 03          dec stream_pe_index, x      ;else if loop last, go back one and read again
  522  07:E768  4C 5C E7          jmp .read_pe 
  523                     
  524  07:E76B            .notLoopLast:
  525  07:E76B  C9 81             cmp #l_cAll
  526  07:E76D  D0 08             BNE .notLoopAll
  527  07:E76F  A9 00             LDA #$00
  528  07:E771  9D A8 03          STA stream_pe_index, x
  529  07:E774  4C 5C E7          jmp .read_pe
  530                             
  531  07:E777            .notLoopAll:
  532  07:E777  C9 82             cmp #l_cPart
  533  07:E779  D0 0D             BNE .notLoopPart
  534  07:E77B  C8                iny
  535  07:E77C  BD A8 03          lda stream_pe_index, x
  536  07:E77F  38                SEC
  537  07:E780  F1 DC             SBC [sound_ptr], y
  538  07:E782  9D A8 03          STA stream_pe_index, x
  539  07:E785  4C 5C E7          jmp .read_pe
  540                     
  541  07:E788            .notLoopPart:
  542  07:E788  C9 83             cmp #l_cHold
  543  07:E78A  D0 15             BNE .notLoopDelay
  544                             ;LDA stream_pe_delay, x
  545                             ;BMI .delayUsed ;negative, delay was already used this time
  546  07:E78C  C8                iny
  547  07:E78D  B1 DC             lda [sound_ptr], y
  548                             ;ORA #$80
  549  07:E78F  9D B8 03          STA stream_pe_delay, x
  550  07:E792  FE A8 03          inc stream_pe_index, x
  551  07:E795  4C DE E7          jmp .finish_pitchShift
  552  07:E798            .delayUsed:
  553  07:E798  FE A8 03          inc stream_pe_index, x
  554  07:E79B  FE A8 03          inc stream_pe_index, x
  555  07:E79E  4C 5C E7          jmp .read_pe
  556                             
  557  07:E7A1            .notLoopDelay:
  558  07:E7A1            .set_pitch:
  559                     
  560  07:E7A1  9D B0 03      sta stream_pe_offset, x      ;get current vol/duty settings
  561  07:E7A4  8D 03 03          STA sound_temp2
  562  07:E7A7  AC 02 03          LDY sound_temp1
  563  07:E7AA  AD 03 03          LDA sound_temp2
  564  07:E7AD  10 1D             BPL .add_pitch
  565                             
  566  07:E7AF            .sub_pitch:
  567                             
  568  07:E7AF  49 FF             EOR #$FF        ;flip bits
  569  07:E7B1  18                CLC
  570  07:E7B2  69 01             ADC #$01        ;add one - two's compliment
  571  07:E7B4  8D 03 03          STA sound_temp2
  572                             
  573  07:E7B7  B9 08 03          LDA soft_apu_ports+2, y       
  574  07:E7BA  38                SEC
  575  07:E7BB  ED 03 03          SBC sound_temp2
  576  07:E7BE  99 08 03          STA soft_apu_ports+2, y
  577  07:E7C1  B9 09 03          LDA soft_apu_ports+3, y
  578  07:E7C4  E9 00             SBC #$00
  579  07:E7C6  99 09 03          STA soft_apu_ports+3, y
  580                             
  581  07:E7C9  4C DE E7          JMP .finish_pitchShift
  582                     
  583  07:E7CC            .add_pitch:
  584                     
  585  07:E7CC  B9 08 03      LDA soft_apu_ports+2, y       
  586  07:E7CF  18                CLC
  587  07:E7D0  6D 03 03          ADC sound_temp2
  588  07:E7D3  99 08 03          STA soft_apu_ports+2, y
  589  07:E7D6  B9 09 03          LDA soft_apu_ports+3, y
  590  07:E7D9  69 00             ADC #$00
  591  07:E7DB  99 09 03          STA soft_apu_ports+3, y
  592                             
  593  07:E7DE            .finish_pitchShift:
  594  07:E7DE  FE A8 03      inc stream_pe_index, x      ;set our volume envelop index to the next position
  595                     
  596  07:E7E1            .rest_check:
  597                         ;check the rest flag. if set, overwrite volume with silence value 
  598  07:E7E1  BD 22 03      lda stream_status, x
  599  07:E7E4  29 02         and #%00000010
  600  07:E7E6  F0 05         beq .done                   ;if clear, no rest, so quit
  601                        
  602  07:E7E8  A9 00         LDA #$00
  603  07:E7EA  9D B0 03          STA stream_pe_offset, x
  604  07:E7ED            .done:
  605  07:E7ED  60            rts    
  606                     
  607                     ;--------------------------
  608                     ; se_set_apu copies the temporary RAM ports to the APU ports
  609  07:E7EE            se_set_apu:
  610  07:E7EE            .square1:
  611  07:E7EE  AD 06 03      lda soft_apu_ports+0
  612  07:E7F1  8D 00 40      sta $4000
  613  07:E7F4  AD 07 03      lda soft_apu_ports+1
  614  07:E7F7  8D 01 40      sta $4001
  615  07:E7FA  AD 08 03      lda soft_apu_ports+2
  616  07:E7FD  8D 02 40      sta $4002
  617  07:E800  AD 09 03      lda soft_apu_ports+3
  618  07:E803  CD 04 03      cmp sound_sq1_old       ;compare to last write
  619  07:E806  F0 06         beq .square2            ;don't write this frame if they were equal
  620  07:E808  8D 03 40      sta $4003
  621  07:E80B  8D 04 03      sta sound_sq1_old       ;save the value we just wrote to $4003
  622  07:E80E            .square2:
  623  07:E80E  AD 0A 03      lda soft_apu_ports+4
  624  07:E811  8D 04 40      sta $4004
  625  07:E814  AD 0B 03      lda soft_apu_ports+5
  626  07:E817  8D 05 40      sta $4005
  627  07:E81A  AD 0C 03      lda soft_apu_ports+6
  628  07:E81D  8D 06 40      sta $4006
  629  07:E820  AD 0D 03      lda soft_apu_ports+7
  630  07:E823  CD 05 03      cmp sound_sq2_old
  631  07:E826  F0 06         beq .triangle
  632  07:E828  8D 07 40      sta $4007
  633  07:E82B  8D 05 03      sta sound_sq2_old       ;save the value we just wrote to $4007
  634  07:E82E            .triangle:
  635  07:E82E  AD 0E 03      lda soft_apu_ports+8
  636  07:E831  8D 08 40      sta $4008
  637  07:E834  AD 10 03      lda soft_apu_ports+10   ;there is no $4009, so we skip it
  638  07:E837  8D 0A 40      sta $400A
  639  07:E83A  AD 11 03      lda soft_apu_ports+11
  640  07:E83D  8D 0B 40      sta $400B
  641  07:E840            .noise:
  642  07:E840  AD 12 03      lda soft_apu_ports+12
  643  07:E843  8D 0C 40      sta $400C
  644  07:E846  AD 14 03      lda soft_apu_ports+14   ;there is no $400D, so we skip it
  645  07:E849  8D 0E 40      sta $400E
  646  07:E84C  AD 15 03      lda soft_apu_ports+15
  647  07:E84F  8D 0F 40      sta $400F
  648  07:E852  60            rts
