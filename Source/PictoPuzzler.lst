    1                             ;; include list of macros here
    2                             
#[3]   Source/Routines/Macros/PPUMacros.asm
    3                             .include "Source/Routines/Macros/PPUMacros.asm"
    1                     ;;macro to load a full name table
    2                     ;; \1 = address to set
    3                     ;; \2 = flags to set
    4                     ;; all registers clobbered, as well as table_address
    5                     MACROSetPPUControl .macro
    6                     
    7                       LDA #\1  ; enable NMI, sprites from Pattern Table 0, background from Pattern Table 1
    8                       STA PPU_CTRL
    9                       LDA #\2   ; enable sprites, enable background, no clipping on left side
   10                       STA PPU_MASK
   11                             
   12                       .endm
   13                       
   14                     MACROSetPPUAddress .macro
   15                     
   16                       LDA PPU_STATUS             ; read PPU status to reset the high/low latch
   17                       LDA #HIGH(\1)
   18                       STA PPU_ADDR            ; write the high byte of $2000 address
   19                       LDA #LOW(\1)
   20                       STA PPU_ADDR           ; write the low byte of $2000 address
   21                       
   22                       .endm
   23                     
   24                     MACROSetPPUAddressVariable .macro
   25                     
   26                       LDA PPU_STATUS
   27                       LDA \1+1
   28                       STA PPU_ADDR
   29                       LDA \1
   30                       STA PPU_ADDR
   31                     
   32                       .endm
   33                       
   34                     MACROSAddXYOffset .macro
   35                     
   36                       LDA \1+1
   37                       LDX \1
   38                       JSR GetAddressWithXYOffset
   39                       STA \1+1
   40                       STX \1
   41                             
   42                       .endm
   43                       
   44                     MACROAddPPUStringEntryRawData .macro
   45                     
   46                       LDA #$01
   47                       STA PPU_PendingWrite
   48                       LDA \1
   49                       JSR WriteToPPUString
   50                       LDA \2
   51                       JSR WriteToPPUString
   52                       LDA \3
   53                       JSR WriteToPPUString
   54                       LDA \4 
   55                       JSR WriteToPPUString
   56                       
   57                       .endm
   58                     
   59                     MACROAddPPUStringEntryRepeat .macro
   60                     
   61                       LDA #$01
   62                       STA PPU_PendingWrite
   63                       LDA \1
   64                       JSR WriteToPPUString
   65                       LDA \2
   66                       JSR WriteToPPUString
   67                       LDA #$40
   68                       ORA \3
   69                       ORA \4
   70                       JSR WriteToPPUString
   71                       LDA \5
   72                       JSR WriteToPPUString
   73                       
   74                       .endm
   75                       
   76                     MACROAddPPUStringEntryTable .macro
   77                      
   78                       LDA #$01
   79                       STA PPU_PendingWrite
   80                       LDA \1
   81                       JSR WriteToPPUString
   82                       LDA \2
   83                       JSR WriteToPPUString
   84                       LDA #$20
   85                       ORA \3
   86                       JSR WriteToPPUString
   87                       LDA #LOW(\4)
   88                       JSR WriteToPPUString
   89                       LDA #HIGH(\4)
   90                       JSR WriteToPPUString
   91                      
   92                       .endm
   93                     
   94                     MACROAddPPUStringEntryTablePtr .macro
   95                      
   96                       LDA #$01
   97                       STA PPU_PendingWrite
   98                       LDA \1
   99                       JSR WriteToPPUString
  100                       LDA \2
  101                       JSR WriteToPPUString
  102                       LDA #$20
  103                       ORA \3
  104                       JSR WriteToPPUString
  105                       LDA \4
  106                       JSR WriteToPPUString
  107                       LDA \4+1
  108                       JSR WriteToPPUString
  109                      
  110                       .endm
