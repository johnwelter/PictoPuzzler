#[3]   Source/External/SoundEngine/Source/sound_opcodes.asm
  654                         .include "Source/External/SoundEngine/Source/sound_opcodes.asm"    ;our opcode subroutines, jump table and aliases
    1                     ;these are aliases to use in the sound data.
    2           00A0      endsound = $A0
    3           00A1      loop = $A1
    4           00A2      volume_envelope = $A2
    5           00A3      duty = $A3
    6           00A4      set_loop1_counter = $A4
    7           00A5      loop1 = $A5
    8           00A6      set_note_offset = $A6
    9           00A7      adjust_note_offset = $A7
   10           00A8      transpose = $A8
   11           00A9      pitch_envelope = $A9
   12           00AA      arpeggio = $AA
   13                     
   14                     ;-----------------------------------------------------------------------
   15                     ;this is our JUMP TABLE!
   16  07:EAAE            sound_opcodes:
   17  07:EAAE  C4 EA         .word se_op_endsound            ;$A0
   18  07:EAB0  DD EA         .word se_op_infinite_loop       ;$A1
   19  07:EAB2  F4 EA         .word se_op_change_ve           ;$A2
   20  07:EAB4  FF EA         .word se_op_duty                ;$A3
   21  07:EAB6  05 EB         .word se_op_set_loop1_counter   ;$A4
   22  07:EAB8  0B EB         .word se_op_loop1               ;$A5
   23  07:EABA  18 EB         .word se_op_set_note_offset     ;$A6
   24  07:EABC  1E EB         .word se_op_adjust_note_offset  ;$A7
   25  07:EABE  28 EB         .word se_op_transpose           ;$A8
   26  07:EAC0  48 EB             .word se_op_change_pe                   ;$A9
   27  07:EAC2  56 EB             .word se_op_change_arp
   28                         ;etc, 1 entry per subroutine
   29                     
   30                         
   31                     ;-----------------------------------------------------------------
   32                     ; these are the actual opcode subroutines
   33  07:EAC4            se_op_endsound:
   34  07:EAC4  BD 22 03      lda stream_status, x    ;end of stream, so disable it and silence
   35  07:EAC7  29 FE         and #%11111110
   36  07:EAC9  9D 22 03      sta stream_status, x    ;clear enable flag in status byte
   37                         
   38  07:EACC  BD 2A 03      lda stream_channel, x
   39  07:EACF  C9 02         cmp #TRIANGLE
   40  07:EAD1  F0 04         beq .silence_tri        ;triangle is silenced differently from squares and noise
   41  07:EAD3  A9 30         lda #$30                ;squares and noise silenced with #$30
   42  07:EAD5  D0 02         bne .silence            ; (this will always branch.  bne is cheaper than a jmp)
   43  07:EAD7            .silence_tri:
   44  07:EAD7  A9 80         lda #$80                ;triangle silenced with #$80
   45  07:EAD9            .silence:
   46  07:EAD9  9D 52 03      sta stream_vol_duty, x  ;store silence value in the stream's volume variable.
   47                     
   48  07:EADC  60            rts
   49                         
   50  07:EADD            se_op_infinite_loop:
   51  07:EADD  B1 DC         lda [sound_ptr], y      ;read ptr LO from the data stream
   52  07:EADF  9D 32 03      sta stream_ptr_LO, x    ;update our data stream position
   53  07:EAE2  C8            iny
   54  07:EAE3  B1 DC         lda [sound_ptr], y      ;read ptr HI from the data stream
   55  07:EAE5  9D 3A 03      sta stream_ptr_HI, x    ;update our data stream position
   56                         
   57  07:EAE8  8D DD 00      sta sound_ptr+1         ;update the pointer to reflect the new position.
   58  07:EAEB  BD 32 03      lda stream_ptr_LO, x
   59  07:EAEE  8D DC 00      sta sound_ptr
   60  07:EAF1  A0 FF         ldy #$FF                ;after opcodes return, we do an iny.  Since we reset  
   61                                                 ;the stream buffer position, we will want y to start out at 0 again.
   62  07:EAF3  60            rts
   63                         
   64  07:EAF4            se_op_change_ve:
   65  07:EAF4  B1 DC         lda [sound_ptr], y      ;read the argument
   66  07:EAF6  9D 42 03      sta stream_ve, x        ;store it in our volume envelope variable
   67  07:EAF9  A9 00         lda #$00
   68  07:EAFB  9D 4A 03      sta stream_ve_index, x  ;reset volume envelope index to the beginning
   69  07:EAFE  60            rts
   70                         
   71  07:EAFF            se_op_duty:
   72  07:EAFF  B1 DC         lda [sound_ptr], y
   73  07:EB01  9D 52 03      sta stream_vol_duty, x
   74  07:EB04  60            rts
   75                         
   76  07:EB05            se_op_set_loop1_counter:
   77  07:EB05  B1 DC         lda [sound_ptr], y      ;read the argument (# times to loop)
   78  07:EB07  9D 92 03      sta stream_loop1, x     ;store it in the loop counter variable
   79  07:EB0A  60            rts
   80                         
   81  07:EB0B            se_op_loop1:
   82  07:EB0B  DE 92 03      dec stream_loop1, x     ;decrement the counter
   83  07:EB0E  BD 92 03      lda stream_loop1, x
   84  07:EB11  F0 03         beq .last_iteration     ;if zero, we are done looping
   85  07:EB13  4C DD EA      jmp se_op_infinite_loop ;if not zero, jump back
   86  07:EB16            .last_iteration:
   87  07:EB16  C8            iny                     ;skip the first byte of the address argument
   88                                                 ; the second byte will be skipped automatically upon return
   89                                                 ; (see se_fetch_byte after "jsr se_opcode_launcher")
   90  07:EB17  60            rts
   91                         
   92  07:EB18            se_op_set_note_offset:
   93  07:EB18  B1 DC         lda [sound_ptr], y          ;read the argument
   94  07:EB1A  9D 9A 03      sta stream_note_offset, x      ;set the note offset.
   95  07:EB1D  60            rts
   96                         
   97  07:EB1E            se_op_adjust_note_offset:
   98  07:EB1E  B1 DC         lda [sound_ptr], y          ;read the argument (what value to add)
   99  07:EB20  18            clc
  100  07:EB21  7D 9A 03      adc stream_note_offset, x   ;add it to the current offset
  101  07:EB24  9D 9A 03      sta stream_note_offset, x   ;and save.
  102  07:EB27  60            rts
  103                         
  104  07:EB28            se_op_transpose:
  105  07:EB28  B1 DC         lda [sound_ptr], y          ;read low byte of the pointer to our lookup table
  106  07:EB2A  8D DE 00      sta sound_ptr2              ;store it in a new pointer variable
  107  07:EB2D  C8            iny
  108  07:EB2E  B1 DC         lda [sound_ptr], y          ;read high byte of pointer to table
  109  07:EB30  8D DF 00      sta sound_ptr2+1
  110                         
  111  07:EB33  8C 02 03      sty sound_temp1             ;save y because we are about to destroy it
  112  07:EB36  BD 92 03      lda stream_loop1, x         ;get loop counter, put it in Y
  113  07:EB39  A8            tay                         ;   this will be our index into the lookup table
  114  07:EB3A  88            dey                         ;subtract 1 because indexes start from 0.
  115                         
  116  07:EB3B  B1 DE         lda [sound_ptr2], y         ;read a value from the table.
  117  07:EB3D  18            clc
  118  07:EB3E  7D 9A 03      adc stream_note_offset, x   ;add it to the note offset
  119  07:EB41  9D 9A 03      sta stream_note_offset, x
  120                         
  121  07:EB44  AC 02 03      ldy sound_temp1             ;restore Y
  122  07:EB47  60            rts
  123                             
  124  07:EB48            se_op_change_pe:
  125  07:EB48  B1 DC         lda [sound_ptr], y      ;read the argument
  126  07:EB4A  9D A0 03      sta stream_pe, x        ;store it in our volume envelope variable
  127  07:EB4D  A9 00         lda #$00
  128  07:EB4F  9D A8 03      sta stream_pe_index, x  ;reset volume envelope index to the beginning
  129  07:EB52  9D B8 03          sta stream_pe_delay, x
  130  07:EB55  60            rts
  131                             
  132  07:EB56            se_op_change_arp:
  133  07:EB56  B1 DC             lda [sound_ptr], y
  134  07:EB58  9D C0 03          sta stream_arp, x
  135  07:EB5B  A9 00             lda #$00
  136  07:EB5D  9D C8 03          sta stream_arp_index, x
  137  07:EB60  60                rts
