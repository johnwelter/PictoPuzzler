  311  06:D247            FadeOutPalettes:
  312                     
  313                     ;;take the current values, and decrement the lower nibbles
  314                     ;;we can access from the palette copy 
  315                     ;;we'll make this fade out one level per call
  316                     ;;once all the palettes are blacked out we'll return true, so we'll keep the carry flag as a return result
  317                     
  318                     ;;go through the palette copy, decrement, make a raw data PPU string and add all the bytes into it
  319                     ;;for any palette color already in the 0x range, change it to 0f to get black
  320                     
  321                       MACROGetLabelPointer Palette_Copy, table_address
                          
       06:D247  A9 6C             LDA #HIGH(Palette_Copy)
       06:D249  A2 00             LDX #LOW(Palette_Copy)
                                  
       06:D24B  8E 16 00          STX table_address
       06:D24E  8D 17 00          STA table_address+1
                                  
  322                     ;;palette copy address is now X accessable
  323                     
  324  06:D251  A0 00       LDY #$00
  325                       MACROAddPPUStringEntryRawData #$3F, #$00, #DRAW_HORIZONTAL, #$20  
                          
       06:D253  A9 01       LDA #$01
       06:D255  8D 23 00    STA PPU_PendingWrite
       06:D258  A9 3F       LDA #$3F
       06:D25A  20 CA D1    JSR WriteToPPUString
       06:D25D  A9 00       LDA #$00
       06:D25F  20 CA D1    JSR WriteToPPUString
       06:D262  A9 00       LDA #DRAW_HORIZONTAL
       06:D264  20 CA D1    JSR WriteToPPUString
       06:D267  A9 20       LDA #$20 
       06:D269  20 CA D1    JSR WriteToPPUString
                            
