  382                     ;----------------------------------
  383                     ;    
  384  07:E689            se_set_stream_volume:
  385                             
  386  07:E689  8C 02 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  387                         
  388  07:E68C  BD 42 03      lda stream_ve, x            ;which volume envelope?
  389  07:E68F  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  390  07:E690  A8            tay
  391  07:E691  B9 3B EC      lda kVol, y     ;get the low byte of the address from the pointer table
  392  07:E694  8D DC 00      sta sound_ptr               ;put it into our pointer variable
  393  07:E697  B9 3C EC      lda kVol+1, y   ;get the high byte of the address
  394  07:E69A  8D DD 00      sta sound_ptr+1
  395                         
  396  07:E69D            .read_ve:
  397  07:E69D  BC 4A 03      ldy stream_ve_index, x      ;our current position within the volume envelope.
  398  07:E6A0  B1 DC         lda [sound_ptr], y          ;grab the value.
  399  07:E6A2  C9 FF         cmp #$FF
  400  07:E6A4  D0 06         bne .set_vol                ;if not FF, set the volume
  401  07:E6A6  DE 4A 03      dec stream_ve_index, x      ;else if FF, go back one and read again
  402  07:E6A9  4C 9D E6      jmp .read_ve                ;  FF essentially tells us to repeat the last
  403                                                     ;  volume value for the remainder of the note
  404  07:E6AC            .set_vol:
  405  07:E6AC  8D 03 03      sta sound_temp2             ;save our new volume value (about to destroy A)
  406                         
  407  07:E6AF  E0 02         cpx #TRIANGLE               
  408  07:E6B1  D0 09         bne .squares                ;if not triangle channel, go ahead
  409  07:E6B3  AD 03 03      lda sound_temp2
  410  07:E6B6  D0 04         bne .squares                ;else if volume not zero, go ahead (treat same as squares)
  411  07:E6B8  A9 80         lda #$80
  412  07:E6BA  30 08         bmi .store_vol              ;else silence the channel with #$80
  413  07:E6BC            .squares:
  414  07:E6BC  BD 52 03      lda stream_vol_duty, x      ;get current vol/duty settings
  415  07:E6BF  29 F0         and #$F0                    ;zero out the old volume
  416  07:E6C1  0D 03 03      ora sound_temp2             ;OR our new volume in.
  417                     
  418  07:E6C4            .store_vol:
  419  07:E6C4  AC 02 03      ldy sound_temp1             ;get our index into soft_apu_ports
  420  07:E6C7  99 06 03      sta soft_apu_ports, y       ;store the volume in our temp port
  421  07:E6CA  FE 4A 03      inc stream_ve_index, x      ;set our volume envelop index to the next position
  422                     
  423  07:E6CD            .rest_check:
  424                         ;check the rest flag. if set, overwrite volume with silence value 
  425  07:E6CD  BD 22 03      lda stream_status, x
  426  07:E6D0  29 02         and #%00000010
  427  07:E6D2  F0 10         beq .done                   ;if clear, no rest, so quit
  428  07:E6D4  BD 2A 03      lda stream_channel, x
  429  07:E6D7  C9 02         cmp #TRIANGLE               ;if triangle, silence with #$80
  430  07:E6D9  F0 04         beq .tri                    ;else, silence with #$30
  431  07:E6DB  A9 30         lda #$30        
  432  07:E6DD  D0 02         bne .store                  ;this always branches.  bne is cheaper than a jmp
  433  07:E6DF            .tri:
  434  07:E6DF  A9 80         lda #$80
  435  07:E6E1            .store:    
  436  07:E6E1  99 06 03      sta soft_apu_ports, y
  437  07:E6E4            .done:
  438  07:E6E4  60            rts   
