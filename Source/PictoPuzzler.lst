#[2]   Source/Routines/Common/NMI.asm
  198                       .include "Source/Routines/Common/NMI.asm"
    1                      
    2  06:DCB8            NMI:
    3                     
    4  06:DCB8  48          PHA                              ;protect the registers
    5  06:DCB9  8A          TXA
    6  06:DCBA  48          PHA
    7  06:DCBB  98          TYA
    8  06:DCBC  48          PHA
    9                       
   10  06:DCBD            nmi_started:
   11  06:DCBD  A9 00       LDA #$00
   12  06:DCBF  8D 03 20    STA OAM_LO      ; set the low byte (00) of the RAM address
   13  06:DCC2  A9 02       LDA #$02
   14  06:DCC4  8D 14 40    STA OAM_HI       ; set the high byte (02) of the RAM address, start the transfer
   15                     
   16  06:DCC7  AD 12 00    LDA NMI_locks
   17  06:DCCA  F0 03       BEQ update_controllers
   18  06:DCCC  4C 0F DD    JMP WakeUp
   19                     
   20  06:DCCF            update_controllers:
   21                       
   22  06:DCCF  20 20 DD    JSR ReadControllersSafe
   23  06:DCD2  20 C0 D3    JSR ProcessPPUString
   24                     
   25                       ; enable NMI, sprites from Pattern Table 0, background from Pattern Table 1
   26                       ; enable sprites, enable background, no clipping on left side 
   27  06:DCD5  A9 00       LDA #$00        ;;tell the ppu there is no background scrolling
   28  06:DCD7  8D 05 20    STA PPU_SCROLL
   29  06:DCDA  8D 05 20    STA PPU_SCROLL
   30  06:DCDD  20 61 D5    JSR UpdatePPUMask
   31  06:DCE0  20 55 D5    JSR UpdatePPUControl
   32                     
   33  06:DCE3            NMIUpdate:
   34                     
   35  06:DCE3  20 03 DD    JSR StateNMIUpdate
   36                       
   37  06:DCE6  AD 27 00    LDA PPU_Control
   38  06:DCE9  29 FC       AND #$FC
   39  06:DCEB  0D 2B 00    ORA PPU_ScrollNT
   40  06:DCEE  8D 00 20    STA PPU_CTRL
   41                       
   42  06:DCF1  AD 29 00    LDA PPU_ScrollX     ;;tell the ppu there is no background scrolling
   43  06:DCF4  8D 05 20    STA PPU_SCROLL
   44  06:DCF7  AD 2A 00    LDA PPU_ScrollY
   45  06:DCFA  8D 05 20    STA PPU_SCROLL
   46                       
   47  06:DCFD  20 41 E5    jsr sound_play_frame 
   48  06:DD00  4C 0F DD    JMP WakeUp
   49                     
   50  06:DD03            StateNMIUpdate:
   51                     
   52                       MACROCallDynamicJump game_mode
                          
       06:DD03  AD 10 00    LDA game_mode
       06:DD06  20 C3 D2    JSR Dynamic_Jump
                                  
