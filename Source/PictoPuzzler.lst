    1  07:E436            sound_init:
    2  07:E436  A9 1F         lda #$1F
    3  07:E438  8D 15 40      sta $4015   ;enable Square 1, Square 2, Triangle and Noise channels
    4  07:E43B  8D 00 03          sta sound_enable_flags
    5                         
    6  07:E43E  A9 00         lda #$00
    7  07:E440  8D 01 03      sta sound_disable_flag  ;clear disable flag
    8                         ;later, if we have other variables we want to initialize, we will do that here.
    9  07:E443  A9 FF         lda #$FF
   10  07:E445  8D 04 03      sta sound_sq1_old   ;initializing these to $FF ensures that the first notes of the first song isn't skipped
   11  07:E448  8D 05 03      sta sound_sq2_old
   12  07:E44B            se_silence:
   13  07:E44B  A9 30         lda #$30
   14  07:E44D  8D 06 03      sta soft_apu_ports      ;set Square 1 volume to 0
   15  07:E450  8D 0A 03      sta soft_apu_ports+4    ;set Square 2 volume to 0
   16  07:E453  8D 12 03      sta soft_apu_ports+12   ;set Noise volume to 0
   17  07:E456  A9 80         lda #$80
   18  07:E458  8D 0E 03      sta soft_apu_ports+8     ;silence Triangle
   19  07:E45B  A9 00             lda #$00
   20  07:E45D  8D 17 03          sta soft_apu_ports+17    ;silence DPMC
   21                     
   22  07:E460  60            rts
   23                         
   24  07:E461            sound_disable:
   25  07:E461  A9 00         lda #$00
   26  07:E463  8D 15 40      sta $4015   ;disable all channels
   27  07:E466  8D 00 03          sta sound_enable_flags
   28  07:E469  A9 01         lda #$01
   29  07:E46B  8D 01 03      sta sound_disable_flag  ;set disable flag
   30  07:E46E  60            rts
   31                         
   32                     ;-------------------------------------
   33                     ; load_sound will prepare the sound engine to play a song or sfx.
   34                     ;   input:
   35                     ;       A: song/sfx number to play
   36  07:E46F            sound_load:
   37  07:E46F  8D 02 03      sta sound_temp1         ;save song number
   38  07:E472  0A            asl a                   ;multiply by 2.  We are indexing into a table of pointers (words)
   39  07:E473  A8            tay
   40  07:E474  B9 53 E8      lda song_headers, y     ;setup the pointer to our song header
   41  07:E477  8D DC 00      sta sound_ptr
   42  07:E47A  B9 54 E8      lda song_headers+1, y
   43  07:E47D  8D DD 00      sta sound_ptr+1
   44                         
   45  07:E480  A0 00         ldy #$00
   46  07:E482  B1 DC         lda [sound_ptr], y      ;read the first byte: # streams
   47  07:E484  8D 03 03      sta sound_temp2         ;store in a temp variable.  We will use this as a loop counter: how many streams to read stream headers for
   48  07:E487  C8            iny
   49  07:E488            .loop:
   50  07:E488  B1 DC         lda [sound_ptr], y      ;stream number
   51  07:E48A  AA            tax                     ;stream number acts as our variable index
   52  07:E48B  C8            iny
   53                         
   54  07:E48C  B1 DC         lda [sound_ptr], y      ;status byte.  1= enable, 0=disable
   55  07:E48E  9D 22 03      sta stream_status, x
   56  07:E491  F0 49         beq .next_stream        ;if status byte is 0, stream disabled, so we are done
   57  07:E493  C8            iny
   58                         
   59  07:E494  B1 DC         lda [sound_ptr], y      ;channel number
   60  07:E496  9D 2A 03      sta stream_channel, x
   61  07:E499  C8            iny
   62                         
   63  07:E49A  B1 DC         lda [sound_ptr], y      ;initial duty and volume settings
   64  07:E49C  9D 52 03      sta stream_vol_duty, x
   65  07:E49F  C8            iny
   66                         
   67  07:E4A0  B1 DC         lda [sound_ptr], y
   68  07:E4A2  9D 42 03      sta stream_ve, x
   69  07:E4A5  C8            iny
   70                             
   71                             ;temp solution
   72  07:E4A6  A9 00             lda #me_none
   73  07:E4A8  9D A0 03          sta stream_pe, x
   74                             
   75                             ;temp solution
   76  07:E4AB  A9 00             lda #arp_none
   77  07:E4AD  9D C0 03          sta stream_arp, x
   78                         
   79  07:E4B0  B1 DC         lda [sound_ptr], y      ;pointer to stream data.  Little endian, so low byte first
   80  07:E4B2  9D 32 03      sta stream_ptr_LO, x
   81  07:E4B5  C8            iny
   82                         
   83  07:E4B6  B1 DC         lda [sound_ptr], y
   84  07:E4B8  9D 3A 03      sta stream_ptr_HI, x
   85  07:E4BB  C8            iny
   86                         
   87  07:E4BC  B1 DC         lda [sound_ptr], y
   88  07:E4BE  9D 72 03      sta stream_tempo, x
   89                         
   90  07:E4C1  A9 A0         lda #$A0
   91  07:E4C3  9D 7A 03      sta stream_ticker_total, x
   92                         
   93  07:E4C6  A9 01         lda #$01
   94  07:E4C8  9D 82 03      sta stream_note_length_counter,x
   95                         
   96  07:E4CB  A9 00         lda #$00
   97  07:E4CD  9D 4A 03      sta stream_ve_index, x
   98  07:E4D0  9D A8 03          sta stream_pe_index, x
   99  07:E4D3  9D C8 03          sta stream_arp_index, x
  100  07:E4D6  9D 92 03      sta stream_loop1, x
  101  07:E4D9  9D 9A 03      sta stream_note_offset, x
  102  07:E4DC            .next_stream:
  103  07:E4DC  C8            iny
  104                         
  105  07:E4DD  AD 02 03      lda sound_temp1         ;song number
  106  07:E4E0  9D 1A 03      sta stream_curr_sound, x
  107                         
  108  07:E4E3  CE 03 03      dec sound_temp2         ;our loop counter
  109  07:E4E6  D0 A0         bne .loop
  110  07:E4E8  60            rts
  111                     
  112                     ;--------------------------
  113                     ; sound_play_frame advances the sound engine by one frame
  114  07:E4E9            sound_play_frame:
  115  07:E4E9  AD 01 03      lda sound_disable_flag
  116  07:E4EC  D0 31         bne .done   ;if disable flag is set, don't advance a frame
  117                     
  118  07:E4EE  20 4B E4      jsr se_silence  ;silence all channels.  se_set_apu will set volume later for all channels that are enabled.
  119                                         ;the purpose of this subroutine call is to silence channels that aren't used by any streams.
  120  07:E4F1  A2 00         ldx #$00
  121  07:E4F3            .loop:
  122  07:E4F3  BD 22 03      lda stream_status, x
  123  07:E4F6  29 01         and #$01    ;check whether the stream is active
  124  07:E4F8  F0 1D         beq .endloop  ;if the stream isn't active, skip it
  125                         
  126                         ;add the tempo to the ticker total.  If there is a FF-> 0 transition, there is a tick
  127  07:E4FA  BD 7A 03      lda stream_ticker_total, x
  128  07:E4FD  18            clc
  129  07:E4FE  7D 72 03      adc stream_tempo, x
  130  07:E501  9D 7A 03      sta stream_ticker_total, x
  131  07:E504  90 0E         bcc .set_buffer    ;carry clear = no tick.  if no tick, we are done with this stream
  132                         
  133  07:E506  DE 82 03      dec stream_note_length_counter, x   ;else there is a tick. decrement the note length counter
  134  07:E509  D0 09         bne .set_buffer    ;if counter is non-zero, our note isn't finished playing yet
  135  07:E50B  BD 8A 03      lda stream_note_length, x   ;else our note is finished. reload the note length counter
  136  07:E50E  9D 82 03      sta stream_note_length_counter, x
  137                         
  138  07:E511  20 20 E5      jsr se_fetch_byte   ;read the next byte from the data stream
  139                         
  140  07:E514            .set_buffer:
  141  07:E514  20 5B E6      jsr se_set_temp_ports   ;copy the current stream's sound data for the current frame into our temporary APU vars (soft_apu_ports)
  142  07:E517            .endloop:
  143  07:E517  E8            inx
  144  07:E518  E0 08         cpx #$08
  145  07:E51A  D0 D7         bne .loop
  146  07:E51C  20 EE E7      jsr se_set_apu      ;copy the temporary APU variables (soft_apu_ports) to the real APU ports ($4000, $4001, etc)
  147  07:E51F            .done:
  148  07:E51F  60            rts
  149                     
  150                     ;--------------------------
  151                     ; se_fetch_byte reads one byte from a sound data stream and handles it
  152                     ;   input: 
  153                     ;       X: stream number    
  154  07:E520            se_fetch_byte:
  155  07:E520  BD 32 03      lda stream_ptr_LO, x
  156  07:E523  8D DC 00      sta sound_ptr
  157  07:E526  BD 3A 03      lda stream_ptr_HI, x
  158  07:E529  8D DD 00      sta sound_ptr+1
  159                         
  160  07:E52C  A0 00         ldy #$00
  161  07:E52E            .fetch:
  162  07:E52E  B1 DC         lda [sound_ptr], y
  163  07:E530  10 26         bpl .note                ;if < #$80, it's a Note
  164  07:E532  C9 A0         cmp #$A0
  165  07:E534  90 0C         bcc .note_length         ;else if < #$A0, it's a Note Length
  166  07:E536            .opcode:                     ;else it's an opcode
  167                         ;do Opcode stuff
  168  07:E536  20 40 E6      jsr se_opcode_launcher
  169  07:E539  C8            iny                      ;next position in the data stream
  170  07:E53A  BD 22 03      lda stream_status, x
  171  07:E53D  29 01         and #%00000001
  172  07:E53F  D0 ED         bne .fetch               ;after our opcode is done, grab another byte unless the stream is disabled
  173  07:E541  60            rts                      ; in which case we quit  (explained below)
  174  07:E542            .note_length:
  175                         ;do note length stuff
  176  07:E542  29 7F         and #%01111111          ;chop off bit7
  177  07:E544  8C 02 03      sty sound_temp1         ;save Y because we are about to destroy it
  178  07:E547  A8            tay
  179  07:E548  B9 A9 EA      lda note_length_table, y    ;get the note length count value
  180  07:E54B  9D 8A 03      sta stream_note_length, x
  181  07:E54E  9D 82 03      sta stream_note_length_counter, x   ;stick it in our note length counter
  182  07:E551  AC 02 03      ldy sound_temp1         ;restore Y
  183  07:E554  C8            iny                     ;set index to next byte in the stream
  184  07:E555  4C 2E E5      jmp .fetch              ;fetch another byte
  185  07:E558            .note:
  186                         ;do Note stuff
  187  07:E558  8D 03 03      sta sound_temp2
  188  07:E55B  BD 2A 03      lda stream_channel, x
  189  07:E55E  C9 03         cmp #NOISE
  190  07:E560  D0 06         bne .not_noise
  191  07:E562  20 B0 E5      jsr se_do_noise
  192  07:E565  4C 93 E5      jmp .reset_ve
  193  07:E568            .not_noise:
  194  07:E568  C9 04             cmp #DPMC
  195  07:E56A  90 06             bcc .not_dpmc
  196  07:E56C  20 E8 E5          jsr se_do_dpmc
  197  07:E56F  4C 93 E5          jmp .reset_ve
  198  07:E572            .not_dpmc:
  199  07:E572  AD 03 03      lda sound_temp2
  200  07:E575  8C 02 03      sty sound_temp1     ;save our index into the data stream
  201  07:E578  18            clc
  202  07:E579  7D 9A 03      adc stream_note_offset, x   ;add note offset
  203  07:E57C  0A            asl a
  204  07:E57D  A8            tay
  205  07:E57E  9D 5A 03          sta stream_note_idx, x
  206  07:E581  B9 EB E9      lda note_table, y
  207  07:E584  9D 62 03      sta stream_note_LO, x
  208  07:E587  B9 EC E9      lda note_table+1, y
  209  07:E58A  9D 6A 03      sta stream_note_HI, x
  210  07:E58D  AC 02 03      ldy sound_temp1     ;restore data stream index
  211                         
  212                         ;check if it's a rest and modify the status flag appropriately
  213                     
  214  07:E590  20 2A E6      jsr se_check_rest
  215  07:E593            .reset_ve:    
  216  07:E593  A9 00         lda #$00
  217  07:E595  9D 4A 03      sta stream_ve_index, x  
  218  07:E598  9D A8 03          sta stream_pe_index, x
  219  07:E59B  9D B8 03          sta stream_pe_delay, x
  220  07:E59E  9D C8 03          sta stream_arp_index,x
  221  07:E5A1            .update_pointer:
  222  07:E5A1  C8            iny
  223  07:E5A2  98            tya
  224  07:E5A3  18            clc
  225  07:E5A4  7D 32 03      adc stream_ptr_LO, x
  226  07:E5A7  9D 32 03      sta stream_ptr_LO, x
  227  07:E5AA  90 03         bcc .end
  228  07:E5AC  FE 3A 03      inc stream_ptr_HI, x
  229  07:E5AF            .end:
  230  07:E5AF  60            rts
  231                     
  232  07:E5B0            se_do_noise:
  233                     
  234  07:E5B0  AD 15 40          lda $4015
  235  07:E5B3  29 10             AND #$10                                ;get the current DMC bytes remaining
  236  07:E5B5  09 07             ORA #$07                                ;add in the lower three bits
  237  07:E5B7  2D 00 03          AND sound_enable_flags  ;and with the current sound flags, minus noise
  238  07:E5BA  8D 00 03          sta sound_enable_flags  ;disable noise
  239  07:E5BD  8D 15 40          sta $4015
  240                     
  241  07:E5C0  AD 03 03      lda sound_temp2
  242  07:E5C3  29 20             AND #%00100000
  243  07:E5C5  D0 20             bne .leave
  244                             
  245  07:E5C7  AD 03 03          lda sound_temp2
  246  07:E5CA  29 10         and #%00010000
  247  07:E5CC  F0 08         beq .mode0
  248  07:E5CE  AD 03 03      lda sound_temp2
  249  07:E5D1  09 80         ora #%10000000      ;set bit 7 to set mode1
  250  07:E5D3  8D 03 03      sta sound_temp2
  251  07:E5D6            .mode0:
  252  07:E5D6  AD 03 03      lda sound_temp2
  253  07:E5D9  9D 62 03      sta stream_note_LO, x
  254                     
  255  07:E5DC  AD 00 03          lda sound_enable_flags
  256  07:E5DF  09 08             ORA #%00001000
  257  07:E5E1  8D 00 03          STA sound_enable_flags
  258  07:E5E4  8D 15 40          sta $4015
  259  07:E5E7            .leave:
  260  07:E5E7  60            rts
  261                             
  262  07:E5E8            se_do_dpmc:
  263  07:E5E8  8A                TXA
  264  07:E5E9  48                PHA
  265                             
  266  07:E5EA  AD 00 03          lda sound_enable_flags
  267  07:E5ED  29 0F             AND #$0F
  268  07:E5EF  8D 00 03          sta sound_enable_flags ;DPCM disable
  269  07:E5F2  8D 15 40          sta $4015
  270                             
  271  07:E5F5  AD 03 03          lda sound_temp2         ;load up sample index- we can cram in the pitch and keep ourselves to 6 samples (7 will be rest)
  272  07:E5F8  C9 70             CMP #$70
  273  07:E5FA  B0 2B             BCS .leave
  274                     
  275  07:E5FC  29 0F             AND #$0F
  276  07:E5FE  8D 10 40          sta $4010 ;pitch
  277  07:E601  A9 7F             LDA #$7F
  278  07:E603  8D 11 40          sta $4011 ;temp = starting sample level
  279  07:E606  AD 03 03          lda sound_temp2
  280  07:E609  29 F0             AND #$F0
  281  07:E60B  4A                LSR A
  282  07:E60C  4A                LSR A
  283  07:E60D  4A                LSR A
  284  07:E60E  4A                LSR A
  285  07:E60F  AA                TAX
  286  07:E610  BD 71 DC          lda SampleStart,x
  287  07:E613  8D 12 40          sta $4012 ;X = sample number
  288  07:E616  BD 73 DC          lda SampleLength,x
  289  07:E619  8D 13 40          sta $4013
  290                             
  291  07:E61C  AD 00 03          lda sound_enable_flags
  292  07:E61F  09 10             ORA #$10
  293  07:E621  8D 00 03          STA sound_enable_flags
  294  07:E624  8D 15 40          sta $4015
  295  07:E627            .leave:
  296  07:E627  68                PLA
  297  07:E628  AA                TAX
  298                     
  299  07:E629  60                rts
  300                             
  301                     ;--------------------------------------------------
  302                     ; se_check_rest will read a byte from the data stream and
  303                     ;       determine if it is a rest or not.  It will set or clear the current
  304                     ;       stream's rest flag accordingly.
  305                     ;       input:
  306                     ;           X: stream number
  307                     ;           Y: data stream index
  308  07:E62A            se_check_rest:
  309  07:E62A  B1 DC         lda [sound_ptr], y  ;read the note byte again
  310  07:E62C  C9 5E         cmp #rest
  311  07:E62E  D0 07         bne .not_rest
  312  07:E630  BD 22 03      lda stream_status, x
  313  07:E633  09 02         ora #%00000010  ;set the rest bit in the status byte
  314  07:E635  D0 05         bne .store  ;this will always branch.  bne is cheaper than a jmp.
  315  07:E637            .not_rest:
  316  07:E637  BD 22 03      lda stream_status, x
  317  07:E63A  29 FD         and #%11111101  ;clear the rest bit in the status byte
  318  07:E63C            .store:
  319  07:E63C  9D 22 03      sta stream_status, x
  320  07:E63F  60            rts
  321                         
  322                     ;-----------------------------------------
  323                     ; se_opcode_launcher will read an address from the opcode jump table and indirect jump there.
  324                     ;    input: A: opcode byte
  325                     ;               Y: data stream position
  326                     ;               X: stream number
  327  07:E640            se_opcode_launcher:
  328  07:E640  8C 02 03      sty sound_temp1         ;save y register, because we are about to destroy it
  329  07:E643  38            sec
  330  07:E644  E9 A0         sbc #$A0                ;turn our opcode byte into a table index by subtracting $A0
  331  07:E646  0A            asl a                   ;multiply by 2 because we index into a table of addresses (words)
  332  07:E647  A8            tay
  333  07:E648  B9 38 E9      lda sound_opcodes, y    ;get low byte of subroutine address
  334  07:E64B  8D DE 00      sta sound_ptr2
  335  07:E64E  B9 39 E9      lda sound_opcodes+1, y  ;get high byte
  336  07:E651  8D DF 00      sta sound_ptr2+1
  337  07:E654  AC 02 03      ldy sound_temp1         ;restore our y register
  338  07:E657  C8            iny                     ;set to next position in data stream (assume an argument)
  339  07:E658  6C DE 00      jmp [sound_ptr2]           ;indirect jump to our opcode subroutine    
  340                         
  341                     ;----------------------------------------------------
  342                     ; se_set_temp_ports will copy a stream's sound data to the temporary apu variables
  343                     ;      input:
  344                     ;           X: stream number
  345  07:E65B            se_set_temp_ports:
  346                     
  347  07:E65B  E0 06             cpx #MUSIC_DPMC
  348  07:E65D  90 01             bcc .contTempPorts
  349  07:E65F  60                rts
  350  07:E660            .contTempPorts:
  351  07:E660  BD 2A 03      lda stream_channel, x
  352  07:E663  0A            asl a
  353  07:E664  0A            asl a
  354  07:E665  A8            tay
  355                         
  356  07:E666  20 89 E6      jsr se_set_stream_volume
  357                             
  358                         
  359  07:E669  A9 08         lda #$08
  360  07:E66B  99 07 03      sta soft_apu_ports+1, y     ;sweep
  361                         
  362                             
  363  07:E66E  BD C0 03          LDA stream_arp, x
  364  07:E671  F0 06             BEQ .updatePitch
  365                             
  366  07:E673  20 E5 E6          JSR se_set_stream_arpeggio
  367  07:E676  4C 88 E6          JMP .leaveTempSet
  368                             
  369  07:E679            .updatePitch:
  370  07:E679  BD 62 03      lda stream_note_LO, x
  371  07:E67C  99 08 03      sta soft_apu_ports+2, y     ;period LO
  372                         
  373  07:E67F  BD 6A 03      lda stream_note_HI, x
  374  07:E682  99 09 03      sta soft_apu_ports+3, y     ;period HI
  375                             
  376                     
  377  07:E685  20 3F E7          jsr se_set_stream_pitch
  378                     
  379  07:E688            .leaveTempSet:
  380  07:E688  60            rts    
  381                     
  382                     ;----------------------------------
  383                     ;    
  384  07:E689            se_set_stream_volume:
  385                             
  386  07:E689  8C 02 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  387                         
  388  07:E68C  BD 42 03      lda stream_ve, x            ;which volume envelope?
  389  07:E68F  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  390  07:E690  A8            tay
  391  07:E691  B9 C5 EA      lda kVol, y     ;get the low byte of the address from the pointer table
  392  07:E694  8D DC 00      sta sound_ptr               ;put it into our pointer variable
  393  07:E697  B9 C6 EA      lda kVol+1, y   ;get the high byte of the address
  394  07:E69A  8D DD 00      sta sound_ptr+1
  395                         
  396  07:E69D            .read_ve:
  397  07:E69D  BC 4A 03      ldy stream_ve_index, x      ;our current position within the volume envelope.
  398  07:E6A0  B1 DC         lda [sound_ptr], y          ;grab the value.
  399  07:E6A2  C9 FF         cmp #$FF
  400  07:E6A4  D0 06         bne .set_vol                ;if not FF, set the volume
  401  07:E6A6  DE 4A 03      dec stream_ve_index, x      ;else if FF, go back one and read again
  402  07:E6A9  4C 9D E6      jmp .read_ve                ;  FF essentially tells us to repeat the last
  403                                                     ;  volume value for the remainder of the note
  404  07:E6AC            .set_vol:
  405  07:E6AC  8D 03 03      sta sound_temp2             ;save our new volume value (about to destroy A)
  406                         
  407  07:E6AF  E0 02         cpx #TRIANGLE               
  408  07:E6B1  D0 09         bne .squares                ;if not triangle channel, go ahead
  409  07:E6B3  AD 03 03      lda sound_temp2
  410  07:E6B6  D0 04         bne .squares                ;else if volume not zero, go ahead (treat same as squares)
  411  07:E6B8  A9 80         lda #$80
  412  07:E6BA  30 08         bmi .store_vol              ;else silence the channel with #$80
  413  07:E6BC            .squares:
  414  07:E6BC  BD 52 03      lda stream_vol_duty, x      ;get current vol/duty settings
  415  07:E6BF  29 F0         and #$F0                    ;zero out the old volume
  416  07:E6C1  0D 03 03      ora sound_temp2             ;OR our new volume in.
  417                     
  418  07:E6C4            .store_vol:
  419  07:E6C4  AC 02 03      ldy sound_temp1             ;get our index into soft_apu_ports
  420  07:E6C7  99 06 03      sta soft_apu_ports, y       ;store the volume in our temp port
  421  07:E6CA  FE 4A 03      inc stream_ve_index, x      ;set our volume envelop index to the next position
  422                     
  423  07:E6CD            .rest_check:
  424                         ;check the rest flag. if set, overwrite volume with silence value 
  425  07:E6CD  BD 22 03      lda stream_status, x
  426  07:E6D0  29 02         and #%00000010
  427  07:E6D2  F0 10         beq .done                   ;if clear, no rest, so quit
  428  07:E6D4  BD 2A 03      lda stream_channel, x
  429  07:E6D7  C9 02         cmp #TRIANGLE               ;if triangle, silence with #$80
  430  07:E6D9  F0 04         beq .tri                    ;else, silence with #$30
  431  07:E6DB  A9 30         lda #$30        
  432  07:E6DD  D0 02         bne .store                  ;this always branches.  bne is cheaper than a jmp
  433  07:E6DF            .tri:
  434  07:E6DF  A9 80         lda #$80
  435  07:E6E1            .store:    
  436  07:E6E1  99 06 03      sta soft_apu_ports, y
  437  07:E6E4            .done:
  438  07:E6E4  60            rts   
  439                             
  440                     ;---------------------------------------
  441                     ;
  442  07:E6E5            se_set_stream_arpeggio:
  443                         
  444  07:E6E5  BD 22 03          lda stream_status, x
  445  07:E6E8  29 02         and #%00000010
  446  07:E6EA  F0 01             beq .continue
  447  07:E6EC  60                rts
  448                             
  449  07:E6ED            .continue:
  450  07:E6ED  8C 02 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  451                         
  452  07:E6F0  BD C0 03      lda stream_arp, x            ;which volume envelope?
  453  07:E6F3  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  454  07:E6F4  A8            tay
  455  07:E6F5  B9 79 EC      lda kArp, y     ;get the low byte of the address from the pointer table
  456  07:E6F8  8D DC 00      sta sound_ptr               ;put it into our pointer variable
  457  07:E6FB  B9 7A EC      lda kArp+1, y   ;get the high byte of the address
  458  07:E6FE  8D DD 00      sta sound_ptr+1
  459                         
  460  07:E701            .read_arp:
  461  07:E701  BC C8 03      ldy stream_arp_index, x      ;our current position within the volume envelope.
  462  07:E704  B1 DC         lda [sound_ptr], y          ;grab the value.
  463  07:E706  C9 81         cmp #$81
  464  07:E708  D0 08         bne .set_arp                ;if not 80, set the volume
  465  07:E70A  A9 00             LDA #$00
  466  07:E70C  9D C8 03      STA stream_arp_index, x      ;else if 80, go back one to start
  467  07:E70F  4C 01 E7      jmp .read_arp                ;  FF essentially tells us to repeat the last
  468                                                     ;  volume value for the remainder of the note
  469  07:E712            .set_arp:
  470  07:E712  8D 03 03      STA sound_temp2             ;save our new volume value (about to destroy A)
  471  07:E715  BD 5A 03          LDA stream_note_idx, x          ;note indexes are premultiplied, un mult for an easier add
  472  07:E718  4A                LSR A                           
  473  07:E719  18                CLC
  474  07:E71A  6D 03 03          ADC sound_temp2
  475  07:E71D  8D 03 03          STA sound_temp2
  476                             
  477                             
  478  07:E720  AC 02 03          LDY sound_temp1
  479  07:E723  8E 02 03          STX sound_temp1
  480  07:E726  0A                ASL A
  481  07:E727  AA                TAX 
  482                     
  483  07:E728  BD EB E9          LDA note_table, x
  484  07:E72B  99 08 03          STA soft_apu_ports+2, y
  485  07:E72E  BD EC E9          LDA note_table+1, x
  486  07:E731  99 09 03          STA soft_apu_ports+3, y
  487                             
  488  07:E734  AE 02 03          LDX sound_temp1
  489                             
  490  07:E737  FE C8 03      inc stream_arp_index, x      ;set our volume envelop index to the next position
  491                             
  492  07:E73A  98                TYA
  493  07:E73B  8D 02 03          STA sound_temp1
  494                     
  495  07:E73E  60            rts 
  496                     ;--------------------------------------
  497                     ;
  498  07:E73F            se_set_stream_pitch:
  499  07:E73F  8C 02 03      sty sound_temp1             ;save our index into soft_apu_ports (we are about to destroy y)
  500                         
  501  07:E742  BD A0 03      lda stream_pe, x            ;which volume envelope?
  502  07:E745  0A            asl a                       ;multiply by 2 because we are indexing into a table of addresses (words)
  503  07:E746  A8            tay
  504  07:E747  B9 2C EC      lda kMod, y     ;get the low byte of the address from the pointer table
  505  07:E74A  8D DC 00      sta sound_ptr               ;put it into our pointer variable
  506  07:E74D  B9 2D EC      lda kMod+1, y   ;get the high byte of the address
  507  07:E750  8D DD 00      sta sound_ptr+1
  508                             
  509  07:E753  BD B8 03          LDA stream_pe_delay, x
  510                             ;;if not 0, decrement
  511                             ;AND #$7F                       ;check if, without minus flag, the delay is 0
  512  07:E756  F0 04             BEQ .read_pe
  513  07:E758  DE B8 03          DEC stream_pe_delay, x
  514  07:E75B  60                RTS
  515                         
  516  07:E75C            .read_pe:
  517  07:E75C  BC A8 03      ldy stream_pe_index, x      ;our current position within the volume envelope.
  518  07:E75F  B1 DC         lda [sound_ptr], y          ;grab the value.
  519  07:E761  C9 80         cmp #l_cLast
  520  07:E763  D0 06             BNE .notLoopLast
  521  07:E765  DE A8 03          dec stream_pe_index, x      ;else if loop last, go back one and read again
  522  07:E768  4C 5C E7          jmp .read_pe 
  523                     
  524  07:E76B            .notLoopLast:
  525  07:E76B  C9 81             cmp #l_cAll
  526  07:E76D  D0 08             BNE .notLoopAll
  527  07:E76F  A9 00             LDA #$00
  528  07:E771  9D A8 03          STA stream_pe_index, x
  529  07:E774  4C 5C E7          jmp .read_pe
  530                             
  531  07:E777            .notLoopAll:
  532  07:E777  C9 82             cmp #l_cPart
  533  07:E779  D0 0D             BNE .notLoopPart
  534  07:E77B  C8                iny
  535  07:E77C  BD A8 03          lda stream_pe_index, x
  536  07:E77F  38                SEC
  537  07:E780  F1 DC             SBC [sound_ptr], y
  538  07:E782  9D A8 03          STA stream_pe_index, x
  539  07:E785  4C 5C E7          jmp .read_pe
  540                     
  541  07:E788            .notLoopPart:
  542  07:E788  C9 83             cmp #l_cHold
  543  07:E78A  D0 15             BNE .notLoopDelay
  544                             ;LDA stream_pe_delay, x
  545                             ;BMI .delayUsed ;negative, delay was already used this time
  546  07:E78C  C8                iny
  547  07:E78D  B1 DC             lda [sound_ptr], y
  548                             ;ORA #$80
  549  07:E78F  9D B8 03          STA stream_pe_delay, x
  550  07:E792  FE A8 03          inc stream_pe_index, x
  551  07:E795  4C DE E7          jmp .finish_pitchShift
  552  07:E798            .delayUsed:
  553  07:E798  FE A8 03          inc stream_pe_index, x
  554  07:E79B  FE A8 03          inc stream_pe_index, x
  555  07:E79E  4C 5C E7          jmp .read_pe
  556                             
  557  07:E7A1            .notLoopDelay:
  558  07:E7A1            .set_pitch:
  559                     
  560  07:E7A1  9D B0 03      sta stream_pe_offset, x      ;get current vol/duty settings
  561  07:E7A4  8D 03 03          STA sound_temp2
  562  07:E7A7  AC 02 03          LDY sound_temp1
  563  07:E7AA  AD 03 03          LDA sound_temp2
  564  07:E7AD  10 1D             BPL .add_pitch
  565                             
  566  07:E7AF            .sub_pitch:
  567                             
  568  07:E7AF  49 FF             EOR #$FF        ;flip bits
  569  07:E7B1  18                CLC
  570  07:E7B2  69 01             ADC #$01        ;add one - two's compliment
  571  07:E7B4  8D 03 03          STA sound_temp2
  572                             
  573  07:E7B7  B9 08 03          LDA soft_apu_ports+2, y       
  574  07:E7BA  38                SEC
  575  07:E7BB  ED 03 03          SBC sound_temp2
  576  07:E7BE  99 08 03          STA soft_apu_ports+2, y
  577  07:E7C1  B9 09 03          LDA soft_apu_ports+3, y
  578  07:E7C4  E9 00             SBC #$00
  579  07:E7C6  99 09 03          STA soft_apu_ports+3, y
  580                             
  581  07:E7C9  4C DE E7          JMP .finish_pitchShift
  582                     
  583  07:E7CC            .add_pitch:
  584                     
  585  07:E7CC  B9 08 03      LDA soft_apu_ports+2, y       
  586  07:E7CF  18                CLC
  587  07:E7D0  6D 03 03          ADC sound_temp2
  588  07:E7D3  99 08 03          STA soft_apu_ports+2, y
  589  07:E7D6  B9 09 03          LDA soft_apu_ports+3, y
  590  07:E7D9  69 00             ADC #$00
  591  07:E7DB  99 09 03          STA soft_apu_ports+3, y
  592                             
  593  07:E7DE            .finish_pitchShift:
  594  07:E7DE  FE A8 03      inc stream_pe_index, x      ;set our volume envelop index to the next position
  595                     
  596  07:E7E1            .rest_check:
  597                         ;check the rest flag. if set, overwrite volume with silence value 
  598  07:E7E1  BD 22 03      lda stream_status, x
  599  07:E7E4  29 02         and #%00000010
  600  07:E7E6  F0 05         beq .done                   ;if clear, no rest, so quit
  601                        
  602  07:E7E8  A9 00         LDA #$00
  603  07:E7EA  9D B0 03          STA stream_pe_offset, x
  604  07:E7ED            .done:
  605  07:E7ED  60            rts    
  606                     
  607                     ;--------------------------
  608                     ; se_set_apu copies the temporary RAM ports to the APU ports
  609  07:E7EE            se_set_apu:
  610  07:E7EE            .square1:
  611  07:E7EE  AD 06 03      lda soft_apu_ports+0
  612  07:E7F1  8D 00 40      sta $4000
  613  07:E7F4  AD 07 03      lda soft_apu_ports+1
  614  07:E7F7  8D 01 40      sta $4001
  615  07:E7FA  AD 08 03      lda soft_apu_ports+2
  616  07:E7FD  8D 02 40      sta $4002
  617  07:E800  AD 09 03      lda soft_apu_ports+3
  618  07:E803  CD 04 03      cmp sound_sq1_old       ;compare to last write
  619  07:E806  F0 06         beq .square2            ;don't write this frame if they were equal
  620  07:E808  8D 03 40      sta $4003
  621  07:E80B  8D 04 03      sta sound_sq1_old       ;save the value we just wrote to $4003
  622  07:E80E            .square2:
  623  07:E80E  AD 0A 03      lda soft_apu_ports+4
  624  07:E811  8D 04 40      sta $4004
  625  07:E814  AD 0B 03      lda soft_apu_ports+5
  626  07:E817  8D 05 40      sta $4005
  627  07:E81A  AD 0C 03      lda soft_apu_ports+6
  628  07:E81D  8D 06 40      sta $4006
  629  07:E820  AD 0D 03      lda soft_apu_ports+7
  630  07:E823  CD 05 03      cmp sound_sq2_old
  631  07:E826  F0 06         beq .triangle
  632  07:E828  8D 07 40      sta $4007
  633  07:E82B  8D 05 03      sta sound_sq2_old       ;save the value we just wrote to $4007
  634  07:E82E            .triangle:
  635  07:E82E  AD 0E 03      lda soft_apu_ports+8
  636  07:E831  8D 08 40      sta $4008
  637  07:E834  AD 10 03      lda soft_apu_ports+10   ;there is no $4009, so we skip it
  638  07:E837  8D 0A 40      sta $400A
  639  07:E83A  AD 11 03      lda soft_apu_ports+11
  640  07:E83D  8D 0B 40      sta $400B
  641  07:E840            .noise:
  642  07:E840  AD 12 03      lda soft_apu_ports+12
  643  07:E843  8D 0C 40      sta $400C
  644  07:E846  AD 14 03      lda soft_apu_ports+14   ;there is no $400D, so we skip it
  645  07:E849  8D 0E 40      sta $400E
  646  07:E84C  AD 15 03      lda soft_apu_ports+15
  647  07:E84F  8D 0F 40      sta $400F
  648  07:E852  60            rts
