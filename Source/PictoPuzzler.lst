  301                     ;--------------------------------------------------
  302                     ; se_check_rest will read a byte from the data stream and
  303                     ;       determine if it is a rest or not.  It will set or clear the current
  304                     ;       stream's rest flag accordingly.
  305                     ;       input:
  306                     ;           X: stream number
  307                     ;           Y: data stream index
  308  07:E62A            se_check_rest:
  309  07:E62A  B1 DC         lda [sound_ptr], y  ;read the note byte again
  310  07:E62C  C9 5E         cmp #rest
  311  07:E62E  D0 07         bne .not_rest
  312  07:E630  BD 22 03      lda stream_status, x
  313  07:E633  09 02         ora #%00000010  ;set the rest bit in the status byte
  314  07:E635  D0 05         bne .store  ;this will always branch.  bne is cheaper than a jmp.
  315  07:E637            .not_rest:
  316  07:E637  BD 22 03      lda stream_status, x
  317  07:E63A  29 FD         and #%11111101  ;clear the rest bit in the status byte
  318  07:E63C            .store:
  319  07:E63C  9D 22 03      sta stream_status, x
  320  07:E63F  60            rts
  321                         
  322                     ;-----------------------------------------
  323                     ; se_opcode_launcher will read an address from the opcode jump table and indirect jump there.
  324                     ;    input: A: opcode byte
  325                     ;               Y: data stream position
  326                     ;               X: stream number
  327  07:E640            se_opcode_launcher:
  328  07:E640  8C 02 03      sty sound_temp1         ;save y register, because we are about to destroy it
  329  07:E643  38            sec
  330  07:E644  E9 A0         sbc #$A0                ;turn our opcode byte into a table index by subtracting $A0
  331  07:E646  0A            asl a                   ;multiply by 2 because we index into a table of addresses (words)
  332  07:E647  A8            tay
  333  07:E648  B9 AE EA      lda sound_opcodes, y    ;get low byte of subroutine address
  334  07:E64B  8D DE 00      sta sound_ptr2
  335  07:E64E  B9 AF EA      lda sound_opcodes+1, y  ;get high byte
  336  07:E651  8D DF 00      sta sound_ptr2+1
  337  07:E654  AC 02 03      ldy sound_temp1         ;restore our y register
  338  07:E657  C8            iny                     ;set to next position in data stream (assume an argument)
  339  07:E658  6C DE 00      jmp [sound_ptr2]           ;indirect jump to our opcode subroutine    
  340                         
  341                     ;----------------------------------------------------
  342                     ; se_set_temp_ports will copy a stream's sound data to the temporary apu variables
  343                     ;      input:
  344                     ;           X: stream number
  345  07:E65B            se_set_temp_ports:
  346                     
  347  07:E65B  E0 06             cpx #MUSIC_DPMC
  348  07:E65D  90 01             bcc .contTempPorts
  349  07:E65F  60                rts
  350  07:E660            .contTempPorts:
  351  07:E660  BD 2A 03      lda stream_channel, x
  352  07:E663  0A            asl a
  353  07:E664  0A            asl a
  354  07:E665  A8            tay
  355                         
  356  07:E666  20 89 E6      jsr se_set_stream_volume
  357                             
  358                         
  359  07:E669  A9 08         lda #$08
  360  07:E66B  99 07 03      sta soft_apu_ports+1, y     ;sweep
  361                         
  362                             
  363  07:E66E  BD C0 03          LDA stream_arp, x
  364  07:E671  F0 06             BEQ .updatePitch
  365                             
  366  07:E673  20 E5 E6          JSR se_set_stream_arpeggio
  367  07:E676  4C 88 E6          JMP .leaveTempSet
  368                             
  369  07:E679            .updatePitch:
  370  07:E679  BD 62 03      lda stream_note_LO, x
  371  07:E67C  99 08 03      sta soft_apu_ports+2, y     ;period LO
  372                         
  373  07:E67F  BD 6A 03      lda stream_note_HI, x
  374  07:E682  99 09 03      sta soft_apu_ports+3, y     ;period HI
  375                             
  376                     
  377  07:E685  20 3F E7          jsr se_set_stream_pitch
  378                     
  379  07:E688            .leaveTempSet:
  380  07:E688  60            rts    
