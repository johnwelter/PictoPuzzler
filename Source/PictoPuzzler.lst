  187                     
  188  06:D441  A2 00             LDX #$00
  189                     
  190  06:D443            .innerloop:
  191                             
  192  06:D443  B1 14             LDA [pointer_address], y
  193  06:D445  8D 07 20          STA PPU_DATA
  194  06:D448  C8                INY
  195  06:D449  E8                INX
  196  06:D44A  EC 00 00          CPX DATA_LEN
