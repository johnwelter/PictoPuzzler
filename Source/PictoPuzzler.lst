    1  06:DA9C            ReadControllersSafe:
    2  06:DA9C  8A                TXA
    3  06:DA9D  48                PHA
    4  06:DA9E  98                TYA
    5  06:DA9F  48                PHA
    6                     
    7  06:DAA0            .firstRead:
    8  06:DAA0  20 C6 DA          JSR ReadControllers
    9  06:DAA3            .reRead:
   10  06:DAA3  AD 24 00          LDA gamepad
   11  06:DAA6  48                PHA
   12  06:DAA7  20 C6 DA          JSR ReadControllers
   13  06:DAAA  68                PLA 
   14  06:DAAB  CD 24 00          CMP gamepad
   15  06:DAAE  D0 F3             BNE .reRead
   16                             
   17  06:DAB0            .finishARead:
   18                             ;;comapre last to current, find the pressed buttons this frame
   19  06:DAB0  AD 25 00          LDA gamepadLast
   20  06:DAB3  49 FF             EOR #$FF
   21  06:DAB5  2D 24 00          AND gamepad
   22  06:DAB8  8D 26 00          STA gamepadPressed
   23                             
   24                             
   25  06:DABB  AD 24 00          LDA gamepad
   26  06:DABE  8D 25 00          STA gamepadLast
   27                             
   28  06:DAC1  68                PLA
   29  06:DAC2  A8                TAY
   30  06:DAC3  68                PLA
   31  06:DAC4  AA                TAX     
   32  06:DAC5  60                RTS
   33                             
   34  06:DAC6            ReadControllers:
   35                     
   36  06:DAC6  A9 01             LDA #$01        ;load 1
   37  06:DAC8  8D 16 40          STA $4016       ; turn latch on
   38                             ;STA gamepad2
   39  06:DACB  4A                LSR     A               ; move acc it over for a 0 bit, better than loading 0 to the acc, I guess
   40  06:DACC  8D 16 40          STA $4016       ;turn latch off
   41                             
   42  06:DACF  A9 80             LDA #$80
   43  06:DAD1  8D 24 00          STA gamepad
   44                     
   45  06:DAD4            .readControllerABytesLoop:
   46  06:DAD4  AD 16 40          LDA $4016               ;acc: %00000001 c: 0
   47  06:DAD7  29 03             AND #%00000011  ;acc: %00000001 c: 0
   48  06:DAD9  C9 01             CMP #%00000001  ;acc: %00000001 c: 1
   49                             ;ror shifts everything right one position: carry->bit 7, bit 0-> carry
   50  06:DADB  6E 24 00          ROR gamepad             ;gamepad: %11000000
   51                             ;eventually, the ROR sends out the 1 instead of all the leading 0s, BCC (branch carry clear) gets the 1 and does not loop
   52  06:DADE  90 F4             BCC .readControllerABytesLoop
   53                     
   54                             
   55                     
   56                             
   57  06:DAE0  60                RTS
