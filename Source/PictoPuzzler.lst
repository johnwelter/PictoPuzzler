#[2]   Source/Routines/Common/NMI.asm
#[3]   Source/Routines/Common/ReadControllers.asm
   75                       .include "Source/Routines/Common/ReadControllers.asm"
    1  06:DD20            ReadControllersSafe:
    2  06:DD20  8A                TXA
    3  06:DD21  48                PHA
    4  06:DD22  98                TYA
    5  06:DD23  48                PHA
    6                     
    7  06:DD24            .firstRead:
    8  06:DD24  20 4A DD          JSR ReadControllers
    9  06:DD27            .reRead:
   10  06:DD27  AD 24 00          LDA gamepad
   11  06:DD2A  48                PHA
   12  06:DD2B  20 4A DD          JSR ReadControllers
   13  06:DD2E  68                PLA 
   14  06:DD2F  CD 24 00          CMP gamepad
   15  06:DD32  D0 F3             BNE .reRead
   16                             
   17  06:DD34            .finishARead:
   18                             ;;comapre last to current, find the pressed buttons this frame
   19  06:DD34  AD 25 00          LDA gamepadLast
   20  06:DD37  49 FF             EOR #$FF
   21  06:DD39  2D 24 00          AND gamepad
   22  06:DD3C  8D 26 00          STA gamepadPressed
   23                             
   24                             
   25  06:DD3F  AD 24 00          LDA gamepad
   26  06:DD42  8D 25 00          STA gamepadLast
   27                             
   28  06:DD45  68                PLA
   29  06:DD46  A8                TAY
   30  06:DD47  68                PLA
   31  06:DD48  AA                TAX     
   32  06:DD49  60                RTS
   33                             
   34  06:DD4A            ReadControllers:
   35                     
   36  06:DD4A  A9 01             LDA #$01        ;load 1
   37  06:DD4C  8D 16 40          STA $4016       ; turn latch on
   38                             ;STA gamepad2
   39  06:DD4F  4A                LSR     A               ; move acc it over for a 0 bit, better than loading 0 to the acc, I guess
   40  06:DD50  8D 16 40          STA $4016       ;turn latch off
   41                             
   42  06:DD53  A9 80             LDA #$80
   43  06:DD55  8D 24 00          STA gamepad
   44                     
   45  06:DD58            .readControllerABytesLoop:
   46  06:DD58  AD 16 40          LDA $4016               ;acc: %00000001 c: 0
   47  06:DD5B  29 03             AND #%00000011  ;acc: %00000001 c: 0
   48  06:DD5D  C9 01             CMP #%00000001  ;acc: %00000001 c: 1
   49                             ;ror shifts everything right one position: carry->bit 7, bit 0-> carry
   50  06:DD5F  6E 24 00          ROR gamepad             ;gamepad: %11000000
   51                             ;eventually, the ROR sends out the 1 instead of all the leading 0s, BCC (branch carry clear) gets the 1 and does not loop
   52  06:DD62  90 F4             BCC .readControllerABytesLoop
   53                     
   54                             
   55                     
   56                             
   57  06:DD64  60                RTS
