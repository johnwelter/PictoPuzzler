   33                             
   34  06:DABE            ReadControllers:
   35                     
   36  06:DABE  A9 01             LDA #$01        ;load 1
   37  06:DAC0  8D 16 40          STA $4016       ; turn latch on
   38                             ;STA gamepad2
   39  06:DAC3  4A                LSR     A               ; move acc it over for a 0 bit, better than loading 0 to the acc, I guess
   40  06:DAC4  8D 16 40          STA $4016       ;turn latch off
   41                             
   42  06:DAC7  A9 80             LDA #$80
   43  06:DAC9  8D 24 00          STA gamepad
   44                     
   45  06:DACC            .readControllerABytesLoop:
   46  06:DACC  AD 16 40          LDA $4016               ;acc: %00000001 c: 0
   47  06:DACF  29 03             AND #%00000011  ;acc: %00000001 c: 0
   48  06:DAD1  C9 01             CMP #%00000001  ;acc: %00000001 c: 1
   49                             ;ror shifts everything right one position: carry->bit 7, bit 0-> carry
   50  06:DAD3  6E 24 00          ROR gamepad             ;gamepad: %11000000
   51                             ;eventually, the ROR sends out the 1 instead of all the leading 0s, BCC (branch carry clear) gets the 1 and does not loop
   52  06:DAD6  90 F4             BCC .readControllerABytesLoop
   53                     
   54                             
   55                     
   56                             
   57  06:DAD8  60                RTS
