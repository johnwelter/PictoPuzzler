    1  06:DE41            ReadControllersSafe:
    2  06:DE41  8A                TXA
    3  06:DE42  48                PHA
    4  06:DE43  98                TYA
    5  06:DE44  48                PHA
    6                     
    7  06:DE45            .firstRead:
    8  06:DE45  20 6B DE          JSR ReadControllers
    9  06:DE48            .reRead:
   10  06:DE48  AD 24 00          LDA gamepad
   11  06:DE4B  48                PHA
   12  06:DE4C  20 6B DE          JSR ReadControllers
   13  06:DE4F  68                PLA 
   14  06:DE50  CD 24 00          CMP gamepad
   15  06:DE53  D0 F3             BNE .reRead
   16                             
   17  06:DE55            .finishARead:
   18                             ;;comapre last to current, find the pressed buttons this frame
   19  06:DE55  AD 25 00          LDA gamepadLast
   20  06:DE58  49 FF             EOR #$FF
   21  06:DE5A  2D 24 00          AND gamepad
   22  06:DE5D  8D 26 00          STA gamepadPressed
   23                             
   24                             
   25  06:DE60  AD 24 00          LDA gamepad
   26  06:DE63  8D 25 00          STA gamepadLast
   27                             
   28  06:DE66  68                PLA
   29  06:DE67  A8                TAY
   30  06:DE68  68                PLA
   31  06:DE69  AA                TAX     
   32  06:DE6A  60                RTS
   33                             
   34  06:DE6B            ReadControllers:
   35                     
   36  06:DE6B  A9 01             LDA #$01        ;load 1
   37  06:DE6D  8D 16 40          STA $4016       ; turn latch on
   38                             ;STA gamepad2
   39  06:DE70  4A                LSR     A               ; move acc it over for a 0 bit, better than loading 0 to the acc, I guess
   40  06:DE71  8D 16 40          STA $4016       ;turn latch off
   41                             
   42  06:DE74  A9 80             LDA #$80
   43  06:DE76  8D 24 00          STA gamepad
   44                     
   45  06:DE79            .readControllerABytesLoop:
   46  06:DE79  AD 16 40          LDA $4016               ;acc: %00000001 c: 0
   47  06:DE7C  29 03             AND #%00000011  ;acc: %00000001 c: 0
   48  06:DE7E  C9 01             CMP #%00000001  ;acc: %00000001 c: 1
   49                             ;ror shifts everything right one position: carry->bit 7, bit 0-> carry
   50  06:DE80  6E 24 00          ROR gamepad             ;gamepad: %11000000
   51                             ;eventually, the ROR sends out the 1 instead of all the leading 0s, BCC (branch carry clear) gets the 1 and does not loop
   52  06:DE83  90 F4             BCC .readControllerABytesLoop
   53                     
   54                             
   55                     
   56                             
   57  06:DE85  60                RTS
