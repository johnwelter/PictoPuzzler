    1           0080      MAPPERCONTROL = $80
    2           00A0      CHRBANK1 = $A0
    3           00C0      CHRBANK2 = $C0
    4           00E0      PRGBANK = $E0
    5                     
    6  06:D5E0            ResetMapper:
    7  06:D5E0  EE E0 D5    inc ResetMapper
    8  06:D5E3  60          RTS
    9                       
   10                     ;;now, set up the controls for the mapper
   11                     ;;4bit0
   12                     ;;-----
   13                     ;;CPPMM
   14                     ;;|||||
   15                     ;;|||++- Mirroring (0: one-screen, lower bank; 1: one-screen, upper bank;
   16                     ;;|||               2: vertical; 3: horizontal)
   17                     ;;|++--- PRG ROM bank mode (0, 1: switch 32 KB at $8000, ignoring low bit of bank number;
   18                     ;;|                         2: fix first bank at $8000 and switch 16 KB bank at $C000;
   19                     ;;|                         3: fix last bank at $C000 and switch 16 KB bank at $8000)
   20                     ;;+----- CHR ROM bank mode (0: switch 8 KB at a time; 1: switch two separate 4 KB banks)
   21                        
   22  06:D5E4            SetMapperControls:
   23                       ;;A = controls
   24  06:D5E4  AA          TAX
   25  06:D5E5  A9 80       LDA #MAPPERCONTROL
   26  06:D5E7  8D B0 00    STA mapper_address+1
   27  06:D5EA  8A          TXA
   28  06:D5EB  20 10 D6    JSR SendMapperCommand
   29  06:D5EE  60          RTS
   30                     
   31  06:D5EF            LoadPRGBank:
   32                     
   33                             ;;A is the desired PRG number
   34  06:D5EF  AA                TAX
   35  06:D5F0  A9 E0             LDA #PRGBANK
   36  06:D5F2  8D B0 00          STA mapper_address+1
   37  06:D5F5  8A                TXA
   38  06:D5F6  20 10 D6          JSR SendMapperCommand
   39  06:D5F9  60                RTS
   40                             
   41  06:D5FA            LoadCHRBankA:
   42                             ;;A is the desired CHR bank
   43  06:D5FA  AA                TAX
   44  06:D5FB  A9 A0             LDA #CHRBANK1
   45  06:D5FD  8D B0 00          STA mapper_address+1
   46  06:D600  8A                TXA
   47  06:D601  20 10 D6          JSR SendMapperCommand
   48  06:D604  60                RTS
   49                             
   50  06:D605            LoadCHRBankB:
   51                             ;;A is the desired CHR bank
   52  06:D605  AA                TAX
   53  06:D606  A9 C0             LDA #CHRBANK2
   54  06:D608  8D B0 00          STA mapper_address+1
   55  06:D60B  8A                TXA
   56  06:D60C  20 10 D6          JSR SendMapperCommand
   57  06:D60F  60                RTS
   58                             
   59  06:D610            SendMapperCommand:
   60                     
   61  06:D610  A0 00             LDY #$00
   62                             
   63  06:D612  91 AF             STA [mapper_address], y
   64  06:D614  4A                LSR A
   65  06:D615  91 AF             STA [mapper_address], y
   66  06:D617  4A                LSR A
   67  06:D618  91 AF             STA [mapper_address], y
   68  06:D61A  4A                LSR A 
   69  06:D61B  91 AF             STA [mapper_address], y
   70  06:D61D  4A                LSR A
   71  06:D61E  91 AF             STA [mapper_address], y
   72                             
   73  06:D620  60                RTS
   74                             
   75  06:D621            ResetBanks:
   76                     
   77  06:D621  20 E0 D5          JSR ResetMapper
   78  06:D624  A9 00             LDA #$00
   79  06:D626  20 EF D5          JSR LoadPRGBank
   80                       
   81                             ;;as a test, load up the initial CHR banks
   82  06:D629  20 E0 D5          JSR ResetMapper
   83  06:D62C  A9 00             LDA #$00
   84  06:D62E  20 FA D5          JSR LoadCHRBankA
   85  06:D631  A9 01             LDA #$01
   86  06:D633  20 05 D6          JSR LoadCHRBankB
   87  06:D636  60                RTS
