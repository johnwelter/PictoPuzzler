  289  06:D4C4  A9 00             LDA #$00
  290  06:D4C6  8D 02 00          STA temp3
  291                             
  292  06:D4C9  0E 01 00          ASL temp2
  293  06:D4CC  2E 02 00          ROL temp3
  294  06:D4CF  0E 01 00          ASL temp2
  295  06:D4D2  2E 02 00          ROL temp3
  296  06:D4D5  0E 01 00          ASL temp2
  297  06:D4D8  2E 02 00          ROL temp3
  298  06:D4DB  0E 01 00          ASL temp2
