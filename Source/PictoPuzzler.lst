#[1]   Source/PictoPuzzler.asm
#[2]   Source/External/SoundEngine/Source/sound_engine.asm
  234                       .include "Source/External/SoundEngine/Source/sound_engine.asm"
    1  07:E48E            sound_init:
    2  07:E48E  A9 1F         lda #$1F
    3  07:E490  8D 15 40      sta $4015   ;enable Square 1, Square 2, Triangle and Noise channels
    4  07:E493  8D 00 03          sta sound_enable_flags
    5                         
    6  07:E496  A9 00         lda #$00
    7  07:E498  8D 01 03      sta sound_disable_flag  ;clear disable flag
    8                         ;later, if we have other variables we want to initialize, we will do that here.
    9  07:E49B  A9 FF         lda #$FF
   10  07:E49D  8D 04 03      sta sound_sq1_old   ;initializing these to $FF ensures that the first notes of the first song isn't skipped
   11  07:E4A0  8D 05 03      sta sound_sq2_old
   12  07:E4A3            se_silence:
   13  07:E4A3  A9 30         lda #$30
   14  07:E4A5  8D 06 03      sta soft_apu_ports      ;set Square 1 volume to 0
   15  07:E4A8  8D 0A 03      sta soft_apu_ports+4    ;set Square 2 volume to 0
   16  07:E4AB  8D 12 03      sta soft_apu_ports+12   ;set Noise volume to 0
   17  07:E4AE  A9 80         lda #$80
   18  07:E4B0  8D 0E 03      sta soft_apu_ports+8     ;silence Triangle
   19  07:E4B3  A9 00             lda #$00
   20  07:E4B5  8D 17 03          sta soft_apu_ports+17    ;silence DPMC
   21                     
   22  07:E4B8  60            rts
   23                         
   24  07:E4B9            sound_disable:
   25  07:E4B9  A9 00         lda #$00
   26  07:E4BB  8D 15 40      sta $4015   ;disable all channels
   27  07:E4BE  8D 00 03          sta sound_enable_flags
   28  07:E4C1  A9 01         lda #$01
   29  07:E4C3  8D 01 03      sta sound_disable_flag  ;set disable flag
   30  07:E4C6  60            rts
   31                         
   32                     ;-------------------------------------
   33                     ; load_sound will prepare the sound engine to play a song or sfx.
   34                     ;   input:
   35                     ;       A: song/sfx number to play
   36  07:E4C7            sound_load:
   37  07:E4C7  8D 02 03      sta sound_temp1         ;save song number
   38  07:E4CA  0A            asl a                   ;multiply by 2.  We are indexing into a table of pointers (words)
   39  07:E4CB  A8            tay
   40  07:E4CC  B9 AB E8      lda song_headers, y     ;setup the pointer to our song header
   41  07:E4CF  8D DF 00      sta sound_ptr
   42  07:E4D2  B9 AC E8      lda song_headers+1, y
   43  07:E4D5  8D E0 00      sta sound_ptr+1
   44                         
   45  07:E4D8  A0 00         ldy #$00
   46  07:E4DA  B1 DF         lda [sound_ptr], y      ;read the first byte: # streams
   47  07:E4DC  8D 03 03      sta sound_temp2         ;store in a temp variable.  We will use this as a loop counter: how many streams to read stream headers for
   48  07:E4DF  C8            iny
   49  07:E4E0            .loop:
   50  07:E4E0  B1 DF         lda [sound_ptr], y      ;stream number
   51  07:E4E2  AA            tax                     ;stream number acts as our variable index
   52  07:E4E3  C8            iny
   53                         
   54  07:E4E4  B1 DF         lda [sound_ptr], y      ;status byte.  1= enable, 0=disable
   55  07:E4E6  9D 22 03      sta stream_status, x
   56  07:E4E9  F0 49         beq .next_stream        ;if status byte is 0, stream disabled, so we are done
   57  07:E4EB  C8            iny
   58                         
   59  07:E4EC  B1 DF         lda [sound_ptr], y      ;channel number
   60  07:E4EE  9D 2A 03      sta stream_channel, x
   61  07:E4F1  C8            iny
   62                         
   63  07:E4F2  B1 DF         lda [sound_ptr], y      ;initial duty and volume settings
   64  07:E4F4  9D 52 03      sta stream_vol_duty, x
   65  07:E4F7  C8            iny
   66                         
   67  07:E4F8  B1 DF         lda [sound_ptr], y
   68  07:E4FA  9D 42 03      sta stream_ve, x
   69  07:E4FD  C8            iny
   70                             
   71                             ;temp solution
   72  07:E4FE  A9 00             lda #me_none
   73  07:E500  9D A0 03          sta stream_pe, x
   74                             
   75                             ;temp solution
   76  07:E503  A9 00             lda #arp_none
   77  07:E505  9D C0 03          sta stream_arp, x
   78                         
   79  07:E508  B1 DF         lda [sound_ptr], y      ;pointer to stream data.  Little endian, so low byte first
   80  07:E50A  9D 32 03      sta stream_ptr_LO, x
   81  07:E50D  C8            iny
   82                         
   83  07:E50E  B1 DF         lda [sound_ptr], y
   84  07:E510  9D 3A 03      sta stream_ptr_HI, x
   85  07:E513  C8            iny
   86                         
   87  07:E514  B1 DF         lda [sound_ptr], y
   88  07:E516  9D 72 03      sta stream_tempo, x
   89                         
   90  07:E519  A9 A0         lda #$A0
   91  07:E51B  9D 7A 03      sta stream_ticker_total, x
   92                         
   93  07:E51E  A9 01         lda #$01
   94  07:E520  9D 82 03      sta stream_note_length_counter,x
   95                         
   96  07:E523  A9 00         lda #$00
   97  07:E525  9D 4A 03      sta stream_ve_index, x
   98  07:E528  9D A8 03          sta stream_pe_index, x
   99  07:E52B  9D C8 03          sta stream_arp_index, x
  100  07:E52E  9D 92 03      sta stream_loop1, x
  101  07:E531  9D 9A 03      sta stream_note_offset, x
  102  07:E534            .next_stream:
  103  07:E534  C8            iny
  104                         
  105  07:E535  AD 02 03      lda sound_temp1         ;song number
  106  07:E538  9D 1A 03      sta stream_curr_sound, x
  107                         
  108  07:E53B  CE 03 03      dec sound_temp2         ;our loop counter
  109  07:E53E  D0 A0         bne .loop
  110  07:E540  60            rts
  111                     
  112                     ;--------------------------
  113                     ; sound_play_frame advances the sound engine by one frame
  114  07:E541            sound_play_frame:
  115  07:E541  AD 01 03      lda sound_disable_flag
  116  07:E544  D0 31         bne .done   ;if disable flag is set, don't advance a frame
  117                     
  118  07:E546  20 A3 E4      jsr se_silence  ;silence all channels.  se_set_apu will set volume later for all channels that are enabled.
  119                                         ;the purpose of this subroutine call is to silence channels that aren't used by any streams.
  120  07:E549  A2 00         ldx #$00
  121  07:E54B            .loop:
  122  07:E54B  BD 22 03      lda stream_status, x
  123  07:E54E  29 01         and #$01    ;check whether the stream is active
  124  07:E550  F0 1D         beq .endloop  ;if the stream isn't active, skip it
  125                         
  126                         ;add the tempo to the ticker total.  If there is a FF-> 0 transition, there is a tick
  127  07:E552  BD 7A 03      lda stream_ticker_total, x
  128  07:E555  18            clc
  129  07:E556  7D 72 03      adc stream_tempo, x
  130  07:E559  9D 7A 03      sta stream_ticker_total, x
  131  07:E55C  90 0E         bcc .set_buffer    ;carry clear = no tick.  if no tick, we are done with this stream
  132                         
  133  07:E55E  DE 82 03      dec stream_note_length_counter, x   ;else there is a tick. decrement the note length counter
  134  07:E561  D0 09         bne .set_buffer    ;if counter is non-zero, our note isn't finished playing yet
  135  07:E563  BD 8A 03      lda stream_note_length, x   ;else our note is finished. reload the note length counter
  136  07:E566  9D 82 03      sta stream_note_length_counter, x
  137                         
  138  07:E569  20 78 E5      jsr se_fetch_byte   ;read the next byte from the data stream
  139                         
  140  07:E56C            .set_buffer:
  141  07:E56C  20 B3 E6      jsr se_set_temp_ports   ;copy the current stream's sound data for the current frame into our temporary APU vars (soft_apu_ports)
  142  07:E56F            .endloop:
  143  07:E56F  E8            inx
  144  07:E570  E0 08         cpx #$08
  145  07:E572  D0 D7         bne .loop
  146  07:E574  20 46 E8      jsr se_set_apu      ;copy the temporary APU variables (soft_apu_ports) to the real APU ports ($4000, $4001, etc)
  147  07:E577            .done:
  148  07:E577  60            rts
  149                     
  150                     ;--------------------------
  151                     ; se_fetch_byte reads one byte from a sound data stream and handles it
  152                     ;   input: 
  153                     ;       X: stream number    
  154  07:E578            se_fetch_byte:
  155  07:E578  BD 32 03      lda stream_ptr_LO, x
  156  07:E57B  8D DF 00      sta sound_ptr
  157  07:E57E  BD 3A 03      lda stream_ptr_HI, x
  158  07:E581  8D E0 00      sta sound_ptr+1
  159                         
  160  07:E584  A0 00         ldy #$00
  161  07:E586            .fetch:
  162  07:E586  B1 DF         lda [sound_ptr], y
  163  07:E588  10 26         bpl .note                ;if < #$80, it's a Note
  164  07:E58A  C9 A0         cmp #$A0
  165  07:E58C  90 0C         bcc .note_length         ;else if < #$A0, it's a Note Length
  166  07:E58E            .opcode:                     ;else it's an opcode
  167                         ;do Opcode stuff
  168  07:E58E  20 98 E6      jsr se_opcode_launcher
  169  07:E591  C8            iny                      ;next position in the data stream
  170  07:E592  BD 22 03      lda stream_status, x
  171  07:E595  29 01         and #%00000001
  172  07:E597  D0 ED         bne .fetch               ;after our opcode is done, grab another byte unless the stream is disabled
  173  07:E599  60            rts                      ; in which case we quit  (explained below)
  174  07:E59A            .note_length:
  175                         ;do note length stuff
  176  07:E59A  29 7F         and #%01111111          ;chop off bit7
  177  07:E59C  8C 02 03      sty sound_temp1         ;save Y because we are about to destroy it
  178  07:E59F  A8            tay
  179  07:E5A0  B9 81 EC      lda note_length_table, y    ;get the note length count value
  180  07:E5A3  9D 8A 03      sta stream_note_length, x
  181  07:E5A6  9D 82 03      sta stream_note_length_counter, x   ;stick it in our note length counter
  182  07:E5A9  AC 02 03      ldy sound_temp1         ;restore Y
  183  07:E5AC  C8            iny                     ;set index to next byte in the stream
  184  07:E5AD  4C 86 E5      jmp .fetch              ;fetch another byte
  185  07:E5B0            .note:
  186                         ;do Note stuff
  187  07:E5B0  8D 03 03      sta sound_temp2
